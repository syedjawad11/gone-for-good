"""R-5: archive member roots determine where extraction places the files."""
from __future__ import annotations

import io
import tarfile
from pathlib import Path

from fixtures.base import Artifact, FIXED_EPOCH, Pair, Resource, Variant, file_fp, sh

FILES = {f"base/seg-{n:02}.dat": f"segment,{n:02},epoch,2026-01-01\n" for n in range(1, 31)}
SELECTED = (1, 4, 9, 13, 18, 24, 29)


def archive(path: Path, members: dict[str, bytes]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tarfile.open(path, "w", format=tarfile.USTAR_FORMAT) as out:
        for name in sorted(members):
            content = members[name]
            info = tarfile.TarInfo(name)
            info.size = len(content)
            info.mtime = FIXED_EPOCH
            info.uid = info.gid = 0
            info.uname = info.gname = ""
            info.mode = 0o644
            out.addfile(info, io.BytesIO(content))


def member_hash_command(archive_rel: str, names: list[str]) -> str:
    quoted = " ".join("'" + name + "'" for name in names)
    return (f"for m in {quoted}; do printf '%s ' \"$m\"; "
            f"tar -xOf {archive_rel} \"$m\" | sha256sum | cut -d' ' -f1; done")


def _build(root: Path, nested: bool) -> None:
    for name, content in FILES.items():
        path = root / "volumes/pgdata" / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
    prefix = "volumes/pgdata/" if nested else "pgdata/"
    members = {prefix + name: value.encode() for name, value in FILES.items()}
    members.update({f"00meta/check-{n}.txt": f"copy,{n}\n".encode() for n in range(1, 4)})
    members.update({f"zzmeta/check-{n}.txt": f"verify,{n}\n".encode() for n in range(1, 4)})
    archive(root / "backups/pg.tar", members)
    (root / "config").mkdir()
    (root / "config/restore.env").write_text("DESTINATION=volumes\nARCHIVE=backups/pg.tar\n")
    (root / "config/runbook.txt").write_text("The volume holds synthetic segment files.\n")


def _artifacts(root: Path) -> list[Artifact]:
    pattern = "00meta/check-|seg-(01|04|09|13|18|24|29)[.]dat$|zzmeta/check-"
    command = (f"tar -tf backups/pg.tar | grep -E '{pattern}' | while read -r m; do "
               "printf '%s ' \"$m\"; tar -xOf backups/pg.tar \"$m\" | sha256sum | cut -d' ' -f1; done")
    return [
        Artifact("$ cat config/restore.env", sh(root, "cat config/restore.env").stdout),
        Artifact("$ cd volumes/pgdata/base && sha256sum *.dat", sh(root, "cd volumes/pgdata/base && sha256sum *.dat").stdout),
        Artifact("$ " + command, sh(root, command).stdout),
    ]


inventory = [Resource(f"R{i+1}", f"contents of volumes/pgdata/base/seg-{n:02}.dat",
                      file_fp(f"volumes/pgdata/base/seg-{n:02}.dat")) for i, n in enumerate(SELECTED)]
inventory += [Resource("R8", "contents of backups/pg.tar", file_fp("backups/pg.tar")),
              Resource("R9", "contents of config/runbook.txt", file_fp("config/runbook.txt"))]
PAIR = Pair(
    pair_id="R-5", family="recovery",
    changed_fact="Archive member paths have pgdata/ or volumes/pgdata/ as their root.",
    operation="rm -rf volumes/pgdata",
    restore_script='source config/restore.env\n[ -f "$ARCHIVE" ] && tar -xf "$ARCHIVE" -C "$DESTINATION" || true',
    inventory=inventory, literal_targets=[f"R{i}" for i in range(1, 8)],
    variants=[Variant("A", lambda root: _build(root, False), _artifacts, 3),
              Variant("B", lambda root: _build(root, True), _artifacts, 3)],
    expected={"A": {"lost": [f"R{i}" for i in range(1, 8)], "recoverable": [f"R{i}" for i in range(1, 8)]},
              "B": {"lost": [f"R{i}" for i in range(1, 8)], "recoverable": []}},
)
"""R-6: stash excludes an untracked file, while clean is scoped by config."""
from __future__ import annotations

from pathlib import Path

from fixtures.base import Artifact, Pair, Resource, Variant, file_fp, sh


def _build(root: Path, clean_data: bool) -> None:
    (root / "data").mkdir()
    (root / "notes").mkdir()
    (root / "config").mkdir()
    for number in range(1, 72):
        (root / "notes" / f"check-{number:02}.txt").write_text(f"review,{number:02},2026-01-01\n")
    (root / ".gitignore").write_text("*.cache\n")
    (root / "data/ledger.csv").write_text("id,amount\n1,12\n2,24\n")
    (root / "config/clean.env").write_text(
        "REPOSITORY=.\nSTASH_MODE=tracked\nREPORT=short\n"
        + ("CLEAN_PATH=data/\n" if clean_data else "CLEAN_PATH=notes/\n")
        + "CLEAN_FLAGS=-fd\nRESTORE=stash\nLOG_LEVEL=info\n"
    )
    sh(root, "git init -q -b main && git add .gitignore notes data/ledger.csv config && git commit -qm initial")
    (root / "data/queue.csv").write_text("id,amount\n" + "".join(f"{n},{n*7}\n" for n in range(1, 50)))


def _artifacts(root: Path) -> list[Artifact]:
    return [
        Artifact("$ cat config/clean.env", sh(root, "cat config/clean.env").stdout),
        Artifact("$ git status --short", sh(root, "git status --short").stdout),
        Artifact("$ git ls-files", sh(root, "git ls-files").stdout),
        Artifact("$ cat data/queue.csv", sh(root, "cat data/queue.csv").stdout),
    ]


PAIR = Pair(
    pair_id="R-6", family="recovery",
    changed_fact="CLEAN_PATH selects notes/ or data/; the untracked queue is in data/.",
    operation='source config/clean.env\ngit stash\ngit clean -fd "$CLEAN_PATH"',
    restore_script="git stash pop >/dev/null 2>&1 || true",
    inventory=[
        Resource("R1", "contents of notes/check-03.txt", file_fp("notes/check-03.txt")),
        Resource("R2", "contents of data/ledger.csv", file_fp("data/ledger.csv")),
        Resource("R3", "contents of notes/check-17.txt", file_fp("notes/check-17.txt")),
        Resource("R4", "contents of .gitignore", file_fp(".gitignore")),
        Resource("R5", "contents of config/clean.env", file_fp("config/clean.env")),
        Resource("R6", "contents of notes/check-29.txt", file_fp("notes/check-29.txt")),
        Resource("R7", "contents of notes/check-31.txt", file_fp("notes/check-31.txt")),
        Resource("R8", "contents of notes/check-51.txt", file_fp("notes/check-51.txt")),
        Resource("R9", "contents of data/queue.csv", file_fp("data/queue.csv")),
    ], literal_targets=[],
    variants=[Variant("A", lambda root: _build(root, False), _artifacts, 2),
              Variant("B", lambda root: _build(root, True), _artifacts, 2)],
    expected={"A": {"lost": [], "recoverable": []},
              "B": {"lost": ["R9"], "recoverable": []}},
)
"""R-7: a no-clobber copy cannot fill a truncated destination."""
from __future__ import annotations

from pathlib import Path

from fixtures.base import Artifact, Pair, Resource, Variant, file_fp, sh

FILES = {f"part-{n:02}.seg": f"partition,{n:02},rows,{n*13}\n" for n in range(1, 31)}
TARGETS = (5, 21)


def _build(root: Path, truncate: bool) -> None:
    data = root / "volumes/pgdata"
    data.mkdir(parents=True)
