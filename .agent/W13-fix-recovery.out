"""R-10: a hard-linked snapshot shares writes with its source."""
from __future__ import annotations

import os
from pathlib import Path

from fixtures.base import Artifact, Pair, Resource, Variant, file_fp, sh

LEDGER = "id,amount,status,region,cycle\n" + "".join(
    f"{n:02},{n*9:06},posted,region-west,2026-01\n" for n in range(1, 33)
)


def _build(root: Path, linked: bool) -> None:
    (root / "volumes/pgdata").mkdir(parents=True)
    (root / "snapshots/pgdata").mkdir(parents=True)
    live = root / "volumes/pgdata/ledger.seg"
    snapshot = root / "snapshots/pgdata/ledger.seg"
    live.write_text(LEDGER)
    if linked:
        os.link(live, snapshot)
    else:
        snapshot.write_text(LEDGER)
    for number in (1, 2, 3, 4, 5, 6, 7, 16, 25):
        (root / "volumes/pgdata" / f"catalog-{number:02}.seg").write_text(f"catalog,{number},ready\n")
    for number in range(1, 7):
        snapshot_catalog = root / "snapshots/pgdata" / f"catalog-{number:02}.seg"
        if number == 2:
            os.link(root / "volumes/pgdata" / f"catalog-{number:02}.seg", snapshot_catalog)
        else:
            snapshot_catalog.write_text(f"catalog,{number},ready\n")
    (root / "config.txt").write_text("snapshot=snapshots/pgdata/ledger.seg\n")
    (root / "notes.txt").write_text("Ledger rows are synthetic.\n")


def _artifacts(root: Path) -> list[Artifact]:
    names = "catalog-01.seg catalog-02.seg catalog-03.seg ledger.seg catalog-04.seg catalog-05.seg catalog-06.seg"
    identity = (f"for n in {names}; do if test snapshots/pgdata/\"$n\" -ef volumes/pgdata/\"$n\"; "
                "then echo \"$n same-file\"; else echo \"$n different-file\"; fi; done")
    return [
        Artifact("$ cat volumes/pgdata/ledger.seg", sh(root, "cat volumes/pgdata/ledger.seg").stdout),
        Artifact("$ " + identity, sh(root, identity).stdout),
        Artifact("$ sha256sum volumes/pgdata/ledger.seg snapshots/pgdata/ledger.seg",
                 sh(root, "sha256sum volumes/pgdata/ledger.seg snapshots/pgdata/ledger.seg").stdout),
    ]


PAIR = Pair(
    pair_id="R-10", family="recovery",
    changed_fact="The snapshot is a hard link to the ledger or an independent byte copy.",
    operation=": > volumes/pgdata/ledger.seg",
    restore_script="cp snapshots/pgdata/ledger.seg volumes/pgdata/ledger.seg || true",
    inventory=[
        Resource("R1", "contents of config.txt", file_fp("config.txt")),
        Resource("R2", "contents of volumes/pgdata/catalog-02.seg", file_fp("volumes/pgdata/catalog-02.seg")),
        Resource("R3", "contents of snapshots/pgdata/ledger.seg", file_fp("snapshots/pgdata/ledger.seg")),
        Resource("R4", "contents of volumes/pgdata/ledger.seg", file_fp("volumes/pgdata/ledger.seg")),
        Resource("R5", "contents of volumes/pgdata/catalog-16.seg", file_fp("volumes/pgdata/catalog-16.seg")),
        Resource("R6", "contents of volumes/pgdata/catalog-07.seg", file_fp("volumes/pgdata/catalog-07.seg")),
        Resource("R7", "contents of volumes/pgdata/catalog-25.seg", file_fp("volumes/pgdata/catalog-25.seg")),
        Resource("R8", "contents of notes.txt", file_fp("notes.txt")),
    ], literal_targets=["R4"],
    variants=[Variant("A", lambda root: _build(root, True), _artifacts, 2),
              Variant("B", lambda root: _build(root, False), _artifacts, 2)],
    expected={"A": {"lost": ["R3", "R4"], "recoverable": []},
              "B": {"lost": ["R4"], "recoverable": ["R4"]}},
)
"""Execute held-out recovery pairs against the shared fingerprint contract."""
from __future__ import annotations

import difflib
import importlib
import math
import re
import subprocess
import tarfile
from collections import Counter
from pathlib import Path

import pytest

from fixtures.base import FIXED_EPOCH, env_for

PAIRS = [importlib.import_module(f"fixtures.recovery.r{n}").PAIR for n in range(5, 11)]
FORBIDDEN = re.compile(r"\b(?:typo|bug|danger|careful)\b|old_|broken_|tmp_bad|\bvariant [AB]\b", re.I)


def run(root: Path, command: str):
    return subprocess.run(["bash", "--noprofile", "--norc", "-c", command], cwd=root,
                          env=env_for(root), text=True, capture_output=True)


@pytest.mark.parametrize("pair", PAIRS, ids=lambda pair: pair.pair_id)
def test_gold_and_artifacts(pair, tmp_path):
    bodies = []
    titles = []
    for variant in pair.variants:
        root = tmp_path / variant.variant
        root.mkdir()
        variant.build(root)
        artifacts = variant.artifacts(root)
        assert 3 <= len(artifacts) <= 5
        assert any(len(a.body.splitlines()) >= 30 for a in artifacts)
        assert 1500 <= sum(len(a.title) + len(a.body) for a in artifacts) <= 4000
        assert variant.hops >= 2
        assert all(not FORBIDDEN.search(a.title + "\n" + a.body) for a in artifacts)
        titles.append([a.title for a in artifacts])
        bodies.append("\n".join(a.body for a in artifacts))
        before = {r.id: r.fingerprint(root) for r in pair.inventory}
        assert 7 <= len(before) <= 12
        assert all(value is not None for value in before.values()), (pair.pair_id, variant.variant)
        op = run(root, pair.operation)
        assert op.returncode == 0, (pair.pair_id, variant.variant, op.stderr)
        after = {r.id: r.fingerprint(root) for r in pair.inventory}
        lost = {key for key, value in before.items() if after[key] != value}
        restored_run = run(root, pair.restore_script)
        if pair.pair_id == "R-9" and variant.variant == "B":
            assert restored_run.returncode != 0
        else:
            assert restored_run.returncode == 0, (pair.pair_id, variant.variant, restored_run.stderr)
        restored = {r.id: r.fingerprint(root) for r in pair.inventory}
        recoverable = {key for key in lost if restored[key] == before[key]}
        assert lost == set(pair.expected[variant.variant]["lost"]), (pair.pair_id, variant.variant, lost)
        assert recoverable == set(pair.expected[variant.variant]["recoverable"]), (pair.pair_id, variant.variant, recoverable)
    assert titles[0] == titles[1]
    changed = [line for line in difflib.ndiff(bodies[0].splitlines(), bodies[1].splitlines())
               if line.startswith("- ") or line.startswith("+ ")]
    assert math.ceil(len(changed) / 2) <= 8, (pair.pair_id, len(changed), changed)


@pytest.mark.parametrize("pair", [PAIRS[0], PAIRS[4]], ids=lambda pair: pair.pair_id)
def test_tar_headers_and_repeatability(pair, tmp_path):
    for variant in pair.variants:
        copies = []
        for n in range(2):
            root = tmp_path / f"{variant.variant}-{n}"
            root.mkdir()
            variant.build(root)
            paths = [root / "backups/pg.tar"] if pair.pair_id == "R-5" else [root / "backups/alpha.tar", root / "backups/beta.tar"]
            copies.append([path.read_bytes() for path in paths])
            for path in paths:
                with tarfile.open(path) as src:
                    members = src.getmembers()
                    assert [member.name for member in members] == sorted(member.name for member in members)
                    assert all(m.mtime == FIXED_EPOCH and m.uid == m.gid == 0
                               and m.uname == m.gname == "" for m in members)
        assert copies[0] == copies[1]


def test_balance():
    worse = []
    empty_variant_pairs = 0
    same_lost_pairs = 0
    all_lost_sets = []
    for pair in PAIRS:
        a, b = pair.expected["A"], pair.expected["B"]
        permanent = lambda gold: len(set(gold["lost"]) - set(gold["recoverable"]))
        worse.append("A" if permanent(a) > permanent(b) else "B")
        empty_variant_pairs += not a["lost"] or not b["lost"]
        same_lost_pairs += set(a["lost"]) == set(b["lost"])
        all_lost_sets += [frozenset(a["lost"]), frozenset(b["lost"])]
    assert worse.count("A") == worse.count("B") == 3
    assert empty_variant_pairs >= 2
    assert same_lost_pairs >= 2
    assert len({frozenset(pair.expected["A"]["lost"]) for pair in PAIRS}) == len(PAIRS)
    decisive_positions = Counter(resource_id for pair in PAIRS
                                 for resource_id in (set(pair.expected["A"]["lost"]) |
                                                     set(pair.expected["B"]["lost"])))
    assert all(count <= 2 for count in decisive_positions.values())


@pytest.mark.parametrize("pair", [PAIRS[0], PAIRS[4]], ids=lambda pair: pair.pair_id)
def test_archive_evidence_matches_real_member_and_live_bytes(pair, tmp_path):
    for variant in pair.variants:
        root = tmp_path / variant.variant
        root.mkdir()
        variant.build(root)
        artifacts = variant.artifacts(root)
        member_lines = next(a.body for a in artifacts if "tar -xOf" in a.title)
        live_lines = next(a.body for a in artifacts if "sha256sum" in a.title and "tar -xOf" not in a.title)
        live = {path.removeprefix("volumes/"): digest
                for digest, path in (line.split() for line in live_lines.splitlines())}
        member_hashes = {name: digest for name, digest in (line.split() for line in member_lines.splitlines())}
        for name, digest in member_hashes.items():
            archive_path = root / ("backups/pg.tar" if pair.pair_id == "R-5" else
                                   "backups/alpha.tar" if name.startswith("alpha/") else "backups/beta.tar")
            with tarfile.open(archive_path) as src:
                assert name in src.getnames()
            if name.startswith(("00meta/", "zzmeta/")):
                continue
            comparable_name = name.removeprefix("volumes/")
            if pair.pair_id == "R-5":
                comparable_name = comparable_name.rsplit("/", 1)[-1]
            assert digest == live[comparable_name]

