@@ -0,0 +1,75 @@
+"""Customer deletion with two foreign-key actions."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, action: str) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.execute("PRAGMA foreign_keys=ON")
+        con.executescript(
+            "CREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL);"
+            "CREATE TABLE orders (id INTEGER PRIMARY KEY, customer_id INTEGER NOT NULL "
+            f"REFERENCES customers(id) ON DELETE {action}, placed_at TEXT NOT NULL);"
+            "CREATE TABLE order_items (id INTEGER PRIMARY KEY, order_id INTEGER NOT NULL "
+            "REFERENCES orders(id) ON DELETE CASCADE, sku TEXT NOT NULL, qty INTEGER NOT NULL);"
+            "CREATE TABLE customers_snapshot (id INTEGER PRIMARY KEY, name TEXT NOT NULL);"
+        )
+        con.executemany("INSERT INTO customers VALUES (?, ?)", [
+            (6, "Alder Workshop"), (7, "Birch Workshop"),
+            (8, "Cedar Workshop"), (9, "Elm Workshop"),
+        ])
+        con.executemany("INSERT INTO orders VALUES (?, ?, ?)", [
+            (101, 7, "2026-02-03"), (102, 7, "2026-02-04"),
+            (103, 8, "2026-02-05"), (104, 6, "2026-02-06"),
+        ])
+        con.executemany("INSERT INTO order_items VALUES (?, ?, ?, ?)", [
+            (201, 101, "paper", 2), (202, 101, "pencil", 4),
+            (203, 102, "folder", 1), (204, 103, "pen", 3),
+            (205, 104, "clip", 5),
+        ])
+        con.execute("INSERT INTO customers_snapshot SELECT * FROM customers")
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db '
+        '"SELECT * FROM customers ORDER BY id; SELECT * FROM customers_snapshot ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db '
+        '"SELECT * FROM orders ORDER BY id; SELECT * FROM order_items ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+PAIR = Pair(
+    pair_id="DB-1", family="db",
+    changed_fact="orders.customer_id uses CASCADE or RESTRICT on customer deletion",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM customers WHERE id = 7; COMMIT;"',
+    restore_script='sqlite3 app.db "INSERT OR IGNORE INTO customers SELECT * FROM customers_snapshot;" || true',
+    inventory=[
+        Resource("R1", "orders row 103 (customer 8)", sqlite_fp("app.db", "SELECT * FROM orders WHERE id IN (103) ORDER BY id")),
+        Resource("R2", "customer row 7", sqlite_fp("app.db", "SELECT * FROM customers WHERE id IN (7) ORDER BY id")),
+        Resource("R3", "order_items rows 201-203 (orders 101-102)", sqlite_fp("app.db", "SELECT * FROM order_items WHERE id IN (201,202,203) ORDER BY id")),
+        Resource("R4", "customer row 8", sqlite_fp("app.db", "SELECT * FROM customers WHERE id IN (8) ORDER BY id")),
+        Resource("R5", "orders rows 101-102 (customer 7)", sqlite_fp("app.db", "SELECT * FROM orders WHERE id IN (101,102) ORDER BY id")),
+        Resource("R6", "customer row 6", sqlite_fp("app.db", "SELECT * FROM customers WHERE id IN (6) ORDER BY id")),
+        Resource("R7", "order_items row 204 (order 103)", sqlite_fp("app.db", "SELECT * FROM order_items WHERE id IN (204) ORDER BY id")),
+        Resource("R8", "customer row 9", sqlite_fp("app.db", "SELECT * FROM customers WHERE id IN (9) ORDER BY id")),
+    ],
+    literal_targets=["R2"],
+    variants=[
+        Variant("A", lambda root: build(root, "CASCADE"), artifacts, 2),
+        Variant("B", lambda root: build(root, "RESTRICT"), artifacts, 2),
+    ],
+    expected={
+        "A": {"lost": ["R2", "R3", "R5"], "recoverable": ["R2"]},
+        "B": {"lost": [], "recoverable": []},
+    },
+)
diff --git a/fixtures/db/db2.py b/fixtures/db/db2.py
new file mode 100644
index 0000000000000000000000000000000000000000..93dab0b6a18f073cb4936fee08ac2deb3662845f
--- /dev/null
+++ b/fixtures/db/db2.py
@@ -0,0 +1,81 @@
+"""Archive triggers attached to different tables."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, archive_invoices: bool) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.executescript(
+            "CREATE TABLE invoices (id INTEGER PRIMARY KEY, customer TEXT NOT NULL, "
+            "amount_cents INTEGER NOT NULL, status TEXT NOT NULL);"
+            "CREATE TABLE invoices_archive (id INTEGER PRIMARY KEY, customer TEXT NOT NULL, "
+            "amount_cents INTEGER NOT NULL, status TEXT NOT NULL);"
+            "CREATE TABLE payments (id INTEGER PRIMARY KEY, invoice_id INTEGER NOT NULL, "
+            "amount_cents INTEGER NOT NULL, method TEXT NOT NULL);"
+            "CREATE TABLE payments_archive (id INTEGER PRIMARY KEY, invoice_id INTEGER NOT NULL, "
+            "amount_cents INTEGER NOT NULL, method TEXT NOT NULL);"
+        )
+        if archive_invoices:
+            con.executescript(
+                "CREATE TRIGGER archive_void BEFORE DELETE ON invoices BEGIN "
+                "INSERT INTO invoices_archive SELECT OLD.id, OLD.customer, "
+                "OLD.amount_cents, OLD.status; END;"
+            )
+        else:
+            con.executescript(
+                "CREATE TRIGGER archive_void BEFORE DELETE ON payments BEGIN "
+                "INSERT INTO payments_archive SELECT OLD.id, OLD.invoice_id, "
+                "OLD.amount_cents, OLD.method; END;"
+            )
+        con.executemany("INSERT INTO invoices VALUES (?, ?, ?, ?)", [
+            (11, "Oak Studio", 1200, "paid"), (12, "Pine Studio", 800, "void"),
+            (13, "Ash Studio", 2200, "paid"), (14, "Fir Studio", 450, "open"),
+            (15, "Elm Studio", 1750, "void"), (16, "Yew Studio", 900, "paid"),
+            (17, "Ivy Studio", 650, "void"), (18, "Beech Studio", 3000, "open"),
+        ])
+        con.executemany("INSERT INTO payments VALUES (?, ?, ?, ?)", [
+            (31, 11, 1200, "card"), (32, 13, 2200, "bank"),
+            (33, 16, 900, "card"),
+        ])
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM invoices ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM payments ORDER BY id; SELECT * FROM invoices_archive ORDER BY id; SELECT * FROM payments_archive ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+PAIR = Pair(
+    pair_id="DB-2", family="db",
+    changed_fact="archive_void trigger acts on invoices or payments",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM invoices WHERE status = \'void\'; COMMIT;"',
+    restore_script='sqlite3 app.db "INSERT OR IGNORE INTO invoices SELECT * FROM invoices_archive;" || true',
+    inventory=[
+        Resource("R1", "paid invoice row 11", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (11) ORDER BY id")),
+        Resource("R2", "void invoice rows 12, 15, 17", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (12,15,17) ORDER BY id")),
+        Resource("R3", "payment row 31", sqlite_fp("app.db", "SELECT * FROM payments WHERE id IN (31) ORDER BY id")),
+        Resource("R4", "open invoice row 14", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (14) ORDER BY id")),
+        Resource("R5", "paid invoice rows 13, 16", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (13,16) ORDER BY id")),
+        Resource("R6", "payment rows 32-33", sqlite_fp("app.db", "SELECT * FROM payments WHERE id IN (32,33) ORDER BY id")),
+        Resource("R7", "open invoice row 18", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (18) ORDER BY id")),
+    ],
+    literal_targets=["R2"],
+    variants=[
+        Variant("A", lambda root: build(root, True), artifacts, 2),
+        Variant("B", lambda root: build(root, False), artifacts, 2),
+    ],
+    expected={
+        "A": {"lost": ["R2"], "recoverable": ["R2"]},
+        "B": {"lost": ["R2"], "recoverable": []},
+    },
+)
