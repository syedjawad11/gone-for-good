+
+def build(root: Path, null_user_id: bool) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.executescript(
+            "CREATE TABLE users (id INTEGER PRIMARY KEY, handle TEXT NOT NULL);"
+            "CREATE TABLE active_sessions (id INTEGER PRIMARY KEY, user_id INTEGER, "
+            "ended_at TEXT);"
+            "CREATE TABLE users_snapshot (id INTEGER PRIMARY KEY, handle TEXT NOT NULL);"
+            "CREATE TABLE settings (id INTEGER PRIMARY KEY, key TEXT NOT NULL, value TEXT NOT NULL);"
+        )
+        con.executemany("INSERT INTO users VALUES (?, ?)", [
+            (i, f"member{i}") for i in range(1, 9)
+        ])
+        con.executemany("INSERT INTO active_sessions VALUES (?, ?, ?)", [
+            (21, 2, "2026-02-01"),
+            (22, 5, "2026-02-02"),
+            (23, None if null_user_id else 2,
+             "2026-02-03" if null_user_id else None),
+        ])
+        con.execute("INSERT INTO users_snapshot SELECT * FROM users WHERE id BETWEEN 1 AND 4")
+        con.execute("INSERT INTO settings VALUES (1, 'session_window', '30 days')")
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM users ORDER BY id; SELECT * FROM users_snapshot ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM active_sessions ORDER BY id; SELECT * FROM settings ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+PAIR = Pair(
+    pair_id="DB-4", family="db",
+    changed_fact="session row 23 has NULL in user_id or ended_at",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM users WHERE id NOT IN (SELECT user_id FROM active_sessions); COMMIT;"',
+    restore_script='sqlite3 app.db "INSERT OR IGNORE INTO users SELECT * FROM users_snapshot;" || true',
+    inventory=[
+        Resource("R1", "active users rows 2 and 5", sqlite_fp("app.db", "SELECT * FROM users WHERE id IN (2,5) ORDER BY id")),
+        Resource("R2", "users rows 6-8", sqlite_fp("app.db", "SELECT * FROM users WHERE id IN (6,7,8) ORDER BY id")),
+        Resource("R3", "session rows 21-22", sqlite_fp("app.db", "SELECT * FROM active_sessions WHERE id IN (21,22) ORDER BY id")),
+        Resource("R4", "users rows 1, 3-4", sqlite_fp("app.db", "SELECT * FROM users WHERE id IN (1,3,4) ORDER BY id")),
+        Resource("R5", "settings row 1", sqlite_fp("app.db", "SELECT * FROM settings WHERE id IN (1) ORDER BY id")),
+        Resource("R6", "session row 23", sqlite_fp("app.db", "SELECT * FROM active_sessions WHERE id IN (23) ORDER BY id")),
+        Resource("R7", "snapshot rows 1-4", sqlite_fp("app.db", "SELECT * FROM users_snapshot WHERE id IN (1,2,3,4) ORDER BY id")),
+    ],
+    literal_targets=["R1", "R2", "R4"],
+    variants=[
+        Variant("A", lambda root: build(root, False), artifacts, 2),
+        Variant("B", lambda root: build(root, True), artifacts, 2),
+    ],
+    expected={
+        "A": {"lost": ["R2", "R4"], "recoverable": ["R4"]},
+        "B": {"lost": [], "recoverable": []},
+    },
+)
diff --git a/tests/test_fixtures_db.py b/tests/test_fixtures_db.py
new file mode 100644
index 0000000000000000000000000000000000000000..fbeafee874f8ec173122ed2a1d4561861e0a879f
--- /dev/null
+++ b/tests/test_fixtures_db.py
@@ -0,0 +1,111 @@
+"""Execute each SQLite fixture against its exact authored shell commands."""
+
+import re
+import sqlite3
+import subprocess
+
+import pytest
+
+from fixtures.base import env_for
+from fixtures.db import db1, db2, db3, db4
+
+
+PAIRS = [db1.PAIR, db2.PAIR, db3.PAIR, db4.PAIR]
+
+
+def run(root, script):
+    return subprocess.run(
+        ["bash", "--noprofile", "--norc", "-c", script],
+        cwd=str(root), env=env_for(root), capture_output=True, text=True,
+    )
+
+
+def all_rows(root):
+    """Include rows outside the inventory when checking failed transactions."""
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        tables = [row[0] for row in con.execute(
+            "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"
+        )]
+        return {name: con.execute(f'SELECT * FROM "{name}" ORDER BY rowid').fetchall()
+                for name in tables}
+    finally:
+        con.close()
+
+
+@pytest.mark.parametrize("pair", PAIRS, ids=lambda pair: pair.pair_id)
+def test_pair_execution_and_artifacts(pair, tmp_path):
+    titles = []
+    schemas = []
+    for variant in pair.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+
+        con = sqlite3.connect(str(root / "app.db"))
+        try:
+            assert con.execute("PRAGMA journal_mode").fetchone()[0] == "delete"
+        finally:
+            con.close()
+
+        artifacts = variant.artifacts(root)
+        assert artifacts
+        assert all(artifact.body for artifact in artifacts)
+        titles.append([artifact.title for artifact in artifacts])
+        schemas.append(artifacts[0].body)
+        assert artifacts[0].title == "$ sqlite3 app.db .schema"
+        assert all("-header -column" in artifact.title and '.nullvalue NULL' in artifact.title
+                   for artifact in artifacts[1:])
+        for artifact in artifacts:
+            assert not re.search(r"\b(?:variant|typo|bug|danger|careful)\b|\b(?:old_|broken_|tmp_bad)",
+                                 artifact.title + artifact.body, re.IGNORECASE)
+
+        before = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
+        assert all(value is not None for value in before.values())
+        all_before = all_rows(root)
+
+        result = run(root, pair.operation)
+        should_fail = pair.pair_id in ("DB-1", "DB-3") and variant.variant == "B"
+        assert (result.returncode != 0) == should_fail, result.stderr
+        if should_fail:
+            assert all_rows(root) == all_before  # -bail exits with the transaction open: rollback
+            assert "Error" in result.stderr or "constraint" in result.stderr.lower()
+
+        after = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
+        lost = {resource_id for resource_id, value in before.items()
+                if after[resource_id] != value}
+        assert run(root, pair.restore_script).returncode == 0
+        restored = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
+        recoverable = {resource_id for resource_id in lost
+                       if restored[resource_id] == before[resource_id]}
+        assert lost == set(pair.expected[variant.variant]["lost"])
+        assert recoverable == set(pair.expected[variant.variant]["recoverable"])
+
+    assert titles[0] == titles[1]
+    assert abs(len(schemas[0]) - len(schemas[1])) / max(map(len, schemas)) <= 0.10
+
+
+def test_db2_archive_targets(tmp_path):
+    pair = db2.PAIR
+    for variant in pair.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        result = run(root, pair.operation)
+        assert result.returncode == 0, result.stderr
+        rows = all_rows(root)
+        if variant.variant == "A":
+            assert [row[0] for row in rows["invoices_archive"]] == [12, 15, 17]
+        else:
+            assert rows["invoices_archive"] == []
+        assert rows["payments_archive"] == []
+
+
+def test_db4_null_is_in_only_one_subquery_column(tmp_path):
+    for variant in db4.PAIR.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        sessions = all_rows(root)["active_sessions"]
+        assert sum(row[1] is None for row in sessions) == (variant.variant == "B")
+        assert sum(row[2] is None for row in sessions) == (variant.variant == "A")

