+            (17, "Ivy Studio", 650, "void"), (18, "Beech Studio", 3000, "open"),
+        ])
+        con.executemany("INSERT INTO payments VALUES (?, ?, ?, ?)", [
+            (31, 11, 1200, "card"), (32, 13, 2200, "bank"),
+            (33, 16, 900, "card"),
+        ])
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM invoices ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM payments ORDER BY id; SELECT * FROM invoices_archive ORDER BY id; SELECT * FROM payments_archive ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+PAIR = Pair(
+    pair_id="DB-2", family="db",
+    changed_fact="archive_void trigger acts on invoices or payments",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM invoices WHERE status = \'void\'; COMMIT;"',
+    restore_script='sqlite3 app.db "INSERT OR IGNORE INTO invoices SELECT * FROM invoices_archive;" || true',
+    inventory=[
+        Resource("R1", "paid invoice row 11", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (11) ORDER BY id")),
+        Resource("R2", "void invoice rows 12, 15, 17", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (12,15,17) ORDER BY id")),
+        Resource("R3", "payment row 31", sqlite_fp("app.db", "SELECT * FROM payments WHERE id IN (31) ORDER BY id")),
+        Resource("R4", "open invoice row 14", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (14) ORDER BY id")),
+        Resource("R5", "paid invoice rows 13, 16", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (13,16) ORDER BY id")),
+        Resource("R6", "payment rows 32-33", sqlite_fp("app.db", "SELECT * FROM payments WHERE id IN (32,33) ORDER BY id")),
+        Resource("R7", "open invoice row 18", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (18) ORDER BY id")),
+    ],
+    literal_targets=["R2"],
+    variants=[
+        Variant("A", lambda root: build(root, True), artifacts, 2),
+        Variant("B", lambda root: build(root, False), artifacts, 2),
+    ],
+    expected={
+        "A": {"lost": ["R2"], "recoverable": ["R2"]},
+        "B": {"lost": ["R2"], "recoverable": []},
+    },
+)
diff --git a/fixtures/db/db3.py b/fixtures/db/db3.py
new file mode 100644
index 0000000000000000000000000000000000000000..fc32f5b537c210e707e3cb906ceda5d71235bc76
--- /dev/null
+++ b/fixtures/db/db3.py
@@ -0,0 +1,68 @@
+"""A failed audit insert decides whether a log purge commits."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, actor_required: bool) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        audit_columns = ("action TEXT, actor TEXT NOT NULL" if actor_required
+                         else "action TEXT NOT NULL, actor TEXT")
+        con.executescript(
+            "CREATE TABLE logs (id INTEGER PRIMARY KEY, ts TEXT NOT NULL, "
+            "message TEXT NOT NULL);"
+            f"CREATE TABLE audit (id INTEGER PRIMARY KEY, {audit_columns});"
+            "CREATE TABLE logs_export (id INTEGER PRIMARY KEY, ts TEXT NOT NULL, "
+            "message TEXT NOT NULL);"
+        )
+        con.executemany("INSERT INTO logs VALUES (?, ?, ?)", [
+            (101, "2025-09-18", "scheduler started"),
+            (102, "2025-11-30", "batch completed"),
+            (103, "2025-12-03", "queue checked"),
+            (104, "2025-12-21", "report created"),
+            (105, "2026-01-02", "scheduler started"),
+            (106, "2026-02-14", "batch completed"),
+            (107, "2026-03-10", "queue checked"),
+        ])
+        con.execute("INSERT INTO logs_export SELECT * FROM logs WHERE ts >= '2025-12-01' AND ts < '2026-01-01'")
+        con.execute("INSERT INTO audit VALUES (1, 'start', 'system')")
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM logs ORDER BY id; SELECT * FROM logs_export ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM audit ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+PAIR = Pair(
+    pair_id="DB-3", family="db",
+    changed_fact="audit.actor or audit.action carries the NOT NULL constraint",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM logs WHERE ts < \'2026-01-01\'; INSERT INTO audit(action, actor) VALUES (\'purge\', NULL); COMMIT;"',
+    restore_script='sqlite3 app.db "INSERT OR IGNORE INTO logs SELECT * FROM logs_export;" || true',
+    inventory=[
+        Resource("R1", "2026 log rows 105-106", sqlite_fp("app.db", "SELECT * FROM logs WHERE id IN (105,106) ORDER BY id")),
+        Resource("R2", "December 2025 log rows 103-104", sqlite_fp("app.db", "SELECT * FROM logs WHERE id IN (103,104) ORDER BY id")),
+        Resource("R3", "audit row 1", sqlite_fp("app.db", "SELECT * FROM audit WHERE id IN (1) ORDER BY id")),
+        Resource("R4", "September-November 2025 log rows 101-102", sqlite_fp("app.db", "SELECT * FROM logs WHERE id IN (101,102) ORDER BY id")),
+        Resource("R5", "2026 log row 107", sqlite_fp("app.db", "SELECT * FROM logs WHERE id IN (107) ORDER BY id")),
+        Resource("R6", "exported December log rows 103-104", sqlite_fp("app.db", "SELECT * FROM logs_export WHERE id IN (103,104) ORDER BY id")),
+    ],
+    literal_targets=["R2", "R4"],
+    variants=[
+        Variant("A", lambda root: build(root, False), artifacts, 2),
+        Variant("B", lambda root: build(root, True), artifacts, 2),
+    ],
+    expected={
+        "A": {"lost": ["R2", "R4"], "recoverable": ["R2"]},
+        "B": {"lost": [], "recoverable": []},
+    },
+)
diff --git a/fixtures/db/db4.py b/fixtures/db/db4.py
new file mode 100644
index 0000000000000000000000000000000000000000..1339aae5beb1f1284d6a1b8e7259891c45b3f8be
--- /dev/null
+++ b/fixtures/db/db4.py
@@ -0,0 +1,67 @@
+"""A nullable subquery changes the effect of NOT IN."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, null_user_id: bool) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.executescript(
+            "CREATE TABLE users (id INTEGER PRIMARY KEY, handle TEXT NOT NULL);"
+            "CREATE TABLE active_sessions (id INTEGER PRIMARY KEY, user_id INTEGER, "
+            "ended_at TEXT);"
+            "CREATE TABLE users_snapshot (id INTEGER PRIMARY KEY, handle TEXT NOT NULL);"
+            "CREATE TABLE settings (id INTEGER PRIMARY KEY, key TEXT NOT NULL, value TEXT NOT NULL);"
+        )
+        con.executemany("INSERT INTO users VALUES (?, ?)", [
+            (i, f"member{i}") for i in range(1, 9)
+        ])
+        con.executemany("INSERT INTO active_sessions VALUES (?, ?, ?)", [
+            (21, 2, "2026-02-01"),
+            (22, 5, "2026-02-02"),
+            (23, None if null_user_id else 2,
+             "2026-02-03" if null_user_id else None),
+        ])
+        con.execute("INSERT INTO users_snapshot SELECT * FROM users WHERE id BETWEEN 1 AND 4")
+        con.execute("INSERT INTO settings VALUES (1, 'session_window', '30 days')")
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM users ORDER BY id; SELECT * FROM users_snapshot ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM active_sessions ORDER BY id; SELECT * FROM settings ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+PAIR = Pair(
+    pair_id="DB-4", family="db",
+    changed_fact="session row 23 has NULL in user_id or ended_at",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM users WHERE id NOT IN (SELECT user_id FROM active_sessions); COMMIT;"',
+    restore_script='sqlite3 app.db "INSERT OR IGNORE INTO users SELECT * FROM users_snapshot;" || true',
+    inventory=[
+        Resource("R1", "active users rows 2 and 5", sqlite_fp("app.db", "SELECT * FROM users WHERE id IN (2,5) ORDER BY id")),
+        Resource("R2", "users rows 6-8", sqlite_fp("app.db", "SELECT * FROM users WHERE id IN (6,7,8) ORDER BY id")),
+        Resource("R3", "session rows 21-22", sqlite_fp("app.db", "SELECT * FROM active_sessions WHERE id IN (21,22) ORDER BY id")),
+        Resource("R4", "users rows 1, 3-4", sqlite_fp("app.db", "SELECT * FROM users WHERE id IN (1,3,4) ORDER BY id")),
+        Resource("R5", "settings row 1", sqlite_fp("app.db", "SELECT * FROM settings WHERE id IN (1) ORDER BY id")),
+        Resource("R6", "session row 23", sqlite_fp("app.db", "SELECT * FROM active_sessions WHERE id IN (23) ORDER BY id")),
+        Resource("R7", "snapshot rows 1-4", sqlite_fp("app.db", "SELECT * FROM users_snapshot WHERE id IN (1,2,3,4) ORDER BY id")),
+    ],
+    literal_targets=["R1", "R2", "R4"],
+    variants=[
+        Variant("A", lambda root: build(root, False), artifacts, 2),
+        Variant("B", lambda root: build(root, True), artifacts, 2),
+    ],
+    expected={
+        "A": {"lost": ["R2", "R4"], "recoverable": ["R4"]},
+        "B": {"lost": [], "recoverable": []},
+    },
+)
diff --git a/tests/test_fixtures_db.py b/tests/test_fixtures_db.py
new file mode 100644
index 0000000000000000000000000000000000000000..fbeafee874f8ec173122ed2a1d4561861e0a879f
--- /dev/null
+++ b/tests/test_fixtures_db.py
@@ -0,0 +1,111 @@
+"""Execute each SQLite fixture against its exact authored shell commands."""
+
+import re
+import sqlite3
+import subprocess
+
+import pytest
+
+from fixtures.base import env_for
+from fixtures.db import db1, db2, db3, db4
+
+
+PAIRS = [db1.PAIR, db2.PAIR, db3.PAIR, db4.PAIR]
+
+
+def run(root, script):
+    return subprocess.run(
+        ["bash", "--noprofile", "--norc", "-c", script],
+        cwd=str(root), env=env_for(root), capture_output=True, text=True,
+    )
+
+
+def all_rows(root):
+    """Include rows outside the inventory when checking failed transactions."""
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        tables = [row[0] for row in con.execute(
+            "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"
+        )]
+        return {name: con.execute(f'SELECT * FROM "{name}" ORDER BY rowid').fetchall()
+                for name in tables}
+    finally:
+        con.close()
+
+
+@pytest.mark.parametrize("pair", PAIRS, ids=lambda pair: pair.pair_id)
+def test_pair_execution_and_artifacts(pair, tmp_path):
+    titles = []
+    schemas = []
+    for variant in pair.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+
+        con = sqlite3.connect(str(root / "app.db"))
+        try:
+            assert con.execute("PRAGMA journal_mode").fetchone()[0] == "delete"
+        finally:
+            con.close()
+
+        artifacts = variant.artifacts(root)
+        assert artifacts
+        assert all(artifact.body for artifact in artifacts)
+        titles.append([artifact.title for artifact in artifacts])
+        schemas.append(artifacts[0].body)
+        assert artifacts[0].title == "$ sqlite3 app.db .schema"
+        assert all("-header -column" in artifact.title and '.nullvalue NULL' in artifact.title
+                   for artifact in artifacts[1:])
+        for artifact in artifacts:
+            assert not re.search(r"\b(?:variant|typo|bug|danger|careful)\b|\b(?:old_|broken_|tmp_bad)",
+                                 artifact.title + artifact.body, re.IGNORECASE)
+
+        before = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
+        assert all(value is not None for value in before.values())
+        all_before = all_rows(root)
+
+        result = run(root, pair.operation)
+        should_fail = pair.pair_id in ("DB-1", "DB-3") and variant.variant == "B"
+        assert (result.returncode != 0) == should_fail, result.stderr
+        if should_fail:
+            assert all_rows(root) == all_before  # -bail exits with the transaction open: rollback
+            assert "Error" in result.stderr or "constraint" in result.stderr.lower()
+
+        after = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
+        lost = {resource_id for resource_id, value in before.items()
+                if after[resource_id] != value}
+        assert run(root, pair.restore_script).returncode == 0
+        restored = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
+        recoverable = {resource_id for resource_id in lost
+                       if restored[resource_id] == before[resource_id]}
+        assert lost == set(pair.expected[variant.variant]["lost"])
+        assert recoverable == set(pair.expected[variant.variant]["recoverable"])
+
+    assert titles[0] == titles[1]
+    assert abs(len(schemas[0]) - len(schemas[1])) / max(map(len, schemas)) <= 0.10
+
+
+def test_db2_archive_targets(tmp_path):
+    pair = db2.PAIR
+    for variant in pair.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        result = run(root, pair.operation)
+        assert result.returncode == 0, result.stderr
+        rows = all_rows(root)
+        if variant.variant == "A":
+            assert [row[0] for row in rows["invoices_archive"]] == [12, 15, 17]
+        else:
+            assert rows["invoices_archive"] == []
+        assert rows["payments_archive"] == []
+
+
+def test_db4_null_is_in_only_one_subquery_column(tmp_path):
+    for variant in db4.PAIR.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        sessions = all_rows(root)["active_sessions"]
+        assert sum(row[1] is None for row in sessions) == (variant.variant == "B")
+        assert sum(row[2] is None for row in sessions) == (variant.variant == "A")

diff --git a/fixtures/db/db1.py b/fixtures/db/db1.py
new file mode 100644
index 0000000000000000000000000000000000000000..df4f93a5c4258aa1c791df86e2bb793d332ec0e7
--- /dev/null
+++ b/fixtures/db/db1.py
@@ -0,0 +1,75 @@
+"""Customer deletion with two foreign-key actions."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, action: str) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.execute("PRAGMA foreign_keys=ON")
+        con.executescript(
+            "CREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL);"
+            "CREATE TABLE orders (id INTEGER PRIMARY KEY, customer_id INTEGER NOT NULL "
+            f"REFERENCES customers(id) ON DELETE {action}, placed_at TEXT NOT NULL);"
+            "CREATE TABLE order_items (id INTEGER PRIMARY KEY, order_id INTEGER NOT NULL "
+            "REFERENCES orders(id) ON DELETE CASCADE, sku TEXT NOT NULL, qty INTEGER NOT NULL);"
+            "CREATE TABLE customers_snapshot (id INTEGER PRIMARY KEY, name TEXT NOT NULL);"
+        )
+        con.executemany("INSERT INTO customers VALUES (?, ?)", [
+            (6, "Alder Workshop"), (7, "Birch Workshop"),
+            (8, "Cedar Workshop"), (9, "Elm Workshop"),
+        ])
+        con.executemany("INSERT INTO orders VALUES (?, ?, ?)", [
+            (101, 7, "2026-02-03"), (102, 7, "2026-02-04"),
+            (103, 8, "2026-02-05"), (104, 6, "2026-02-06"),
+        ])
+        con.executemany("INSERT INTO order_items VALUES (?, ?, ?, ?)", [
+            (201, 101, "paper", 2), (202, 101, "pencil", 4),
+            (203, 102, "folder", 1), (204, 103, "pen", 3),
+            (205, 104, "clip", 5),
+        ])
+        con.execute("INSERT INTO customers_snapshot SELECT * FROM customers")
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db '
+        '"SELECT * FROM customers ORDER BY id; SELECT * FROM customers_snapshot ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db '
+        '"SELECT * FROM orders ORDER BY id; SELECT * FROM order_items ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+PAIR = Pair(
+    pair_id="DB-1", family="db",
+    changed_fact="orders.customer_id uses CASCADE or RESTRICT on customer deletion",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM customers WHERE id = 7; COMMIT;"',
+    restore_script='sqlite3 app.db "INSERT OR IGNORE INTO customers SELECT * FROM customers_snapshot;" || true',
+    inventory=[
+        Resource("R1", "orders row 103 (customer 8)", sqlite_fp("app.db", "SELECT * FROM orders WHERE id IN (103) ORDER BY id")),
+        Resource("R2", "customer row 7", sqlite_fp("app.db", "SELECT * FROM customers WHERE id IN (7) ORDER BY id")),
+        Resource("R3", "order_items rows 201-203 (orders 101-102)", sqlite_fp("app.db", "SELECT * FROM order_items WHERE id IN (201,202,203) ORDER BY id")),
+        Resource("R4", "customer row 8", sqlite_fp("app.db", "SELECT * FROM customers WHERE id IN (8) ORDER BY id")),
+        Resource("R5", "orders rows 101-102 (customer 7)", sqlite_fp("app.db", "SELECT * FROM orders WHERE id IN (101,102) ORDER BY id")),
+        Resource("R6", "customer row 6", sqlite_fp("app.db", "SELECT * FROM customers WHERE id IN (6) ORDER BY id")),
+        Resource("R7", "order_items row 204 (order 103)", sqlite_fp("app.db", "SELECT * FROM order_items WHERE id IN (204) ORDER BY id")),
+        Resource("R8", "customer row 9", sqlite_fp("app.db", "SELECT * FROM customers WHERE id IN (9) ORDER BY id")),
+    ],
+    literal_targets=["R2"],
+    variants=[
+        Variant("A", lambda root: build(root, "CASCADE"), artifacts, 2),
+        Variant("B", lambda root: build(root, "RESTRICT"), artifacts, 2),
+    ],
+    expected={
+        "A": {"lost": ["R2", "R3", "R5"], "recoverable": ["R2"]},
+        "B": {"lost": [], "recoverable": []},
+    },
+)
diff --git a/fixtures/db/db2.py b/fixtures/db/db2.py
new file mode 100644
index 0000000000000000000000000000000000000000..93dab0b6a18f073cb4936fee08ac2deb3662845f
--- /dev/null
+++ b/fixtures/db/db2.py
@@ -0,0 +1,81 @@
+"""Archive triggers attached to different tables."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, archive_invoices: bool) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.executescript(
+            "CREATE TABLE invoices (id INTEGER PRIMARY KEY, customer TEXT NOT NULL, "
+            "amount_cents INTEGER NOT NULL, status TEXT NOT NULL);"
+            "CREATE TABLE invoices_archive (id INTEGER PRIMARY KEY, customer TEXT NOT NULL, "
+            "amount_cents INTEGER NOT NULL, status TEXT NOT NULL);"
+            "CREATE TABLE payments (id INTEGER PRIMARY KEY, invoice_id INTEGER NOT NULL, "
+            "amount_cents INTEGER NOT NULL, method TEXT NOT NULL);"
+            "CREATE TABLE payments_archive (id INTEGER PRIMARY KEY, invoice_id INTEGER NOT NULL, "
+            "amount_cents INTEGER NOT NULL, method TEXT NOT NULL);"
+        )
+        if archive_invoices:
+            con.executescript(
+                "CREATE TRIGGER archive_void BEFORE DELETE ON invoices BEGIN "
+                "INSERT INTO invoices_archive SELECT OLD.id, OLD.customer, "
+                "OLD.amount_cents, OLD.status; END;"
+            )
+        else:
+            con.executescript(
+                "CREATE TRIGGER archive_void BEFORE DELETE ON payments BEGIN "
+                "INSERT INTO payments_archive SELECT OLD.id, OLD.invoice_id, "
+                "OLD.amount_cents, OLD.method; END;"
+            )
+        con.executemany("INSERT INTO invoices VALUES (?, ?, ?, ?)", [
+            (11, "Oak Studio", 1200, "paid"), (12, "Pine Studio", 800, "void"),
+            (13, "Ash Studio", 2200, "paid"), (14, "Fir Studio", 450, "open"),
+            (15, "Elm Studio", 1750, "void"), (16, "Yew Studio", 900, "paid"),
+            (17, "Ivy Studio", 650, "void"), (18, "Beech Studio", 3000, "open"),
+        ])
+        con.executemany("INSERT INTO payments VALUES (?, ?, ?, ?)", [
+            (31, 11, 1200, "card"), (32, 13, 2200, "bank"),
+            (33, 16, 900, "card"),
+        ])
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM invoices ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM payments ORDER BY id; SELECT * FROM invoices_archive ORDER BY id; SELECT * FROM payments_archive ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+PAIR = Pair(
+    pair_id="DB-2", family="db",
+    changed_fact="archive_void trigger acts on invoices or payments",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM invoices WHERE status = \'void\'; COMMIT;"',
+    restore_script='sqlite3 app.db "INSERT OR IGNORE INTO invoices SELECT * FROM invoices_archive;" || true',
+    inventory=[
+        Resource("R1", "paid invoice row 11", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (11) ORDER BY id")),
+        Resource("R2", "void invoice rows 12, 15, 17", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (12,15,17) ORDER BY id")),
+        Resource("R3", "payment row 31", sqlite_fp("app.db", "SELECT * FROM payments WHERE id IN (31) ORDER BY id")),
+        Resource("R4", "open invoice row 14", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (14) ORDER BY id")),
+        Resource("R5", "paid invoice rows 13, 16", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (13,16) ORDER BY id")),
+        Resource("R6", "payment rows 32-33", sqlite_fp("app.db", "SELECT * FROM payments WHERE id IN (32,33) ORDER BY id")),
+        Resource("R7", "open invoice row 18", sqlite_fp("app.db", "SELECT * FROM invoices WHERE id IN (18) ORDER BY id")),
+    ],
+    literal_targets=["R2"],
+    variants=[
+        Variant("A", lambda root: build(root, True), artifacts, 2),
+        Variant("B", lambda root: build(root, False), artifacts, 2),
+    ],
+    expected={
+        "A": {"lost": ["R2"], "recoverable": ["R2"]},
+        "B": {"lost": ["R2"], "recoverable": []},
+    },
+)
diff --git a/fixtures/db/db3.py b/fixtures/db/db3.py
new file mode 100644
index 0000000000000000000000000000000000000000..fc32f5b537c210e707e3cb906ceda5d71235bc76
--- /dev/null
+++ b/fixtures/db/db3.py
@@ -0,0 +1,68 @@
+"""A failed audit insert decides whether a log purge commits."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, actor_required: bool) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        audit_columns = ("action TEXT, actor TEXT NOT NULL" if actor_required
+                         else "action TEXT NOT NULL, actor TEXT")
+        con.executescript(
+            "CREATE TABLE logs (id INTEGER PRIMARY KEY, ts TEXT NOT NULL, "
+            "message TEXT NOT NULL);"
+            f"CREATE TABLE audit (id INTEGER PRIMARY KEY, {audit_columns});"
+            "CREATE TABLE logs_export (id INTEGER PRIMARY KEY, ts TEXT NOT NULL, "
+            "message TEXT NOT NULL);"
+        )
+        con.executemany("INSERT INTO logs VALUES (?, ?, ?)", [
+            (101, "2025-09-18", "scheduler started"),
+            (102, "2025-11-30", "batch completed"),
+            (103, "2025-12-03", "queue checked"),
+            (104, "2025-12-21", "report created"),
+            (105, "2026-01-02", "scheduler started"),
+            (106, "2026-02-14", "batch completed"),
+            (107, "2026-03-10", "queue checked"),
+        ])
+        con.execute("INSERT INTO logs_export SELECT * FROM logs WHERE ts >= '2025-12-01' AND ts < '2026-01-01'")
+        con.execute("INSERT INTO audit VALUES (1, 'start', 'system')")
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM logs ORDER BY id; SELECT * FROM logs_export ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM audit ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+PAIR = Pair(
+    pair_id="DB-3", family="db",
+    changed_fact="audit.actor or audit.action carries the NOT NULL constraint",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM logs WHERE ts < \'2026-01-01\'; INSERT INTO audit(action, actor) VALUES (\'purge\', NULL); COMMIT;"',
+    restore_script='sqlite3 app.db "INSERT OR IGNORE INTO logs SELECT * FROM logs_export;" || true',
+    inventory=[
+        Resource("R1", "2026 log rows 105-106", sqlite_fp("app.db", "SELECT * FROM logs WHERE id IN (105,106) ORDER BY id")),
+        Resource("R2", "December 2025 log rows 103-104", sqlite_fp("app.db", "SELECT * FROM logs WHERE id IN (103,104) ORDER BY id")),
+        Resource("R3", "audit row 1", sqlite_fp("app.db", "SELECT * FROM audit WHERE id IN (1) ORDER BY id")),
+        Resource("R4", "September-November 2025 log rows 101-102", sqlite_fp("app.db", "SELECT * FROM logs WHERE id IN (101,102) ORDER BY id")),
+        Resource("R5", "2026 log row 107", sqlite_fp("app.db", "SELECT * FROM logs WHERE id IN (107) ORDER BY id")),
+        Resource("R6", "exported December log rows 103-104", sqlite_fp("app.db", "SELECT * FROM logs_export WHERE id IN (103,104) ORDER BY id")),
+    ],
+    literal_targets=["R2", "R4"],
+    variants=[
+        Variant("A", lambda root: build(root, False), artifacts, 2),
+        Variant("B", lambda root: build(root, True), artifacts, 2),
+    ],
+    expected={
+        "A": {"lost": ["R2", "R4"], "recoverable": ["R2"]},
+        "B": {"lost": [], "recoverable": []},
+    },
+)
