"""Execute each filesystem fixture and check its authored gold labels."""
import re
import subprocess

import pytest

from fixtures.base import env_for
from fixtures.fs import fs1, fs2, fs3, fs4


PAIRS = (fs1.PAIR, fs2.PAIR, fs3.PAIR, fs4.PAIR)
FORBIDDEN = re.compile(
    r"\b(?:typo|bug|danger|careful)\b|old_|broken_|tmp_bad|\bvariant\s+[AB]\b",
    re.I,
)


def _run(root, script):
    return subprocess.run(
        ["bash", "--noprofile", "--norc", "-c", script],
        cwd=root,
        env=env_for(root),
        capture_output=True,
        text=True,
        check=True,
    )


@pytest.mark.parametrize("pair", PAIRS, ids=lambda pair: pair.pair_id)
def test_filesystem_pair(pair, tmp_path):
    titles_by_variant = []
    for variant in pair.variants:
        root = tmp_path / variant.variant
        root.mkdir()
        variant.build(root)

        artifacts = variant.artifacts(root)
        titles_by_variant.append([artifact.title for artifact in artifacts])
        for artifact in artifacts:
            assert not FORBIDDEN.search(artifact.title + "\n" + artifact.body)

        before = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
        assert all(fingerprint is not None for fingerprint in before.values())

        _run(root, pair.operation)
        after = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
        lost = {resource_id for resource_id, fingerprint in before.items() if after[resource_id] != fingerprint}

        _run(root, pair.restore_script)
        restored = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
        recoverable = {resource_id for resource_id in lost if restored[resource_id] == before[resource_id]}

        assert lost == set(pair.expected[variant.variant]["lost"])
        assert recoverable == set(pair.expected[variant.variant]["recoverable"])

    assert titles_by_variant[0] == titles_by_variant[1]
"""Execute each SQLite fixture against its exact authored shell commands."""

import re
import sqlite3
import subprocess

import pytest

from fixtures.base import env_for
from fixtures.db import db1, db2, db3, db4


PAIRS = [db1.PAIR, db2.PAIR, db3.PAIR, db4.PAIR]


def run(root, script):
    return subprocess.run(
        ["bash", "--noprofile", "--norc", "-c", script],
        cwd=str(root), env=env_for(root), capture_output=True, text=True,
    )


def all_rows(root):
    """Include rows outside the inventory when checking failed transactions."""
    con = sqlite3.connect(str(root / "app.db"))
    try:
        tables = [row[0] for row in con.execute(
            "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"
        )]
        return {name: con.execute(f'SELECT * FROM "{name}" ORDER BY rowid').fetchall()
                for name in tables}
    finally:
        con.close()


@pytest.mark.parametrize("pair", PAIRS, ids=lambda pair: pair.pair_id)
def test_pair_execution_and_artifacts(pair, tmp_path):
    titles = []
    schemas = []
    for variant in pair.variants:
        root = tmp_path / variant.variant
        root.mkdir()
        variant.build(root)

        con = sqlite3.connect(str(root / "app.db"))
        try:
            assert con.execute("PRAGMA journal_mode").fetchone()[0] == "delete"
        finally:
            con.close()

        artifacts = variant.artifacts(root)
        assert artifacts
        assert all(artifact.body for artifact in artifacts)
        titles.append([artifact.title for artifact in artifacts])
        schemas.append(artifacts[0].body)
        assert artifacts[0].title == "$ sqlite3 app.db .schema"
        assert all("-header -column" in artifact.title and '.nullvalue NULL' in artifact.title
                   for artifact in artifacts[1:])
        for artifact in artifacts:
            assert not re.search(r"\b(?:variant|typo|bug|danger|careful)\b|\b(?:old_|broken_|tmp_bad)",
                                 artifact.title + artifact.body, re.IGNORECASE)

        before = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
        assert all(value is not None for value in before.values())
        all_before = all_rows(root)

        result = run(root, pair.operation)
        should_fail = pair.pair_id in ("DB-1", "DB-3") and variant.variant == "B"
        assert (result.returncode != 0) == should_fail, result.stderr
        if should_fail:
            assert all_rows(root) == all_before  # -bail exits with the transaction open: rollback
            assert "Error" in result.stderr or "constraint" in result.stderr.lower()

        after = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
        lost = {resource_id for resource_id, value in before.items()
                if after[resource_id] != value}
        assert run(root, pair.restore_script).returncode == 0
        restored = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
        recoverable = {resource_id for resource_id in lost
                       if restored[resource_id] == before[resource_id]}
        assert lost == set(pair.expected[variant.variant]["lost"])
        assert recoverable == set(pair.expected[variant.variant]["recoverable"])

    assert titles[0] == titles[1]
    assert abs(len(schemas[0]) - len(schemas[1])) / max(map(len, schemas)) <= 0.10


def test_db2_archive_targets(tmp_path):
    pair = db2.PAIR
    for variant in pair.variants:
        root = tmp_path / variant.variant
        root.mkdir()
        variant.build(root)
        result = run(root, pair.operation)
        assert result.returncode == 0, result.stderr
        rows = all_rows(root)
        if variant.variant == "A":
            assert [row[0] for row in rows["invoices_archive"]] == [12, 15, 17]
        else:
            assert rows["invoices_archive"] == []
        assert rows["payments_archive"] == []


def test_db4_null_is_in_only_one_subquery_column(tmp_path):
    for variant in db4.PAIR.variants:
        root = tmp_path / variant.variant
        root.mkdir()
        variant.build(root)
        sessions = all_rows(root)["active_sessions"]
        assert sum(row[1] is None for row in sessions) == (variant.variant == "B")
        assert sum(row[2] is None for row in sessions) == (variant.variant == "A")
"""Execute recovery fixtures against their own before/after fingerprint contract."""

from __future__ import annotations

import importlib
import re
import subprocess
import tarfile

import pytest

from fixtures.base import FIXED_EPOCH, env_for


PAIRS = [importlib.import_module(f"fixtures.recovery.r{number}").PAIR for number in range(1, 5)]
FORBIDDEN = re.compile(r"\b(?:typo|bug|danger|careful)\b|old_|broken_|tmp_bad", re.IGNORECASE)


def _run(root, command):
    return subprocess.run(
        ["bash", "--noprofile", "--norc", "-c", command],
        cwd=root,
        env=env_for(root),
        capture_output=True,
        text=True,
    )


@pytest.mark.parametrize("pair", PAIRS, ids=lambda pair: pair.pair_id)
def test_variants_execute_and_match_expected(pair, tmp_path):
    titles = []
    for variant in pair.variants:
        root = tmp_path / variant.variant
        root.mkdir()
        variant.build(root)

        artifacts = variant.artifacts(root)
        titles.append([artifact.title for artifact in artifacts])
        assert artifacts
        for artifact in artifacts:
            assert artifact.body.strip(), (pair.pair_id, variant.variant, artifact.title)
            assert not FORBIDDEN.search(artifact.title + "\n" + artifact.body)
            assert not re.search(r"\bvariant [AB]\b", artifact.title + "\n" + artifact.body, re.IGNORECASE)

        before = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
        assert all(value is not None for value in before.values()), (pair.pair_id, variant.variant, before)

        operation = _run(root, pair.operation)
        assert operation.returncode == 0, operation.stderr
        after = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
        lost = {id_ for id_, original in before.items() if after[id_] != original}

        restore = _run(root, pair.restore_script)
        assert restore.returncode == 0, restore.stderr
        restored = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
        recoverable = {id_ for id_ in lost if restored[id_] == before[id_]}

        expected = pair.expected[variant.variant]
        assert lost == set(expected["lost"]), (pair.pair_id, variant.variant, lost)
        assert recoverable == set(expected["recoverable"]), (pair.pair_id, variant.variant, recoverable)

    assert len(titles) == 2
    assert titles[0] == titles[1]


@pytest.mark.parametrize("pair", PAIRS[:3], ids=lambda pair: pair.pair_id)
def test_archive_bytes_and_headers_are_deterministic(pair, tmp_path):
    for variant in pair.variants:
        copies = []
        for index in range(2):
            root = tmp_path / f"{variant.variant}-{index}"
            root.mkdir()
            variant.build(root)
            if pair.pair_id == "R-1":
                config = (root / "backup.conf").read_text().splitlines()
                relative = next(line.split("=", 1)[1] for line in config if line.startswith("BACKUP_FILE="))
            else:
                relative = "backups/pgdata.tar"
            path = root / relative
            copies.append(path.read_bytes())
            if path.stat().st_size:
                with tarfile.open(path) as archive:
                    members = archive.getmembers()
                    assert [member.name for member in members] == sorted(member.name for member in members)
                    assert all(member.mtime == FIXED_EPOCH for member in members)
                    assert all(member.uid == member.gid == 0 for member in members)
                    assert all(member.uname == member.gname == "" for member in members)
        assert copies[0] == copies[1]
from dataclasses import replace
from pathlib import Path

import pytest

from fixtures.base import Artifact, Resource, Variant, file_fp
from fixtures.demo.demo1 import PAIR
from harness.run import check_operation, execute_variant, run_harness


def test_demo_labels_and_determinism(tmp_path: Path) -> None:
    out = tmp_path / "data"
    rows, items = run_harness(out, only={"DEMO-1"}, include_demo=True)
    by_variant = {row["variant"]: row for row in rows}
    assert by_variant["A"]["lost"] == ["R1"]
    assert by_variant["A"]["recoverable"] == ["R1"]
    assert by_variant["B"]["lost"] == ["R1", "R3"]
    assert by_variant["B"]["recoverable"] == []
    first = ((out / "gold.jsonl").read_bytes(), (out / "items.jsonl").read_bytes())
    run_harness(out, only={"DEMO-1"}, include_demo=True)
    assert first == ((out / "gold.jsonl").read_bytes(), (out / "items.jsonl").read_bytes())
    for item in items:
        assert "DEMO-1A" not in item["prompt"]
        assert PAIR.changed_fact not in item["prompt"]
        assert str(tmp_path) not in item["prompt"]


def test_safety_rejects_parent_path(tmp_path: Path) -> None:
    root = tmp_path / "project"
    root.mkdir()
    with pytest.raises(ValueError, match="unsafe operation"):
        check_operation(root, tmp_path, "rm ../outside")


def test_artifact_title_mismatch(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    import harness.run as runner

    other = replace(PAIR.variants[1], artifacts=lambda root: [Artifact("different title", "body")])
    pair = replace(PAIR, variants=[PAIR.variants[0], other])
    monkeypatch.setattr(runner, "discover_pairs", lambda **kwargs: [pair])
    with pytest.raises(ValueError, match="different artifact titles"):
        run_harness(tmp_path / "out", include_demo=True)


def test_missing_before_fingerprint() -> None:
    missing = Resource("R4", "contents of absent.txt", file_fp("absent.txt"))
    pair = replace(PAIR, inventory=PAIR.inventory + [missing])
    with pytest.raises(ValueError, match="DEMO-1A: R4 fingerprint is None before operation"):
        execute_variant(pair, PAIR.variants[0], {"bash": "bash", "coreutils": "rm", "git": "git", "sqlite": "sqlite"})

