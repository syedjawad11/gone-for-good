+    variant = replace(PAIR.variants[0], artifacts=artifacts)
+    _, item, _, _ = execute_variant(PAIR, variant, {"bash": "bash", "coreutils": "coreutils", "git": "git", "sqlite": "3.40"})
+    prompt = item["prompt"]
