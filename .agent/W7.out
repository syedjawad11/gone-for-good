+        root.mkdir()
+        variant.build(root)
+        assert (root / "backups/config.tar").is_file()
+        assert (root / "volumes/pgdata/.snapshots/wal-old.tar").is_file()
+
+
+@pytest.mark.parametrize("pair", PAIRS[1:3], ids=lambda pair: pair.pair_id)
+def test_archive_hash_evidence_is_from_tar(pair, tmp_path):
+    for variant in pair.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        artifacts = {artifact.title: artifact.body for artifact in variant.artifacts(root)}
+        member_title = next(title for title in artifacts if title.startswith("$ for f in $(tar -tf"))
+        member_hashes = {line.split()[0]: line.split()[1] for line in artifacts[member_title].splitlines()}
+        live_title = "$ sha256sum volumes/pgdata/*.seg"
+        live_hashes = {line.split()[1].replace("volumes/", ""): line.split()[0]
+                       for line in artifacts[live_title].splitlines()}
+        if pair.pair_id == "R-3" and variant.variant == "B":
+            assert member_hashes == {}
+        else:
+            for name, digest in member_hashes.items():
+                if name in live_hashes:
+                    assert (digest == live_hashes[name]) == (
+                        pair.pair_id == "R-3" or variant.variant == "A" or name != "pgdata/orders.seg"
+                    )
+
+
+def test_r4_shows_both_schemas(tmp_path):
+    for variant in PAIRS[3].variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        artifacts = {artifact.title: artifact.body for artifact in variant.artifacts(root)}
+        for database in ("primary", "replica"):
+            assert "CREATE TABLE accounts" in artifacts[f"$ sqlite3 {database}.db .schema"]
diff --git a/tests/test_harness.py b/tests/test_harness.py
index 1aa7ed0278bebc1a4e2355ef6fecb01a81725922..050d83522317ec1d82266ebd1752b45ff4cf9a12
--- a/tests/test_harness.py
+++ b/tests/test_harness.py
@@ -47,3 +47,15 @@
     pair = replace(PAIR, inventory=PAIR.inventory + [missing])
     with pytest.raises(ValueError, match="DEMO-1A: R4 fingerprint is None before operation"):
         execute_variant(pair, PAIR.variants[0], {"bash": "bash", "coreutils": "rm", "git": "git", "sqlite": "sqlite"})
+
+
+def test_prompt_shell_context_and_allocation_total_filter() -> None:
+    artifacts = lambda root: [Artifact("$ ls -la sample", "total 8\n-rw-r--r-- 1 user group 1 Jan 1 2026 file\n")]
+    variant = replace(PAIR.variants[0], artifacts=artifacts)
+    _, item, _, _ = execute_variant(PAIR, variant, {"bash": "bash", "coreutils": "coreutils", "git": "git", "sqlite": "3.40"})
+    prompt = item["prompt"]
+    assert "total 8" not in prompt
+    assert "-rw-r--r--" in prompt
+    assert "fresh bash process (no startup files, default shell options, a clean environment" in prompt
+    assert "The restore script then runs the same way, in a new bash process" in prompt
+    assert "=== Restore script (run afterwards in a new bash process) ===" in prompt

