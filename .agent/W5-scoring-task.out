diff --git a/tests/test_scoring.py b/tests/test_scoring.py
new file mode 100644
index 0000000000000000000000000000000000000000..ffb1033a2988c5afc5ce870247ab5e1b7fa33999
--- /dev/null
+++ b/tests/test_scoring.py
@@ -0,0 +1,93 @@
+import json
+from pathlib import Path
+
+import pytest
+
+from scoring import aggregate, baseline_text, bootstrap, parse_answer, score_item
+
+
+DATA = Path(__file__).parent / "data"
+
+
+def read(name):
+    return [json.loads(line) for line in (DATA / name).read_text().splitlines()]
+
+
+GOLD = read("mini_gold.jsonl")
+ITEMS = read("mini_items.jsonl")
+
+
+def answer(gold):
+    return json.dumps({"lost": gold["lost"], "recoverable": gold["recoverable"],
+                       "permanent_loss": gold["permanent_loss"]})
+
+
+def test_parse_wrappers_and_normalization():
+    ids = ["R1", "R2"]
+    for text in ('```json\n{"lost":["r1"],"recoverable":[],"permanent_loss":true}\n```',
+                 'Earlier {bad} then {"lost":["r1"],"recoverable":[],"permanent_loss":true} trailing',
+                 '{"lost":["R2"],"recoverable":[],"permanent_loss":false} '
+                 '{"lost":["r1"],"recoverable":[],"permanent_loss":true}'):
+        parsed = parse_answer(text, ids)
+        assert parsed.ok and parsed.lost == ("R1",)
+
+
+@pytest.mark.parametrize("text,error", [
+    ("plain", "no_json"), ("{oops}", "bad_json"),
+    ('{"lost":[],"recoverable":[]}', "missing_key"),
+    ('{"lost":"R1","recoverable":[],"permanent_loss":false}', "bad_type"),
+    ('{"lost":["R9"],"recoverable":[],"permanent_loss":true}', "unknown_id"),
+    ('{"lost":["R1","r1"],"recoverable":[],"permanent_loss":true}', "duplicate_id"),
+    ('{"lost":[],"recoverable":["R1"],"permanent_loss":false}', "not_subset"),
+])
+def test_parse_errors(text, error):
+    assert parse_answer(text, ["R1"]).error == error
+
+
+def test_perfect_and_one_wrong_variant():
+    rows = [score_item(answer(g), g) for g in GOLD]
+    perfect = aggregate(rows)
+    assert perfect["item_acc"] == perfect["pair_acc"] == perfect["lost_acc"] == perfect["rec_acc"] == 1
+    assert perfect["format_failure_rate"] == perfect["perm_flag_inconsistency_rate"] == 0
+    rows[1] = score_item(answer(GOLD[0]), GOLD[1])
+    summary = aggregate(rows)
+    assert summary["item_acc"] == pytest.approx(5 / 6)
+    assert summary["pair_acc"] == pytest.approx(2 / 3)
+    assert summary["coupling_miss"] == 1
+    rows[2] = score_item("garbage", GOLD[2])
+    assert aggregate(rows)["format_failure_rate"] == pytest.approx(1 / 6)
+    assert not rows[2]["lost_exact"] and not rows[2]["rec_exact"]
+
+
+def test_permanent_and_error_details():
+    row = score_item('{"lost":["R1"],"recoverable":["R1"],"permanent_loss":true}', GOLD[1])
+    assert row["false_assurance"] == ["R1"]
+    assert not row["pred_permanent"] and not row["perm_flag_consistent"]
+    assert row["missed_permanent"]
+    bad = score_item("no JSON", GOLD[1])
+    assert bad["missed_permanent"] and not bad["item_correct"]
+
+
+@pytest.mark.parametrize("name,item_acc,pair_acc,lost_acc,rec_acc", [
+    ("everything_lost", 0, 0, 0, 3 / 6),
+    ("nothing_lost", 1 / 6, 0, 1 / 6, 3 / 6),
+    ("naive_reader", 1 / 6, 0, 2 / 6, 4 / 6),
+])
+def test_frozen_baselines(name, item_acc, pair_acc, lost_acc, rec_acc):
+    rows = [score_item(baseline_text(name, g, i), g) for g, i in zip(GOLD, ITEMS)]
+    summary = aggregate(rows)
+    assert summary["item_acc"] == pytest.approx(item_acc)
+    assert summary["pair_acc"] == pytest.approx(pair_acc)
+    assert summary["lost_acc"] == pytest.approx(lost_acc)
+    assert summary["rec_acc"] == pytest.approx(rec_acc)
+
+
+def test_bootstrap_paired_and_seeded():
+    perfect = [score_item(answer(g), g) for g in GOLD]
+    fail_p1 = [score_item("garbage" if g["pair_id"] == "P1" else answer(g), g) for g in GOLD]
+    samples = {"perfect": perfect, "partial": fail_p1}
+    first = bootstrap(samples, n_boot=100, seed=5)
+    assert first == bootstrap(samples, n_boot=100, seed=5)
+    assert first["models"]["perfect"]["pair_acc"] == [1, 1]
+    assert first["models"]["partial"]["pair_acc"] == first["models"]["partial"]["item_acc"]
+    assert first["pairwise_pair_acc_diff"]["perfect - partial"][0] >= 0
diff --git a/tests/test_task_build.py b/tests/test_task_build.py
new file mode 100644
index 0000000000000000000000000000000000000000..897445c520a744540558d32eacfca03d3b0f9755
--- /dev/null
+++ b/tests/test_task_build.py
@@ -0,0 +1,73 @@
+import json
+import py_compile
+import sys
+import types
+from pathlib import Path
+
+from tasks.build_task import build_task
+
+
+DATA = Path(__file__).parent / "data"
+
+
+class StubLLM:
+    def __init__(self, replies):
+        self.replies = replies
+        self.calls = []
+
+    def prompt(self, prompt, **kwargs):
+        self.calls.append(kwargs)
+        return self.replies[prompt]
+
+
+class FakeTask:
+    def __init__(self, func):
+        self.func = func
+        self.result = None
+
+    def __call__(self, *args):
+        return self.func(*args)
+
+    def run(self, llm):
+        self.result = self.func(llm)
+        return types.SimpleNamespace(result=self.result)
+
+
+def fake_sdk(llm):
+    module = types.ModuleType("kaggle_benchmarks")
+    module.llm = llm
+    module.task = lambda **kwargs: lambda func: FakeTask(func)
+    return module
+
+
+def test_generated_task_compiles_and_runs(tmp_path, monkeypatch, capsys):
+    output = build_task(DATA / "mini_gold.jsonl", DATA / "mini_items.jsonl", tmp_path / "task.py")
+    py_compile.compile(str(output), doraise=True)
+    code = output.read_text()
+    assert code.count("# %%") >= 4
+    assert "gone_for_good.run(kbench.llm)" in code
+    assert "if __name__ == \"__main__\"" not in code
+    gold = {g["item_id"]: g for g in map(json.loads, (DATA / "mini_gold.jsonl").read_text().splitlines())}
+    items = list(map(json.loads, (DATA / "mini_items.jsonl").read_text().splitlines()))
+    replies = {i["prompt"]: json.dumps({key: gold[i["item_id"]][key]
+                                        for key in ("lost", "recoverable", "permanent_loss")}) for i in items}
+    for expected, responses in ((1.0, replies), (0.0, {i["prompt"]: "garbage" for i in items})):
+        llm = StubLLM(responses)
+        monkeypatch.setitem(sys.modules, "kaggle_benchmarks", fake_sdk(llm))
+        ns = {"__name__": "generated_task"}
+        exec(compile(code, str(output), "exec"), ns)
+        assert ns["gone_for_good"].result == expected
+        assert len(llm.calls) == 6
+        assert all(call["temperature"] == 0 and
+                   call["extra_api_params"] == {"max_tokens": 1024} for call in llm.calls)
+        lines = capsys.readouterr().out.splitlines()
+        assert len([line for line in lines if line.startswith("GFG_ITEM ")]) == 6
+        assert len([line for line in lines if line.startswith("GFG_AGGREGATE ")]) == 1
+
+
+def test_real_sdk_import_and_mock_availability():
+    import kaggle_benchmarks as kbench
+    from kaggle_benchmarks import tasks
+    assert callable(kbench.task)
+    assert "store_task" in tasks.task.__code__.co_varnames
+    # Installed package has no built-in offline mock LLM with a prompt-only constructor.

diff --git a/scoring.py b/scoring.py
new file mode 100644
index 0000000000000000000000000000000000000000..a01da05493672552cdb7988e75b414109d75389d
--- /dev/null
+++ b/scoring.py
@@ -0,0 +1,243 @@
+"""Deterministic scoring for Gone for Good? (Python 3.9+, standard library)."""
+
+import argparse
+import json
+import random
+from collections import defaultdict
+from dataclasses import dataclass
+from pathlib import Path
+
+
+@dataclass
+class ParseResult:
+    ok: bool
+    error: str = ""
+    lost: tuple = ()
+    recoverable: tuple = ()
+    permanent_loss: bool = False
+
+
+def _objects(text):
+    """Yield balanced outer brace spans, respecting JSON string escapes."""
+    depth = 0
+    start = None
+    quoted = False
+    escaped = False
+    for index, char in enumerate(text):
+        if depth == 0:
+            if char == "{":
+                start, depth = index, 1
+            continue
+        if quoted:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = False
+        elif char == '"':
+            quoted = True
+        elif char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                yield text[start:index + 1]
+
+
+def parse_answer(text, inventory_ids):
+    candidates = list(_objects(text if isinstance(text, str) else ""))
+    if not candidates:
+        return ParseResult(False, "no_json" if "{" not in str(text) else "bad_json")
+    obj = None
+    for candidate in reversed(candidates):
+        try:
+            value = json.loads(candidate)
+        except (ValueError, TypeError):
+            continue
+        if isinstance(value, dict):
+            obj = value
+            break
+    if obj is None:
+        return ParseResult(False, "bad_json")
+    if not all(key in obj for key in ("lost", "recoverable", "permanent_loss")):
+        return ParseResult(False, "missing_key")
+    if (not isinstance(obj["lost"], list) or not isinstance(obj["recoverable"], list)
+            or type(obj["permanent_loss"]) is not bool
+            or any(not isinstance(i, str) for key in ("lost", "recoverable") for i in obj[key])):
+        return ParseResult(False, "bad_type")
+    lost = [i.upper() for i in obj["lost"]]
+    rec = [i.upper() for i in obj["recoverable"]]
+    allowed = {str(i).upper() for i in inventory_ids}
+    if any(i not in allowed for i in lost + rec):
+        return ParseResult(False, "unknown_id")
+    if len(set(lost)) != len(lost) or len(set(rec)) != len(rec):
+        return ParseResult(False, "duplicate_id")
+    if not set(rec) <= set(lost):
+        return ParseResult(False, "not_subset")
+    return ParseResult(True, "", tuple(sorted(lost)), tuple(sorted(rec)), obj["permanent_loss"])
+
+
+def score_item(text, gold):
+    gold_lost = {i.upper() for i in gold["lost"]}
+    gold_rec = {i.upper() for i in gold["recoverable"]}
+    parsed = parse_answer(text, gold["inventory_labels"])
+    pred_lost = set(parsed.lost) if parsed.ok else set()
+    pred_rec = set(parsed.recoverable) if parsed.ok else set()
+    gold_perm = bool(gold_lost - gold_rec)
+    pred_perm = bool(pred_lost - pred_rec)
+    return {
+        "item_id": gold["item_id"], "pair_id": gold["pair_id"],
+        "family": gold["family"], "hops": gold["hops"],
+        "format_ok": parsed.ok, "format_error": parsed.error,
+        "lost_exact": parsed.ok and pred_lost == gold_lost,
+        "rec_exact": parsed.ok and pred_rec == gold_rec,
+        "item_correct": parsed.ok and pred_lost == gold_lost and pred_rec == gold_rec,
+        "missed_losses": sorted(gold_lost - pred_lost),
+        "phantom_losses": sorted(pred_lost - gold_lost),
+        "false_assurance": sorted(pred_rec & (gold_lost - gold_rec)),
+        "false_alarm": sorted(gold_rec - pred_rec),
+        "gold_permanent": gold_perm, "pred_permanent": pred_perm,
+        "perm_flag_consistent": parsed.ok and parsed.permanent_loss == pred_perm,
+        "missed_permanent": gold_perm and not pred_perm,
+    }
+
+
+def _summary(rows):
+    n = len(rows)
+    pairs = defaultdict(list)
+    for row in rows:
+        pairs[row["pair_id"]].append(row)
+    pair_values = [all(r["item_correct"] for r in group) for group in pairs.values()]
+    permanent = [r for r in rows if r["gold_permanent"]]
+    return {
+        "n_items": n, "n_pairs": len(pairs),
+        "item_acc": sum(r["item_correct"] for r in rows) / n if n else 0.0,
+        "pair_acc": sum(pair_values) / len(pairs) if pairs else 0.0,
+        "lost_acc": sum(r["lost_exact"] for r in rows) / n if n else 0.0,
+        "rec_acc": sum(r["rec_exact"] for r in rows) / n if n else 0.0,
+        "format_failure_rate": sum(not r["format_ok"] for r in rows) / n if n else 0.0,
+        "perm_flag_inconsistency_rate": sum(not r["perm_flag_consistent"] for r in rows) / n if n else 0.0,
+        "false_assurance": {"items_with_any": sum(bool(r["false_assurance"]) for r in rows), "of": n},
+        "missed_permanent": {"k": sum(r["missed_permanent"] for r in rows), "of": len(permanent)},
+        "coupling_miss": sum(any(r["item_correct"] for r in group) and
+                             not all(r["item_correct"] for r in group) for group in pairs.values()),
+    }
+
+
+def aggregate(rows):
+    rows = list(rows)
+    result = _summary(rows)
+    for field, output in (("family", "by_family"), ("hops", "by_hops")):
+        groups = defaultdict(list)
+        for row in rows:
+            groups[row[field]].append(row)
+        result[output] = {key: {k: _summary(group)[k] for k in
+                         ("n_items", "n_pairs", "item_acc", "pair_acc")}
+                          for key, group in groups.items()}
+    return result
+
+
+def _percentile(values, fraction):
+    values = sorted(values)
+    if not values:
+        return 0.0
+    position = (len(values) - 1) * fraction
+    lower = int(position)
+    weight = position - lower
+    return values[lower] * (1 - weight) + values[min(lower + 1, len(values) - 1)] * weight
+
+
+def bootstrap(rows_by_model, n_boot=2000, seed=0):
+    """Paired, pair-cluster bootstrap. All models must cover identical pair IDs."""
+    grouped = {}
+    for model, rows in rows_by_model.items():
+        pairs = defaultdict(list)
+        for row in rows:
+            pairs[row["pair_id"]].append(row)
+        grouped[model] = pairs
+    models = list(grouped)
+    ids = sorted(grouped[models[0]]) if models else []
+    if any(set(grouped[m]) != set(ids) for m in models):
+        raise ValueError("models must contain the same pair IDs")
+    draws = {m: {"pair_acc": [], "item_acc": []} for m in models}
+    differences = {a + " - " + b: [] for i, a in enumerate(models) for b in models[i + 1:]}
+    rng = random.Random(seed)
+    for _ in range(n_boot):
+        sampled = [rng.choice(ids) for _ in ids]
+        scores = {}
+        for model in models:
+            groups = [grouped[model][pair] for pair in sampled]
+            flat = [row for group in groups for row in group]
+            scores[model] = (sum(all(r["item_correct"] for r in group) for group in groups) / len(groups)
+                             if groups else 0.0)
+            draws[model]["pair_acc"].append(scores[model])
+            draws[model]["item_acc"].append(sum(r["item_correct"] for r in flat) / len(flat) if flat else 0.0)
+        for i, a in enumerate(models):
+            for b in models[i + 1:]:
+                differences[a + " - " + b].append(scores[a] - scores[b])
+    return {"models": {m: {metric: [_percentile(v, .025), _percentile(v, .975)]
+                            for metric, v in metrics.items()} for m, metrics in draws.items()},
+            "pairwise_pair_acc_diff": {k: [_percentile(v, .025), _percentile(v, .975)]
+                                       for k, v in differences.items()}}
+
+
+def baseline_text(name, gold, item):
+    ids = [str(i).upper() for i in item["inventory_ids"]]
+    if name == "everything_lost":
+        lost, rec = ids, []
+    elif name == "nothing_lost":
+        lost, rec = [], []
+    elif name == "naive_reader":
+        lost = [str(i).upper() for i in gold["literal_targets"]]
+        rec = lost if "backup" in item["prompt"].lower() else []
+    else:
+        raise ValueError("unknown baseline: " + name)
+    return json.dumps({"lost": lost, "recoverable": rec,
+                       "permanent_loss": bool(set(lost) - set(rec))})
+
+
+def _read_jsonl(path):
+    with open(path, encoding="utf-8") as handle:
+        return [json.loads(line) for line in handle if line.strip()]
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--gold", default="data/gold.jsonl")
+    parser.add_argument("--items", default="data/items.jsonl")
+    parser.add_argument("--answers")
+    args = parser.parse_args()
+    gold = _read_jsonl(args.gold)
+    items = {row["item_id"]: row for row in _read_jsonl(args.items)}
+    answers = defaultdict(dict)
+    if args.answers:
+        for answer in _read_jsonl(args.answers):
+            answers[answer["model"]][answer["item_id"]] = answer["response"]
+    summaries = {}
+    names = list(answers) + ["everything_lost", "nothing_lost", "naive_reader"]
+    print("model item_acc pair_acc lost_acc rec_acc format_fail missed_permanent")
+    for name in names:
+        rows = []
+        for label in gold:
+            item = items[label["item_id"]]
+            response = (baseline_text(name, label, item) if name in
+                        ("everything_lost", "nothing_lost", "naive_reader") else
+                        answers[name].get(label["item_id"]))
+            row = score_item(response or "", label)
+            if response is None:
+                row["format_error"] = "missing"
+            rows.append(row)
+        summaries[name] = aggregate(rows)
+        s = summaries[name]
+        mp = s["missed_permanent"]
+        print("{} {:.3f} {:.3f} {:.3f} {:.3f} {:.3f} {}/{}".format(
+            name, s["item_acc"], s["pair_acc"], s["lost_acc"], s["rec_acc"],
+            s["format_failure_rate"], mp["k"], mp["of"]))
+    output = Path("results/scores.json")
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(summaries, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tasks/build_task.py b/tasks/build_task.py
new file mode 100644
index 0000000000000000000000000000000000000000..4625ba7b7e74b7d2762cd2831830019f7aa6f0bb
--- /dev/null
+++ b/tasks/build_task.py
@@ -0,0 +1,79 @@
+"""Build a self-contained Kaggle task from frozen JSONL inputs."""
+
+import argparse
+import ast
+import json
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def read_jsonl(path):
+    with open(path, encoding="utf-8") as handle:
+        return [json.loads(line) for line in handle if line.strip()]
+
+
+def build_task(gold_path, items_path, out_path, name="gone-for-good"):
+    display_name = "Gone for Good?" if name == "gone-for-good" else name
+    gold = {row["item_id"]: row for row in read_jsonl(gold_path)}
+    items = read_jsonl(items_path)
+    if set(gold) != {row["item_id"] for row in items}:
+        raise ValueError("gold and item IDs differ")
+    records = []
+    for item in items:
+        label = gold[item["item_id"]]
+        records.append({
+            "item": {key: item[key] for key in ("item_id", "pair_id", "variant", "family", "hops", "inventory_ids", "prompt")},
+            "gold": {key: label[key] for key in ("item_id", "pair_id", "family", "hops", "inventory_labels", "lost", "recoverable")},
+        })
+    source = (ROOT / "scoring.py").read_text(encoding="utf-8")
+    tree = ast.parse(source)
+    cli_line = next(node.lineno for node in tree.body if isinstance(node, ast.If)
+                    and isinstance(node.test, ast.Compare)
+                    and isinstance(node.test.left, ast.Name)
+                    and node.test.left.id == "__name__")
+    source = "".join(source.splitlines(keepends=True)[:cli_line - 1])
+    # The scoring CLI and its imports remain dormant inside the generated task.
+    embedded = json.dumps(records, ensure_ascii=False, sort_keys=True)
+    task = (
+        "# %%\n" + source + "\n# %%\nimport kaggle_benchmarks as kbench\n\n"
+        + "RECORDS = json.loads(" + repr(embedded) + ")\n\n"
+        + "# %%\n@kbench.task(name=\"gfg-item\", store_task=False)\n"
+        + "def gfg_item(llm, record) -> dict:\n"
+        + "    cap_key = 'max_output_tokens' if type(llm).__name__ == 'GoogleGenAI' else 'max_tokens'\n"
+        + "    response = llm.prompt(record['item']['prompt'], temperature=0, "
+          "extra_api_params={cap_key: 1024})\n"
+        + "    result = score_item(response, record['gold'])\n"
+        + "    result['raw_response'] = response\n"
+        + "    return result\n\n"
+        + "# %%\n@kbench.task(name=" + repr(display_name) + ")\n"
+        + "def gone_for_good(llm) -> float:\n"
+        + "    rows = []\n"
+        + "    for record in RECORDS:\n"
+        + "        row = gfg_item(llm, record)\n"
+        + "        print('GFG_ITEM ' + json.dumps(row, sort_keys=True))\n"
+        + "        rows.append(row)\n"
+        + "    summary = aggregate(rows)\n"
+        + "    print('GFG_AGGREGATE ' + json.dumps(summary, sort_keys=True))\n"
+        + "    return summary['pair_acc']\n\n"
+        + "gone_for_good.run(kbench.llm)\n"
+    )
+    path = Path(out_path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(task, encoding="utf-8")
+    return path
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--gold", default="data/gold.jsonl")
+    parser.add_argument("--items", default="data/items.jsonl")
+    parser.add_argument("--out", default="tasks/gone_for_good.py")
+    parser.add_argument("--name", default="gone-for-good")
+    args = parser.parse_args()
+    build_task(args.gold, args.items, args.out, args.name)
+
+
+if __name__ == "__main__":
+    main()
