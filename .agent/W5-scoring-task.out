+{"item_id":"P1B","pair_id":"P1","variant":"B","family":"fs","hops":1,"changed_fact":"link","literal_targets":["R1"],"inventory_labels":{"R1":"one","R2":"two","R3":"three","R4":"four","R5":"five","R6":"six"},"lost":["R1"],"recoverable":[],"permanent_loss":true}
+{"item_id":"P2A","pair_id":"P2","variant":"A","family":"db","hops":2,"changed_fact":"restrict","literal_targets":["R1"],"inventory_labels":{"R1":"one","R2":"two","R3":"three","R4":"four","R5":"five","R6":"six"},"lost":[],"recoverable":[],"permanent_loss":false}
