+{"item_id":"P2B","pair_id":"P2","variant":"B","family":"db","hops":2,"inventory_ids":["R1","R2","R3","R4","R5","R6"],"prompt":"Delete cascades to two rows."}
+{"item_id":"P3A","pair_id":"P3","variant":"A","family":"recovery","hops":3,"inventory_ids":["R1","R2","R3","R4","R5","R6"],"prompt":"Delete data; backup is current."}
