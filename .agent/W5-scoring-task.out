def normalize_name(name: str) -> str:
    """Replaces special characters such as spaces and slashes in a name."""
    name = name.replace(" ", "_").replace("/", "_").replace("\\", "_")
    return re.sub(r"[^a-zA-Z0-9_.-]", "", name)


