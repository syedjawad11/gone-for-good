\"\"\"R-9: errexit in the restore script can block a later valid archive.\"\"\"
from __future__ import annotations

from pathlib import Path

from fixtures.base import Artifact, Pair, Resource, Variant, file_fp, sh
from fixtures.recovery.r5 import archive, member_hashes

ALPHA = {f\"alpha/chunk-{n:02}.seg\": f\"alpha,{n:02},record,{n*11}\\n\" for n in range(1, 31)}
BETA = {f\"beta/chunk-{n:02}.seg\": f\"beta,{n:02},record,{n*13}\\n\" for n in range(1, 5)}
SELECTED = [\"alpha/chunk-03.seg\", \"alpha/chunk-18.seg\", \"alpha/chunk-29.seg\",
            \"beta/chunk-01.seg\", \"beta/chunk-04.seg\"]


def _build(root: Path, first_present: bool) -> None:
    for name, content in {**ALPHA, **BETA}.items():
        path = root / \"volumes\" / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
    archive(root / \"backups/alpha.tar\", {name: text.encode() for name, text in ALPHA.items()})
    archive(root / \"backups/beta.tar\", {name: text.encode() for name, text in BETA.items()})
    (root / \"config\").mkdir()
    (root / \"config/restore.env\").write_text(
        \"FIRST=backups/alpha.tar\\n\" if first_present else \"FIRST=backups/alpha-unavailable.tar\\n\"
    )
    (root / \"config/readme.txt\").write_text(\"backups/alpha-unavailable.tar is reserved for offsite transfer.\\n\")


def _artifacts(root: Path) -> list[Artifact]:
    live = \" \".join(\"volumes/\" + name for name in SELECTED)
    return [
        Artifact(\""'$ cat config/restore.env config/readme.txt", sh(root, "cat config/restore.env config/readme.txt").stdout),
        Artifact("$ tar -tf backups/alpha.tar", sh(root, "tar -tf backups/alpha.tar").stdout),
        Artifact("$ for m in selected archive members; do tar -xOf archive '"\\\""'$m'"\\\" | sha256sum; done\",
                 member_hashes(root, \"backups/alpha.tar\", SELECTED[:3]) +
                 member_hashes(root, \"backups/beta.tar\", SELECTED[3:])),
        Artifact(\""'$ sha256sum selected live chunks", sh(root, f"sha256sum {live}").stdout),
    ]


PAIR = Pair(
    pair_id="R-9", family="recovery",
    changed_fact="FIRST points to the existing alpha archive or to a missing reserved path.",
    operation="rm -rf volumes/alpha volumes/beta",
    restore_script='"'set -e\\nsource config/restore.env\\ntar -xf \""'$FIRST" -C volumes'"\\ntar -xf backups/beta.tar -C volumes',
    inventory=[
        Resource(\"R1\", \"contents of volumes/beta/chunk-01.seg\", file_fp(\"volumes/beta/chunk-01.seg\")),
        Resource(\"R2\", \"contents of backups/alpha.tar\", file_fp(\"backups/alpha.tar\")),
        Resource(\"R3\", \"contents of volumes/alpha/chunk-18.seg\", file_fp(\"volumes/alpha/chunk-18.seg\")),
        Resource(\"R4\", \"contents of config/restore.env\", file_fp(\"config/restore.env\")),
        Resource(\"R5\", \"contents of volumes/alpha/chunk-03.seg\", file_fp(\"volumes/alpha/chunk-03.seg\")),
        Resource(\"R6\", \"contents of backups/beta.tar\", file_fp(\"backups/beta.tar\")),
        Resource(\"R7\", \"contents of volumes/beta/chunk-04.seg\", file_fp(\"volumes/beta/chunk-04.seg\")),
        Resource(\"R8\", \"contents of volumes/alpha/chunk-29.seg\", file_fp(\"volumes/alpha/chunk-29.seg\")),
    ], literal_targets=[\"R1\", \"R3\", \"R5\", \"R7\", \"R8\"],
    variants=[Variant(\"A\", lambda root: _build(root, True), _artifacts, 3),
              Variant(\"B\", lambda root: _build(root, False), _artifacts, 3)],
    expected={\"A\": {\"lost\": [\"R1\", \"R3\", \"R5\", \"R7\", \"R8\"],
                    \"recoverable\": [\"R1\", \"R3\", \"R5\", \"R7\", \"R8\"]},
