"""R-1: the configured backup may live inside the directory being removed."""

from __future__ import annotations

import hashlib
import io
import tarfile
from pathlib import Path
from typing import Optional

from fixtures.base import Artifact, FIXED_EPOCH, Pair, Resource, Variant, file_fp, sh, tree_fp


SEGMENTS = {
    "pgdata/base/16384/orders.seg": "id,amount\n1,18\n2,27\n",
    "pgdata/base/16384/customers.seg": "id,tier\n1,standard\n2,plus\n",
    "pgdata/global/settings.seg": "key,value\nlocale,en\n",
}


def _archive(path: Path, members: dict[str, str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tarfile.open(path, "w") as archive:
        for name in sorted(members):
            data = members[name].encode()
            info = tarfile.TarInfo(name)
            info.size = len(data)
            info.mtime = FIXED_EPOCH
            info.uid = info.gid = 0
            info.uname = info.gname = ""
            info.mode = 0o644
            archive.addfile(info, io.BytesIO(data))


def _build(root: Path, embedded: bool) -> None:
    for name, value in SEGMENTS.items():
        target = root / "volumes" / name
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(value)
    (root / "volumes/pgdata/.snapshots").mkdir(parents=True)
    (root / "backups").mkdir()
    backup = "volumes/pgdata/.snapshots/pgdata.tar" if embedded else "backups/pgdata.tar"
    (root / "backup.conf").write_text(
        f"BACKUP_FILE={backup}\nRETENTION=7\n"
        "# The backup job stores exact copies of the segment files listed in the archive.\n"
    )
    _archive(root / backup, SEGMENTS)
    _archive(root / "backups/config.tar", {"config/retention.conf": "retention=7\n"})
    _archive(root / "volumes/pgdata/.snapshots/wal-old.tar", {"wal/0001": "checkpoint\n"})
    (root / "notes.txt").write_text("Volume inventory reviewed weekly.\n")


def _configured_backup_fp(root: Path) -> Optional[str]:
    config = (root / "backup.conf").read_text().splitlines()
    rel = next(line.split("=", 1)[1] for line in config if line.startswith("BACKUP_FILE="))
    target = root / rel
    return hashlib.sha256(target.read_bytes()).hexdigest() if target.is_file() else None


def _artifacts(root: Path) -> list[Artifact]:
    commands = [
        ("$ cat backup.conf", "cat backup.conf"),
        ("$ ls -laR volumes", "ls -laR volumes"),
        ("$ ls -la backups", "ls -la backups"),
        ('$ source ./backup.conf; tar -tf "$BACKUP_FILE"', 'source ./backup.conf; tar -tf "$BACKUP_FILE"'),
    ]
    return [Artifact(title, sh(root, command).stdout) for title, command in commands]


PAIR = Pair(
    pair_id="R-1",
    family="recovery",
    changed_fact="Configured archive is outside or inside volumes/pgdata.",
    operation="rm -rf volumes/pgdata",
    restore_script='source ./backup.conf\n[ -f "$BACKUP_FILE" ] && tar -xf "$BACKUP_FILE" -C volumes || true',
    inventory=[
        Resource("R1", "contents of volumes/pgdata/base/16384/orders.seg", file_fp("volumes/pgdata/base/16384/orders.seg")),
        Resource("R2", "contents of backup.conf", file_fp("backup.conf")),
        Resource("R3", "contents of volumes/pgdata/global/settings.seg", file_fp("volumes/pgdata/global/settings.seg")),
        Resource("R4", "contents of backups/", tree_fp("backups")),
        Resource("R5", "contents of volumes/pgdata/base/16384/customers.seg", file_fp("volumes/pgdata/base/16384/customers.seg")),
        Resource("R6", "contents of configured backup archive", _configured_backup_fp),
        Resource("R7", "contents of notes.txt", file_fp("notes.txt")),
    ],
    literal_targets=["R1", "R3", "R5", "R6"],
    variants=[
        Variant("A", lambda root: _build(root, False), _artifacts, 2),
        Variant("B", lambda root: _build(root, True), _artifacts, 2),
    ],
    expected={
        "A": {"lost": ["R1", "R3", "R5"], "recoverable": ["R1", "R3", "R5"]},
        "B": {"lost": ["R1", "R3", "R5", "R6"], "recoverable": []},
    },
)
"""R-2: an available archive may predate the last ten order rows."""

from __future__ import annotations

import io
import tarfile
from pathlib import Path

from fixtures.base import Artifact, FIXED_EPOCH, Pair, Resource, Variant, file_fp, sh, tree_fp


ORDERS = "".join(f"{number},sku-{number % 5},{number * 3}\n" for number in range(1, 51))
CUSTOMERS = "1,standard\n2,plus\n3,standard\n"
SETTINGS = "region,eu\ncurrency,eur\n"


def _build(root: Path, current: bool) -> None:
    data = root / "volumes/pgdata"
    data.mkdir(parents=True)
    for name, content in {"orders.seg": ORDERS, "customers.seg": CUSTOMERS, "settings.seg": SETTINGS}.items():
        (data / name).write_text(content)
    backups = root / "backups"
    backups.mkdir()
    archived = {
        "pgdata/orders.seg": ORDERS if current else "".join(ORDERS.splitlines(keepends=True)[:40]),
        "pgdata/customers.seg": CUSTOMERS,
        "pgdata/settings.seg": SETTINGS,
        "pgdata/old.seg": "2019,closed\n",
    }
    with tarfile.open(backups / "pgdata.tar", "w") as archive:
        for name in sorted(archived):
            content = archived[name].encode()
            info = tarfile.TarInfo(name)
            info.size = len(content)
            info.mtime = FIXED_EPOCH
            info.uid = info.gid = 0
            info.uname = info.gname = ""
            info.mode = 0o644
            archive.addfile(info, io.BytesIO(content))
    (root / "retention.conf").write_text("keep=7\n")


def _artifacts(root: Path) -> list[Artifact]:
    commands = [
        ("$ tar -tf backups/pgdata.tar 2>&1", "tar -tf backups/pgdata.tar 2>&1"),
        ('$ for f in $(tar -tf backups/pgdata.tar 2>/dev/null | grep -v "/$"); do printf "%s " "$f"; tar -xOf backups/pgdata.tar "$f" | sha256sum | cut -c1-64; done',
         'for f in $(tar -tf backups/pgdata.tar 2>/dev/null | grep -v "/$"); do printf "%s " "$f"; tar -xOf backups/pgdata.tar "$f" | sha256sum | cut -c1-64; done'),
        ("$ wc -l volumes/pgdata/*.seg", "wc -l volumes/pgdata/*.seg"),
        ("$ sha256sum volumes/pgdata/*.seg", "sha256sum volumes/pgdata/*.seg"),
        ("$ ls -la backups", "ls -la backups"),
    ]
    return [Artifact(title, sh(root, command).stdout) for title, command in commands]


PAIR = Pair(
    pair_id="R-2",
    family="recovery",
    changed_fact="Archived orders.seg has 50 or 40 lines.",
    operation="rm -rf volumes/pgdata",
    restore_script="[ -f backups/pgdata.tar ] && tar -xf backups/pgdata.tar -C volumes || true",
    inventory=[
        Resource("R1", "contents of backups/pgdata.tar", file_fp("backups/pgdata.tar")),
        Resource("R2", "contents of volumes/pgdata/orders.seg", file_fp("volumes/pgdata/orders.seg")),
        Resource("R3", "contents of retention.conf", file_fp("retention.conf")),
        Resource("R4", "contents of backups/", tree_fp("backups")),
        Resource("R5", "contents of volumes/pgdata/settings.seg", file_fp("volumes/pgdata/settings.seg")),
        Resource("R6", "contents of volumes/pgdata/customers.seg", file_fp("volumes/pgdata/customers.seg")),
    ],
    literal_targets=["R2", "R5", "R6"],
    variants=[
        Variant("A", lambda root: _build(root, True), _artifacts, 2),
        Variant("B", lambda root: _build(root, False), _artifacts, 2),
    ],
    expected={
        "A": {"lost": ["R2", "R5", "R6"], "recoverable": ["R2", "R5", "R6"]},
        "B": {"lost": ["R2", "R5", "R6"], "recoverable": ["R5", "R6"]},
    },
)
"""Execute recovery fixtures against their own before/after fingerprint contract."""

from __future__ import annotations

import importlib
import re
import subprocess
import tarfile

import pytest

from fixtures.base import FIXED_EPOCH, env_for


PAIRS = [importlib.import_module(f"fixtures.recovery.r{number}").PAIR for number in range(1, 5)]
FORBIDDEN = re.compile(r"\b(?:typo|bug|danger|careful)\b|old_|broken_|tmp_bad", re.IGNORECASE)


def _run(root, command):
    return subprocess.run(
        ["bash", "--noprofile", "--norc", "-c", command],
        cwd=root,
        env=env_for(root),
        capture_output=True,
        text=True,
    )


@pytest.mark.parametrize("pair", PAIRS, ids=lambda pair: pair.pair_id)
def test_variants_execute_and_match_expected(pair, tmp_path):
    titles = []
    for variant in pair.variants:
        root = tmp_path / variant.variant
        root.mkdir()
        variant.build(root)

        artifacts = variant.artifacts(root)
        titles.append([artifact.title for artifact in artifacts])
        assert artifacts
        for artifact in artifacts:
            if pair.pair_id == "R-3" and variant.variant == "B" and "for f in $(tar -tf" in artifact.title:
                assert artifact.body == ""
            elif pair.pair_id == "R-3" and variant.variant == "B" and artifact.title.startswith("$ tar -tf"):
                pass  # An empty tar prints nothing on bsdtar and an error on GNU tar.
            else:
                assert artifact.body.strip(), (pair.pair_id, variant.variant, artifact.title)
            assert not FORBIDDEN.search(artifact.title + "\n" + artifact.body)
            assert not re.search(r"\bvariant [AB]\b", artifact.title + "\n" + artifact.body, re.IGNORECASE)

        before = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
        assert all(value is not None for value in before.values()), (pair.pair_id, variant.variant, before)

        operation = _run(root, pair.operation)
        assert operation.returncode == 0, operation.stderr
        after = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
        lost = {id_ for id_, original in before.items() if after[id_] != original}

        restore = _run(root, pair.restore_script)
        assert restore.returncode == 0, restore.stderr
        restored = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
        recoverable = {id_ for id_ in lost if restored[id_] == before[id_]}

        expected = pair.expected[variant.variant]
        assert lost == set(expected["lost"]), (pair.pair_id, variant.variant, lost)
        assert recoverable == set(expected["recoverable"]), (pair.pair_id, variant.variant, recoverable)

    assert len(titles) == 2
    assert titles[0] == titles[1]


@pytest.mark.parametrize("pair", PAIRS[:3], ids=lambda pair: pair.pair_id)
def test_archive_bytes_and_headers_are_deterministic(pair, tmp_path):
    for variant in pair.variants:
        copies = []
        for index in range(2):
            root = tmp_path / f"{variant.variant}-{index}"
            root.mkdir()
            variant.build(root)
            if pair.pair_id == "R-1":
                config = (root / "backup.conf").read_text().splitlines()
                relative = next(line.split("=", 1)[1] for line in config if line.startswith("BACKUP_FILE="))
            else:
                relative = "backups/pgdata.tar"
            path = root / relative
            copies.append(path.read_bytes())
            if path.stat().st_size:
                with tarfile.open(path) as archive:
                    members = archive.getmembers()
                    assert [member.name for member in members] == sorted(member.name for member in members)
                    assert all(member.mtime == FIXED_EPOCH for member in members)
                    assert all(member.uid == member.gid == 0 for member in members)
                    assert all(member.uname == member.gname == "" for member in members)
        assert copies[0] == copies[1]


def test_recovery_inventory_lost_ids_are_permuted():
    lost_sets = [set(pair.expected["A"]["lost"]) for pair in PAIRS[:3]]
    assert len({frozenset(ids) for ids in lost_sets}) == 3


def test_r1_both_distractor_archives_exist(tmp_path):
    for variant in PAIRS[0].variants:
        root = tmp_path / variant.variant
        root.mkdir()
        variant.build(root)
        assert (root / "backups/config.tar").is_file()
        assert (root / "volumes/pgdata/.snapshots/wal-old.tar").is_file()


@pytest.mark.parametrize("pair", PAIRS[1:3], ids=lambda pair: pair.pair_id)
def test_archive_hash_evidence_is_from_tar(pair, tmp_path):
    for variant in pair.variants:
        root = tmp_path / variant.variant
        root.mkdir()
        variant.build(root)
        artifacts = {artifact.title: artifact.body for artifact in variant.artifacts(root)}
        member_title = next(title for title in artifacts if title.startswith("$ for f in $(tar -tf"))
        member_hashes = {line.split()[0]: line.split()[1] for line in artifacts[member_title].splitlines()}
        live_title = "$ sha256sum volumes/pgdata/*.seg"
        live_hashes = {line.split()[1].replace("volumes/", ""): line.split()[0]
                       for line in artifacts[live_title].splitlines()}
        if pair.pair_id == "R-3" and variant.variant == "B":
            assert member_hashes == {}
        else:
            for name, digest in member_hashes.items():
                if name in live_hashes:
                    assert (digest == live_hashes[name]) == (
                        pair.pair_id == "R-3" or variant.variant == "A" or name != "pgdata/orders.seg"
                    )


def test_r4_shows_both_schemas(tmp_path):
    for variant in PAIRS[3].variants:
        root = tmp_path / variant.variant
        root.mkdir()
        variant.build(root)
        artifacts = {artifact.title: artifact.body for artifact in variant.artifacts(root)}
        for database in ("primary", "replica"):
            assert "CREATE TABLE accounts" in artifacts[f"$ sqlite3 {database}.db .schema"]

