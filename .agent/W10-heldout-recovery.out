        Resource("R7", "contents of volumes/pgdata/part-05.seg", file_fp("volumes/pgdata/part-05.seg")),
        Resource("R8", "contents of backups/pgdata/part-21.seg", file_fp("backups/pgdata/part-21.seg")),
    ], literal_targets=[],
