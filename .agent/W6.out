+    """Hash typed, length-prefixed entries without following symlinked directories."""
     def fp(root: Path) -> Optional[str]:
         base = root / rel
         if not base.is_dir() or base.is_symlink():
             return None
         h = hashlib.sha256()
-        n = 0
+        entries = []
         for dirpath, dirnames, filenames in os.walk(base):
