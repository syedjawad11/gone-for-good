+def test_adapter_dispatch_and_unknown(tmp_path, monkeypatch):
+    output = build_task(DATA / "mini_gold.jsonl", DATA / "mini_items.jsonl", tmp_path / "task.py", max_tokens=512)
+    code = output.read_text()
