"""Shared contract for every fixture. Workers code against this file; do not change it.

A fixture module (fixtures/<family>/<pair>.py, e.g. fixtures/fs/fs1.py) exposes:

    PAIR = Pair(...)          # one matched pair (2 or 3 variants)

The harness (harness/run.py) does, per variant, in a fresh temp dir `root`:
    variant.build(root)                    # create files / git repo / sqlite db
    set_fixed_mtimes(root)                 # harness does this, fixtures don't
    artifacts = variant.artifacts(root)    # rendered from the BUILT env (real ls/cat/schema output)
    before = fingerprints(root)
    result = run_operation(root, variant.operation, variant.op_kind)
    after = fingerprints(root)             # lost = fingerprint changed or became None
    run(root, pair.restore_script)         # the exact script shown to the model
    restored = fingerprints(root)          # recoverable = lost and restored == before

Gold therefore means: "lost by this command" and "brought back exactly by THIS restore script".
It does not claim that no other recovery method exists; the prompt says so.

Resource identity (pick the fingerprint that matches the label, and say it in the label):
- file_fp:   the bytes readable at a path (follows symlinks). Label: "contents of reports/q3.csv".
- link_fp:   a symlink object itself (its target text), never its target. Label: "symlink backup/q3.csv".
- tree_fp:   a directory's contents. Label: "contents of uploads/archive/".
- sqlite_fp: specific PRE-EXISTING rows selected by key, ORDER BY primary key. Label:
             "orders rows 101-104 (customer 7)". Never a whole table: inserts elsewhere (archive
             triggers, audit rows) must not count as a loss. Only pre-existing state is inventoried.

Rules:
- `operation` is the exact text shown to the model and the exact text executed.
- Resource IDs and labels must be identical across the variants of a pair (same inventory).
  Only the environment differs, in the one fact named by `changed_fact`.
- Everything that decides the outcome must appear in `artifacts`.
- Nothing may depend on wall-clock time, randomness, inode numbers, $USER or the host.
- Synthetic content only.
- Surface tells: both variants show the same artifact titles in the same order, with bodies of
  similar length. A "scary" token that marks the bad variant (symlink, NULL, .gitignore, trigger,
  snapshot, checksum, AUTO_SYNC, ...) must also appear harmlessly in the other variant.
- Shell ops run with a clean env (`env -i`-style), no startup files, default shopt (no dotglob,
  nullglob, failglob, nounset unless the shown script sets them).
"""
from __future__ import annotations

import hashlib
import os
import sqlite3
import subprocess
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable, List, Optional

FIXED_EPOCH = 1767225600  # 2026-01-01T00:00:00Z, used for every mtime and git date

# Environment for every subprocess the fixtures and harness run. No host leakage.
BASE_ENV = {
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "LC_ALL": "C",
    "LANG": "C",
    "TZ": "UTC",
    "GIT_AUTHOR_NAME": "Dev Example",
    "GIT_AUTHOR_EMAIL": "dev@example.invalid",
    "GIT_COMMITTER_NAME": "Dev Example",
    "GIT_COMMITTER_EMAIL": "dev@example.invalid",
    "GIT_AUTHOR_DATE": "2026-01-01T00:00:00Z",
    "GIT_COMMITTER_DATE": "2026-01-01T00:00:00Z",
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_OPTIONAL_LOCKS": "0",  # `git status` in artifacts must not rewrite .git/index (mtime leak)
}


def home_for(root: Path) -> Path:
    """HOME lives next to root (not inside it), so it never shows up in listings or globs."""
    home = root.parent / (root.name + ".home")
    home.mkdir(exist_ok=True)
    return home


def env_for(root: Path) -> dict:
    """Subprocess env with HOME pinned beside the sandbox root."""
    env = dict(BASE_ENV)
    env["HOME"] = str(home_for(root))
    env["GIT_CONFIG_GLOBAL"] = str(home_for(root) / ".gitconfig")
    return env


def sh(root: Path, script: str, check: bool = True) -> subprocess.CompletedProcess:
    """Run a bash script with cwd=root and the pinned env. Used by build/restore/artifacts."""
    return subprocess.run(
        ["bash", "-c", script], cwd=str(root), env=env_for(root),
        capture_output=True, text=True, check=check,
    )


# ---------------------------------------------------------------- fingerprints

def file_fp(rel: str) -> Callable[[Path], Optional[str]]:
    """Content hash of one regular file (follows symlinks). None if missing/dangling/not a file."""
    def fp(root: Path) -> Optional[str]:
        p = root / rel
        if not p.is_file():
            return None
        return hashlib.sha256(p.read_bytes()).hexdigest()
    return fp


def link_fp(rel: str) -> Callable[[Path], Optional[str]]:
    """The symlink object at `rel` (its target text). None if absent or not a symlink."""
    def fp(root: Path) -> Optional[str]:
        p = root / rel
        if not p.is_symlink():
            return None
        return "link:" + os.readlink(p)
    return fp


def tree_fp(rel: str) -> Callable[[Path], Optional[str]]:
    """Hash of a directory tree: relative paths + file contents (does not follow symlinked dirs).
    None if the directory is missing or empty."""
    def fp(root: Path) -> Optional[str]:
        base = root / rel
        if not base.is_dir() or base.is_symlink():
            return None
        h = hashlib.sha256()
        n = 0
        for dirpath, dirnames, filenames in os.walk(base):
            dirnames.sort()
            for name in sorted(filenames):
                p = Path(dirpath) / name
                h.update(str(p.relative_to(base)).encode() + b"\0")
                h.update(os.readlink(p).encode() if p.is_symlink() else p.read_bytes())
                n += 1
        return h.hexdigest() if n else None
    return fp


def sqlite_fp(db_rel: str, query: str) -> Callable[[Path], Optional[str]]:
    """Hash of the rows returned by `query` (ordered by the query itself). None if the db or
    table is missing or the query returns no rows."""
    def fp(root: Path) -> Optional[str]:
        p = root / db_rel
        if not p.is_file():
            return None
        con = sqlite3.connect(str(p))
        try:
            rows = con.execute(query).fetchall()
        except sqlite3.Error:
            return None
        finally:
            con.close()
        if not rows:
            return None
        return hashlib.sha256(repr(rows).encode()).hexdigest()
    return fp


# ---------------------------------------------------------------- data shapes

@dataclass(frozen=True)
class Resource:
    id: str      # "R1", "R2", ... unique within the pair
    label: str   # what the model sees, e.g. "file data/customers.csv" or "orders rows for customer 7"
    fingerprint: Callable[[Path], Optional[str]]


@dataclass(frozen=True)
class Artifact:
    title: str   # e.g. "$ ls -la" or "config/cleanup.env" or "sqlite3 app.db .schema"
    body: str    # exact text; produced from the built environment, not hand-typed


@dataclass
class Variant:
    variant: str                                  # "A", "B", optionally "C" (never shown to the model)
    build: Callable[[Path], None]                 # create the environment under root
    artifacts: Callable[[Path], List[Artifact]]   # render what the model sees
    hops: int                                     # artifacts that must be combined (1..3)


@dataclass
class Pair:
    pair_id: str                 # "FS-1"
    family: str                  # "fs" | "db" | "recovery"
    changed_fact: str            # one line, for analysis only (never shown to the model)
    operation: str               # exact bash shown to the model and run as `bash -c` with cwd=root.
                                 # SQL ops: sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; ...; COMMIT;"
                                 # (-bail stops at the first error; the open transaction is rolled back
                                 # when sqlite3 exits). Wrapper scripts are fine if built into root and
                                 # their source is shown as an artifact.
    restore_script: str          # exact bash shown to the model and executed after the operation.
                                 # May only use what survived; must not fail loudly when a source is
                                 # missing (use `|| true` / guards), so restore errors never decide gold.
    inventory: List[Resource]
    literal_targets: List[str]   # IDs the command names literally (for the frozen naive-reader baseline),
                                 # e.g. `rm reports/q3.csv` -> the resource for reports/q3.csv.
    variants: List[Variant] = field(default_factory=list)
    expected: dict = field(default_factory=dict)  # {"A": {"lost": [...], "recoverable": [...]}, ...}
    # `expected` is the author's hypothesis. The harness reports any mismatch with the executed
    # result; executed results are the gold, never this dict.
"""Deterministic scoring for Gone for Good? (Python 3.9+, standard library)."""

import argparse
import json
import random
from collections import defaultdict
from dataclasses import dataclass
from pathlib import Path


@dataclass
class ParseResult:
    ok: bool
    error: str = ""
    lost: tuple = ()
    recoverable: tuple = ()
    permanent_loss: bool = False


def _objects(text):
    """Yield balanced outer brace spans, respecting JSON string escapes."""
    depth = 0
    start = None
    quoted = False
    escaped = False
    for index, char in enumerate(text):
        if depth == 0:
            if char == "{":
                start, depth = index, 1
            continue
        if quoted:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                quoted = False
        elif char == '"':
            quoted = True
        elif char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                yield text[start:index + 1]


def parse_answer(text, inventory_ids):
    candidates = list(_objects(text if isinstance(text, str) else ""))
    if not candidates:
        return ParseResult(False, "no_json" if "{" not in str(text) else "bad_json")
    obj = None
    for candidate in reversed(candidates):
        try:
            value = json.loads(candidate)
        except (ValueError, TypeError):
            continue
        if isinstance(value, dict):
            obj = value
            break
    if obj is None:
        return ParseResult(False, "bad_json")
    if not all(key in obj for key in ("lost", "recoverable", "permanent_loss")):
        return ParseResult(False, "missing_key")
    if (not isinstance(obj["lost"], list) or not isinstance(obj["recoverable"], list)
            or type(obj["permanent_loss"]) is not bool
            or any(not isinstance(i, str) for key in ("lost", "recoverable") for i in obj[key])):
        return ParseResult(False, "bad_type")
    lost = [i.upper() for i in obj["lost"]]
    rec = [i.upper() for i in obj["recoverable"]]
    allowed = {str(i).upper() for i in inventory_ids}
    if any(i not in allowed for i in lost + rec):
        return ParseResult(False, "unknown_id")
    if len(set(lost)) != len(lost) or len(set(rec)) != len(rec):
        return ParseResult(False, "duplicate_id")
    if not set(rec) <= set(lost):
        return ParseResult(False, "not_subset")
    return ParseResult(True, "", tuple(sorted(lost)), tuple(sorted(rec)), obj["permanent_loss"])


def score_item(text, gold):
    gold_lost = {i.upper() for i in gold["lost"]}
    gold_rec = {i.upper() for i in gold["recoverable"]}
    parsed = parse_answer(text, gold["inventory_labels"])
    pred_lost = set(parsed.lost) if parsed.ok else set()
    pred_rec = set(parsed.recoverable) if parsed.ok else set()
    gold_perm = bool(gold_lost - gold_rec)
    pred_perm = bool(pred_lost - pred_rec)
    return {
        "item_id": gold["item_id"], "pair_id": gold["pair_id"],
        "family": gold["family"], "hops": gold["hops"],
        "format_ok": parsed.ok, "format_error": parsed.error,
        "lost_exact": parsed.ok and pred_lost == gold_lost,
        "rec_exact": parsed.ok and pred_rec == gold_rec,
        "item_correct": parsed.ok and pred_lost == gold_lost and pred_rec == gold_rec,
        "missed_losses": sorted(gold_lost - pred_lost),
        "phantom_losses": sorted(pred_lost - gold_lost),
        "false_assurance": sorted(pred_rec & (gold_lost - gold_rec)),
        "false_alarm": sorted(gold_rec - pred_rec),
        "gold_permanent": gold_perm, "pred_permanent": pred_perm,
        "perm_flag_consistent": parsed.ok and parsed.permanent_loss == pred_perm,
        "missed_permanent": gold_perm and not pred_perm,
    }


def _summary(rows):
    n = len(rows)
    pairs = defaultdict(list)
    for row in rows:
        pairs[row["pair_id"]].append(row)
    pair_values = [all(r["item_correct"] for r in group) for group in pairs.values()]
    permanent = [r for r in rows if r["gold_permanent"]]
    return {
        "n_items": n, "n_pairs": len(pairs),
        "item_acc": sum(r["item_correct"] for r in rows) / n if n else 0.0,
        "pair_acc": sum(pair_values) / len(pairs) if pairs else 0.0,
        "lost_acc": sum(r["lost_exact"] for r in rows) / n if n else 0.0,
        "rec_acc": sum(r["rec_exact"] for r in rows) / n if n else 0.0,
        "format_failure_rate": sum(not r["format_ok"] for r in rows) / n if n else 0.0,
        "perm_flag_inconsistency_rate": sum(not r["perm_flag_consistent"] for r in rows) / n if n else 0.0,
        "false_assurance": {"items_with_any": sum(bool(r["false_assurance"]) for r in rows), "of": n},
        "missed_permanent": {"k": sum(r["missed_permanent"] for r in rows), "of": len(permanent)},
        "coupling_miss": sum(any(r["item_correct"] for r in group) and
                             not all(r["item_correct"] for r in group) for group in pairs.values()),
    }


def aggregate(rows):
    rows = list(rows)
    result = _summary(rows)
    for field, output in (("family", "by_family"), ("hops", "by_hops")):
        groups = defaultdict(list)
        for row in rows:
            groups[row[field]].append(row)
        result[output] = {key: {k: _summary(group)[k] for k in
                         ("n_items", "n_pairs", "item_acc", "pair_acc")}
                          for key, group in groups.items()}
    return result


def _percentile(values, fraction):
    values = sorted(values)
    if not values:
        return 0.0
    position = (len(values) - 1) * fraction
    lower = int(position)
    weight = position - lower
    return values[lower] * (1 - weight) + values[min(lower + 1, len(values) - 1)] * weight


def bootstrap(rows_by_model, n_boot=2000, seed=0):
    """Paired, pair-cluster bootstrap. All models must cover identical pair IDs."""
    grouped = {}
    for model, rows in rows_by_model.items():
        pairs = defaultdict(list)
        for row in rows:
            pairs[row["pair_id"]].append(row)
        grouped[model] = pairs
    models = list(grouped)
    ids = sorted(grouped[models[0]]) if models else []
    if any(set(grouped[m]) != set(ids) for m in models):
        raise ValueError("models must contain the same pair IDs")
    draws = {m: {"pair_acc": [], "item_acc": []} for m in models}
    differences = {a + " - " + b: [] for i, a in enumerate(models) for b in models[i + 1:]}
    rng = random.Random(seed)
    for _ in range(n_boot):
        sampled = [rng.choice(ids) for _ in ids]
        scores = {}
        for model in models:
            groups = [grouped[model][pair] for pair in sampled]
            flat = [row for group in groups for row in group]
            scores[model] = (sum(all(r["item_correct"] for r in group) for group in groups) / len(groups)
                             if groups else 0.0)
            draws[model]["pair_acc"].append(scores[model])
            draws[model]["item_acc"].append(sum(r["item_correct"] for r in flat) / len(flat) if flat else 0.0)
        for i, a in enumerate(models):
            for b in models[i + 1:]:
                differences[a + " - " + b].append(scores[a] - scores[b])
    return {"models": {m: {metric: [_percentile(v, .025), _percentile(v, .975)]
                            for metric, v in metrics.items()} for m, metrics in draws.items()},
            "pairwise_pair_acc_diff": {k: [_percentile(v, .025), _percentile(v, .975)]
                                       for k, v in differences.items()}}


def baseline_text(name, gold, item):
    ids = [str(i).upper() for i in item["inventory_ids"]]
    if name == "everything_lost":
        lost, rec = ids, []
    elif name == "nothing_lost":
        lost, rec = [], []
    elif name == "naive_reader":
        lost = [str(i).upper() for i in gold["literal_targets"]]
        rec = lost if "backup" in item["prompt"].lower() else []
    else:
        raise ValueError("unknown baseline: " + name)
    return json.dumps({"lost": lost, "recoverable": rec,
                       "permanent_loss": bool(set(lost) - set(rec))})


def _read_jsonl(path):
    with open(path, encoding="utf-8") as handle:
        return [json.loads(line) for line in handle if line.strip()]


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--gold", default="data/gold.jsonl")
    parser.add_argument("--items", default="data/items.jsonl")
    parser.add_argument("--answers")
    args = parser.parse_args()
    gold = _read_jsonl(args.gold)
    items = {row["item_id"]: row for row in _read_jsonl(args.items)}
    answers = defaultdict(dict)
    if args.answers:
        for answer in _read_jsonl(args.answers):
            answers[answer["model"]][answer["item_id"]] = answer["response"]
    summaries = {}
    names = list(answers) + ["everything_lost", "nothing_lost", "naive_reader"]
    print("model item_acc pair_acc lost_acc rec_acc format_fail missed_permanent")
    for name in names:
        rows = []
        for label in gold:
            item = items[label["item_id"]]
            response = (baseline_text(name, label, item) if name in
                        ("everything_lost", "nothing_lost", "naive_reader") else
                        answers[name].get(label["item_id"]))
            row = score_item(response or "", label)
            if response is None:
                row["format_error"] = "missing"
            rows.append(row)
        summaries[name] = aggregate(rows)
        s = summaries[name]
        mp = s["missed_permanent"]
        print("{} {:.3f} {:.3f} {:.3f} {:.3f} {:.3f} {}/{}".format(
            name, s["item_acc"], s["pair_acc"], s["lost_acc"], s["rec_acc"],
            s["format_failure_rate"], mp["k"], mp["of"]))
    output = Path("results/scores.json")
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(summaries, indent=2, sort_keys=True) + "\n", encoding="utf-8")


if __name__ == "__main__":
    main()
"""Build a self-contained Kaggle task from frozen JSONL inputs."""

import argparse
import ast
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]


def read_jsonl(path):
    with open(path, encoding="utf-8") as handle:
        return [json.loads(line) for line in handle if line.strip()]


def build_task(gold_path, items_path, out_path, name="gone-for-good"):
    display_name = name
    gold = {row["item_id"]: row for row in read_jsonl(gold_path)}
    items = read_jsonl(items_path)
    if set(gold) != {row["item_id"] for row in items}:
        raise ValueError("gold and item IDs differ")
    records = []
    for item in items:
        label = gold[item["item_id"]]
        records.append({
            "item": {"prompt": item["prompt"]},
            "gold": {key: label[key] for key in ("item_id", "pair_id", "family", "hops", "inventory_labels", "lost", "recoverable")},
        })
    source = (ROOT / "scoring.py").read_text(encoding="utf-8")
    tree = ast.parse(source)
    cli_line = next(node.lineno for node in tree.body if isinstance(node, ast.If)
                    and isinstance(node.test, ast.Compare)
                    and isinstance(node.test.left, ast.Name)
                    and node.test.left.id == "__name__")
    source = "".join(source.splitlines(keepends=True)[:cli_line - 1])
    # The scoring CLI and its imports remain dormant inside the generated task.
    embedded = json.dumps(records, ensure_ascii=False, sort_keys=True)
    task = (
        "# %%\n" + source + "\n# %%\nimport kaggle_benchmarks as kbench\n\n"
        + "RECORDS = json.loads(" + repr(embedded) + ")\n\n"
        + "# %%\n@kbench.task(name=\"gfg-item\", store_task=False)\n"
        + "def gfg_item(llm, record) -> dict:\n"
        + "    cap_key = 'max_output_tokens' if type(llm).__name__ == 'GoogleGenAI' else 'max_tokens'\n"
        + "    response = llm.prompt(record['item']['prompt'], temperature=0, "
          "extra_api_params={cap_key: 1024})\n"
        + "    result = score_item(response, record['gold'])\n"
        + "    result['raw_response'] = response\n"
        + "    return result\n\n"
        + "# %%\n@kbench.task(name=" + repr(display_name) + ")\n"
        + "def gone_for_good(llm) -> float:\n"
        + "    rows = []\n"
        + "    for record in RECORDS:\n"
        + "        row = gfg_item(llm, record)\n"
        + "        print('GFG_ITEM ' + json.dumps(row, sort_keys=True))\n"
        + "        rows.append(row)\n"
        + "    summary = aggregate(rows)\n"
        + "    print('GFG_AGGREGATE ' + json.dumps(summary, sort_keys=True))\n"
        + "    return summary['pair_acc']\n\n"
        + "gone_for_good.run(kbench.llm)\n"
    )
    path = Path(out_path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(task, encoding="utf-8")
    return path


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--gold", default="data/gold.jsonl")
    parser.add_argument("--items", default="data/items.jsonl")
    parser.add_argument("--out", default="tasks/gone_for_good.py")
    parser.add_argument("--name", default="gone-for-good")
    args = parser.parse_args()
    build_task(args.gold, args.items, args.out, args.name)


if __name__ == "__main__":
    main()

