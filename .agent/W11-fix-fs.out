+    if pair.pair_id == 'FS-10':
+        assert directory_counts[0] == directory_counts[1]
     changed_lines = sum(line.startswith(('+ ', '- ')) for line in difflib.ndiff(*bodies))
     assert math.ceil(changed_lines / 2) <= 8
 
