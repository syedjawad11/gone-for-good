+                assert stage_listing.splitlines() == ['stage', 'stage/notes.txt']
         for artifact in artifacts:
             assert not FORBIDDEN.search(artifact.title + '\n' + artifact.body)
         before = {r.id: r.fingerprint(root) for r in pair.inventory}
