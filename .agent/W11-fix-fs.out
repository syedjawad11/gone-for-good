/bin/zsh -lc ".venv/bin/python - <<'PY'
import difflib, math, tempfile
from pathlib import Path
from fixtures.fs import fs5,fs6,fs7,fs8,fs9,fs10
from harness.render import render_prompt
versions={'bash':'bash 5.2','coreutils':'coreutils 9.1','git':'git 2.39','sqlite':'3.40'}
for pair in (fs5.PAIR,fs6.PAIR,fs7.PAIR,fs8.PAIR,fs9.PAIR,fs10.PAIR):
    with tempfile.TemporaryDirectory() as d:
        roots=[Path(d)/v.variant for v in pair.variants]
        for r,v in zip(roots,pair.variants): r.mkdir(); v.build(r)
        arts=[v.artifacts(r) for r,v in zip(roots,pair.variants)]
        bodies=['\\n'.join(a.body for a in aa).splitlines() for aa in arts]
        changed=sum(s.startswith(('+ ','- ')) for s in difflib.ndiff(*bodies))
        prompts=[render_prompt(pair,a,versions) for a in arts]
        print(pair.pair_id, 'chars',*[len(p) for p in prompts], 'ratio',round(max(map(len,prompts))/min(map(len,prompts)),4),'diff',math.ceil(changed/2),'artifact chars',*[sum(len(a.title)+len(a.body) for a in aa) for aa in arts], 'hops',*[v.hops for v in pair.variants])
        if pair.pair_id in ('FS-7','FS-10'):
            for s in difflib.ndiff(*bodies):
                if s.startswith(('+ ','- ')): print(' ',s[:180])
