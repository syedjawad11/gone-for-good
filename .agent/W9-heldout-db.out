 print(pair.pair_id, 'lines', [len(x.body.splitlines()) for x in a], 'chars',sum(len(x.body) for x in a), 'diff',math.ceil(n/2), 'schema_diff', [s for s in difflib.ndiff(a[0].body.splitlines(),b[0].body.splitlines()) if s[:2] in ('- ','+ ')])
