+++ b/fixtures/db/db10.py
@@ -0,0 +1,93 @@
+"""An INSTEAD OF trigger changes whether an ignored restore can act."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, soft: bool) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        action = ("UPDATE tickets SET deleted=1 WHERE id=OLD.id;" if soft
+                  else "DELETE FROM tickets WHERE id=OLD.id;")
+        con.executescript(f"""
+CREATE TABLE tickets (
+    id INTEGER PRIMARY KEY,
+    subject TEXT NOT NULL,
+    owner TEXT NOT NULL,
+    deleted INTEGER NOT NULL DEFAULT 0,
+    priority INTEGER NOT NULL
+);
+CREATE TABLE tickets_snapshot (
+    id INTEGER PRIMARY KEY,
+    subject TEXT NOT NULL,
+    owner TEXT NOT NULL,
+    deleted INTEGER NOT NULL,
+    priority INTEGER NOT NULL
+);
+CREATE TABLE owners (
+    id INTEGER PRIMARY KEY,
+    handle TEXT NOT NULL,
+    team TEXT NOT NULL
+);
+CREATE VIEW ticket_queue AS
+    SELECT id, subject, owner, priority
+    FROM tickets WHERE deleted=0;
+CREATE TRIGGER queue_delete INSTEAD OF DELETE ON ticket_queue
+BEGIN
+    {action}
+END;
+CREATE INDEX ticket_owner ON tickets(owner);
+CREATE INDEX ticket_priority ON tickets(priority);
+""")
+        con.executemany("INSERT INTO tickets VALUES (?,?,?,?,?)", [
+            (i, f"case-{i}", "desk-a" if i % 2 else "desk-b", 0, i % 3 + 1)
+            for i in range(71, 79)
+        ])
+        con.execute("INSERT INTO tickets_snapshot SELECT * FROM tickets WHERE id=71")
+        con.executemany("INSERT INTO owners VALUES (?,?,?)", [(1, "desk-a", "ops"), (2, "desk-b", "ops")])
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM ticket_queue ORDER BY id; SELECT * FROM tickets ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM tickets_snapshot ORDER BY id; SELECT * FROM owners ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+def row(table, ids):
+    return sqlite_fp("app.db", f"SELECT * FROM {table} WHERE id IN ({ids}) ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="DB-10", family="db",
+    changed_fact="the view's delete trigger deletes base rows or sets deleted=1",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM ticket_queue WHERE id IN (71,74); COMMIT;"',
+    restore_script='sqlite3 app.db "PRAGMA foreign_keys=ON; INSERT OR IGNORE INTO tickets SELECT * FROM tickets_snapshot;" || true',
+    inventory=[
+        Resource("R1", "tickets row 72", row("tickets", "72")),
+        Resource("R2", "tickets row 73", row("tickets", "73")),
+        Resource("R3", "tickets row 75", row("tickets", "75")),
+        Resource("R4", "tickets row 76", row("tickets", "76")),
+        Resource("R5", "tickets row 77", row("tickets", "77")),
+        Resource("R6", "tickets row 71", row("tickets", "71")),
+        Resource("R7", "tickets_snapshot row 71", row("tickets_snapshot", "71")),
+        Resource("R8", "tickets row 78", row("tickets", "78")),
+        Resource("R9", "tickets row 74", row("tickets", "74")),
+    ],
+    literal_targets=["R6", "R9"],
+    variants=[
+        Variant("A", lambda root: build(root, False), artifacts, 3),
+        Variant("B", lambda root: build(root, True), artifacts, 3),
+    ],
+    expected={
+        "A": {"lost": ["R6", "R9"], "recoverable": ["R6"]},
+        "B": {"lost": ["R6", "R9"], "recoverable": []},
+    },
+)
diff --git a/fixtures/db/db5.py b/fixtures/db/db5.py
new file mode 100644
index 0000000000000000000000000000000000000000..36106c407754764171831be60b76a360bd8cb052
--- /dev/null
+++ b/fixtures/db/db5.py
@@ -0,0 +1,96 @@
+"""A queue column changes how an unqualified subquery name resolves."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, queue_column: str) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.executescript(f"""
+CREATE TABLE items (
+    id INTEGER PRIMARY KEY,
+    sku TEXT NOT NULL,
+    category TEXT NOT NULL,
+    qty INTEGER NOT NULL,
+    location TEXT NOT NULL
+);
+CREATE TABLE purge_queue (
+    {queue_column} INTEGER NOT NULL,
+    requested_by TEXT NOT NULL,
+    batch INTEGER NOT NULL
+);
+CREATE TABLE items_snapshot (
+    id INTEGER PRIMARY KEY,
+    sku TEXT NOT NULL,
+    category TEXT NOT NULL,
+    qty INTEGER NOT NULL,
+    location TEXT NOT NULL
+);
+CREATE TABLE storage_zones (
+    id INTEGER PRIMARY KEY,
+    label TEXT NOT NULL,
+    aisle TEXT NOT NULL,
+    capacity INTEGER NOT NULL
+);
+CREATE INDEX items_by_category ON items(category);
+CREATE INDEX items_by_location ON items(location);
+CREATE INDEX queue_by_batch ON purge_queue(batch);
+CREATE INDEX zones_by_aisle ON storage_zones(aisle);
+""")
+        con.executemany("INSERT INTO items VALUES (?,?,?,?,?)", [
+            (i, f"part-{i}", "paper" if i % 2 else "tool", i - 90, f"Z{i % 3}")
+            for i in range(101, 109)
+        ])
+        con.execute("INSERT INTO purge_queue VALUES (105,'scheduler',3)")
+        con.execute("INSERT INTO items_snapshot SELECT * FROM items WHERE id IN (102,106)")
+        con.executemany("INSERT INTO storage_zones VALUES (?,?,?,?)", [
+            (1, "north", "A", 50), (2, "south", "B", 40),
+        ])
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM items ORDER BY id; SELECT * FROM purge_queue;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM items_snapshot ORDER BY id; SELECT * FROM storage_zones ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+def row(table, ids):
+    return sqlite_fp("app.db", f"SELECT * FROM {table} WHERE id IN ({ids}) ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="DB-5", family="db",
+    changed_fact="purge_queue's first column is item_id or id",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM items WHERE id IN (SELECT id FROM purge_queue); COMMIT;"',
+    restore_script='sqlite3 app.db "PRAGMA foreign_keys=ON; INSERT OR IGNORE INTO items SELECT * FROM items_snapshot;" || true',
+    inventory=[
+        Resource("R1", "items row 103", row("items", "103")),
+        Resource("R2", "items row 106", row("items", "106")),
+        Resource("R3", "items row 101", row("items", "101")),
+        Resource("R4", "items row 105", row("items", "105")),
+        Resource("R5", "items row 108", row("items", "108")),
+        Resource("R6", "items row 102", row("items", "102")),
+        Resource("R7", "items row 107", row("items", "107")),
+        Resource("R8", "items row 104", row("items", "104")),
+        Resource("R9", "items_snapshot rows 102, 106", row("items_snapshot", "102,106")),
+        Resource("R10", "storage_zones row 1", row("storage_zones", "1")),
+    ],
+    literal_targets=["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8"],
+    variants=[
+        Variant("A", lambda root: build(root, "item_id"), artifacts, 3),
+        Variant("B", lambda root: build(root, "id"), artifacts, 3),
+    ],
+    expected={
+        "A": {"lost": ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8"], "recoverable": ["R2", "R6"]},
+        "B": {"lost": ["R4"], "recoverable": []},
+    },
+)
diff --git a/fixtures/db/db6.py b/fixtures/db/db6.py
new file mode 100644
index 0000000000000000000000000000000000000000..a06727effab9c1da6beeb5579184abc59fed7518
--- /dev/null
+++ b/fixtures/db/db6.py
@@ -0,0 +1,99 @@
+"""A declaration changes numeric-literal comparisons with ISO date strings."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, affinity: str) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.executescript(f"""
+CREATE TABLE events (
+    id INTEGER PRIMARY KEY,
+    day {affinity} NOT NULL,
+    channel TEXT NOT NULL,
+    payload TEXT NOT NULL,
+    source_id INTEGER NOT NULL
+);
+CREATE TABLE events_snapshot (
+    id INTEGER PRIMARY KEY,
+    day TEXT NOT NULL,
+    channel TEXT NOT NULL,
+    payload TEXT NOT NULL,
+    source_id INTEGER NOT NULL
+);
+CREATE TABLE sources (
+    id INTEGER PRIMARY KEY,
+    name TEXT NOT NULL,
+    region TEXT NOT NULL,
+    enabled INTEGER NOT NULL
+);
+CREATE TABLE batches (
+    id INTEGER PRIMARY KEY,
+    source_id INTEGER NOT NULL,
+    opened TEXT NOT NULL,
+    state TEXT NOT NULL
+);
+CREATE INDEX events_by_day ON events(day);
+CREATE INDEX events_by_source ON events(source_id);
+CREATE INDEX batches_by_state ON batches(state);
+""")
+        con.executemany("INSERT INTO events VALUES (?,?,?,?,?)", [
+            (201, "2024-12-31", "web", "open", 1),
+            (202, "2025-03-01", "api", "close", 2),
+            (203, "2025-06-10", "web", "update", 1),
+            (204, "2026-01-02", "api", "open", 2),
+            (205, "2025-12-11", "web", "close", 1),
+            (206, "2026-04-08", "api", "update", 2),
+            (207, "2024-11-09", "web", "open", 1),
+            (208, "2026-07-17", "api", "close", 2),
+        ])
+        con.execute("INSERT INTO events_snapshot SELECT * FROM events WHERE id IN (202,207)")
+        con.executemany("INSERT INTO sources VALUES (?,?,?,?)", [(1, "intake", "east", 1), (2, "relay", "west", 1)])
+        con.execute("INSERT INTO batches VALUES (8,1,'2025-02-01','closed')")
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM events ORDER BY id; SELECT * FROM sources ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM events_snapshot ORDER BY id; SELECT * FROM batches ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+def row(table, ids):
+    return sqlite_fp("app.db", f"SELECT * FROM {table} WHERE id IN ({ids}) ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="DB-6", family="db",
+    changed_fact="events.day is declared NUMERIC or TEXT",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM events WHERE day < 20250101; COMMIT;"',
+    restore_script='sqlite3 app.db "PRAGMA foreign_keys=ON; INSERT OR IGNORE INTO events SELECT * FROM events_snapshot;" || true',
+    inventory=[
+        Resource("R1", "events row 204", row("events", "204")),
+        Resource("R2", "events row 201", row("events", "201")),
+        Resource("R3", "events row 206", row("events", "206")),
+        Resource("R4", "events row 202", row("events", "202")),
+        Resource("R5", "events row 205", row("events", "205")),
+        Resource("R6", "events row 207", row("events", "207")),
+        Resource("R7", "events row 203", row("events", "203")),
+        Resource("R8", "events row 208", row("events", "208")),
+        Resource("R9", "events_snapshot rows 202, 207", row("events_snapshot", "202,207")),
+    ],
+    literal_targets=["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8"],
+    variants=[
+        Variant("A", lambda root: build(root, "NUMERIC"), artifacts, 3),
+        Variant("B", lambda root: build(root, "TEXT"), artifacts, 3),
+    ],
+    expected={
+        "A": {"lost": [], "recoverable": []},
+        "B": {"lost": ["R2", "R4", "R5", "R6", "R7"], "recoverable": ["R4", "R6"]},
+    },
+)
diff --git a/fixtures/db/db7.py b/fixtures/db/db7.py
new file mode 100644
index 0000000000000000000000000000000000000000..487b50aad7cd33c6c4e96d4943be4cd940c901cd
--- /dev/null
+++ b/fixtures/db/db7.py
@@ -0,0 +1,96 @@
+"""REPLACE may remove a second contact and cascade to its assignments."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, unique_column: str) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.execute("PRAGMA foreign_keys=ON")
+        con.executescript(f"""
+CREATE TABLE contacts (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    tag TEXT NOT NULL,
+    region TEXT NOT NULL,
+    joined TEXT NOT NULL
+);
+CREATE TABLE assignments (
+    id INTEGER PRIMARY KEY,
+    contact_id INTEGER NOT NULL REFERENCES contacts(id) ON DELETE CASCADE,
+    work_code TEXT NOT NULL,
+    state TEXT NOT NULL
+);
+CREATE TABLE contacts_snapshot (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    tag TEXT NOT NULL,
+    region TEXT NOT NULL,
+    joined TEXT NOT NULL
+);
+CREATE TABLE project_codes (
+    id INTEGER PRIMARY KEY,
+    code TEXT NOT NULL,
+    region TEXT NOT NULL
+);
+CREATE UNIQUE INDEX contact_key ON contacts({unique_column});
+CREATE INDEX assignment_contact ON assignments(contact_id);
+CREATE INDEX contact_region ON contacts(region);
+""")
+        con.executemany("INSERT INTO contacts VALUES (?,?,?,?,?)", [
+            (i, f"desk{i}@example.invalid", f"C{i}", "east" if i % 2 else "west", "2026-01-01")
+            for i in range(41, 49)
+        ])
+        con.executemany("INSERT INTO assignments VALUES (?,?,?,?)", [
+            (301, 45, "P1", "open"), (302, 45, "P2", "open"),
+            (303, 42, "P3", "closed"), (304, 47, "P4", "open"),
+        ])
+        con.execute("INSERT INTO contacts_snapshot SELECT * FROM contacts WHERE id=45")
+        con.execute("INSERT INTO project_codes VALUES (1,'P1','east')")
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM contacts ORDER BY id; SELECT * FROM contacts_snapshot ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM assignments ORDER BY id; SELECT * FROM project_codes ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+def row(table, ids):
+    return sqlite_fp("app.db", f"SELECT * FROM {table} WHERE id IN ({ids}) ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="DB-7", family="db",
+    changed_fact="contact_key is unique on tag or email",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; INSERT OR REPLACE INTO contacts VALUES (900, \'desk45@example.invalid\', \'C900\', \'west\', \'2026-07-01\'); COMMIT;"',
+    restore_script='sqlite3 app.db "PRAGMA foreign_keys=ON; DELETE FROM contacts WHERE id=900; INSERT OR IGNORE INTO contacts SELECT * FROM contacts_snapshot;" || true',
+    inventory=[
+        Resource("R1", "contacts row 41", row("contacts", "41")),
+        Resource("R2", "assignments row 303", row("assignments", "303")),
+        Resource("R3", "contacts row 45", row("contacts", "45")),
+        Resource("R4", "contacts row 47", row("contacts", "47")),
+        Resource("R5", "assignments rows 301, 302", row("assignments", "301,302")),
+        Resource("R6", "contacts row 42", row("contacts", "42")),
+        Resource("R7", "assignments row 304", row("assignments", "304")),
+        Resource("R8", "contacts_snapshot row 45", row("contacts_snapshot", "45")),
+        Resource("R9", "project_codes row 1", row("project_codes", "1")),
+    ],
+    literal_targets=["R3"],
+    variants=[
+        Variant("A", lambda root: build(root, "tag"), artifacts, 3),
+        Variant("B", lambda root: build(root, "email"), artifacts, 3),
+    ],
+    expected={
+        "A": {"lost": [], "recoverable": []},
+        "B": {"lost": ["R3", "R5"], "recoverable": ["R3"]},
+    },
+)
diff --git a/fixtures/db/db8.py b/fixtures/db/db8.py
new file mode 100644
index 0000000000000000000000000000000000000000..dbcc0d1ccf9753ae5687034fc440a0d6027bb52e
--- /dev/null
+++ b/fixtures/db/db8.py
@@ -0,0 +1,97 @@
+"""SET NULL and CASCADE both change children but restore differently."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, action: str) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.execute("PRAGMA foreign_keys=ON")
+        con.executescript(f"""
+CREATE TABLE folders (
+    id INTEGER PRIMARY KEY,
+    title TEXT NOT NULL,
+    owner TEXT NOT NULL,
+    zone TEXT NOT NULL
+);
+CREATE TABLE documents (
+    id INTEGER PRIMARY KEY,
+    folder_id INTEGER REFERENCES folders(id) ON DELETE {action},
+    title TEXT NOT NULL,
+    revision INTEGER NOT NULL,
+    checksum TEXT NOT NULL
+);
+CREATE TABLE folders_snapshot (
+    id INTEGER PRIMARY KEY,
+    title TEXT NOT NULL,
+    owner TEXT NOT NULL,
+    zone TEXT NOT NULL
+);
+CREATE TABLE documents_snapshot (
+    id INTEGER PRIMARY KEY,
+    folder_id INTEGER,
+    title TEXT NOT NULL,
+    revision INTEGER NOT NULL,
+    checksum TEXT NOT NULL
+);
+CREATE INDEX document_folder ON documents(folder_id);
+CREATE INDEX folder_zone ON folders(zone);
+""")
+        con.executemany("INSERT INTO folders VALUES (?,?,?,?)", [
+            (70, "intake", "desk-a", "north"), (71, "review", "desk-b", "south"),
+            (72, "export", "desk-c", "north"),
+        ])
+        con.executemany("INSERT INTO documents VALUES (?,?,?,?,?)", [
+            (401, 70, "invoice", 2, "c401"), (402, 70, "receipt", 1, "c402"),
+            (403, 70, "memo", 4, "c403"), (404, 71, "report", 2, "c404"),
+            (405, 72, "index", 1, "c405"), (406, None, "notice", 1, "c406"),
+        ])
+        con.execute("INSERT INTO folders_snapshot SELECT * FROM folders WHERE id=70")
+        con.execute("INSERT INTO documents_snapshot SELECT * FROM documents WHERE folder_id=70")
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM folders ORDER BY id; SELECT * FROM documents ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM folders_snapshot ORDER BY id; SELECT * FROM documents_snapshot ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+def row(table, ids):
+    return sqlite_fp("app.db", f"SELECT * FROM {table} WHERE id IN ({ids}) ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="DB-8", family="db",
+    changed_fact="documents.folder_id uses CASCADE or SET NULL on folder deletion",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM folders WHERE id=70; COMMIT;"',
+    restore_script='sqlite3 app.db "PRAGMA foreign_keys=ON; INSERT OR IGNORE INTO folders SELECT * FROM folders_snapshot; INSERT OR IGNORE INTO documents SELECT * FROM documents_snapshot;" || true',
+    inventory=[
+        Resource("R1", "documents row 404", row("documents", "404")),
+        Resource("R2", "folders row 71", row("folders", "71")),
+        Resource("R3", "documents row 406", row("documents", "406")),
+        Resource("R4", "documents rows 401, 402", row("documents", "401,402")),
+        Resource("R5", "folders row 70", row("folders", "70")),
+        Resource("R6", "documents row 405", row("documents", "405")),
+        Resource("R7", "documents row 403", row("documents", "403")),
+        Resource("R8", "folders_snapshot row 70", row("folders_snapshot", "70")),
+        Resource("R9", "documents_snapshot rows 401-403", row("documents_snapshot", "401,402,403")),
+    ],
+    literal_targets=["R5"],
+    variants=[
+        Variant("A", lambda root: build(root, "CASCADE"), artifacts, 3),
+        Variant("B", lambda root: build(root, "SET NULL"), artifacts, 3),
+    ],
+    expected={
+        "A": {"lost": ["R4", "R5", "R7"], "recoverable": ["R4", "R5", "R7"]},
+        "B": {"lost": ["R4", "R5", "R7"], "recoverable": ["R5"]},
+    },
+)
diff --git a/fixtures/db/db9.py b/fixtures/db/db9.py
new file mode 100644
index 0000000000000000000000000000000000000000..76a40ddd0553a1124fc8b3b81aa787ad73955ebe
--- /dev/null
+++ b/fixtures/db/db9.py
@@ -0,0 +1,109 @@
+"""A failed second statement exposes the wrapper's transaction boundary."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, transaction: bool) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.executescript("""
+CREATE TABLE logs (
+    id INTEGER PRIMARY KEY,
+    batch_id INTEGER NOT NULL,
+    created TEXT NOT NULL,
+    detail TEXT NOT NULL,
+    channel TEXT NOT NULL
+);
+CREATE TABLE logs_snapshot (
+    id INTEGER PRIMARY KEY,
+    batch_id INTEGER NOT NULL,
+    created TEXT NOT NULL,
+    detail TEXT NOT NULL,
+    channel TEXT NOT NULL
+);
+CREATE TABLE audit (
+    id INTEGER PRIMARY KEY,
+    action TEXT NOT NULL,
+    actor TEXT NOT NULL,
+    batch_id INTEGER NOT NULL
+);
+CREATE TABLE batches (
+    id INTEGER PRIMARY KEY,
+    status TEXT NOT NULL,
+    owner TEXT NOT NULL,
+    region TEXT NOT NULL
+);
+CREATE INDEX logs_batch ON logs(batch_id);
+CREATE INDEX logs_created ON logs(created);
+CREATE INDEX audit_batch ON audit(batch_id);
+""")
+        con.executemany("INSERT INTO logs VALUES (?,?,?,?,?)", [
+            (i, 7 if i in (501, 503, 505, 507) else 8, "2026-02-01", f"event-{i}", "worker")
+            for i in range(501, 509)
+        ])
+        con.execute("INSERT INTO logs_snapshot SELECT * FROM logs WHERE id IN (503,507)")
+        con.execute("INSERT INTO audit VALUES (1,'open','system',7)")
+        con.executemany("INSERT INTO batches VALUES (?,?,?,?)", [
+            (7, "closed", "desk-a", "east"), (8, "open", "desk-b", "west"),
+        ])
+        con.commit()
+    finally:
+        con.close()
+    lines = [
+        "#!/bin/sh", "set -eu", "sqlite3 -bail app.db \"", "PRAGMA foreign_keys=ON;",
+    ]
+    if transaction:
+        lines.append("BEGIN;")
+    lines.extend([
+        "DELETE FROM logs WHERE batch_id=7;",
+        "INSERT INTO audit(action,actor,batch_id) VALUES ('prune',NULL,7);",
+        "COMMIT;", "\"",
+    ])
+    script = root / "bin" / "run-prune"
+    script.parent.mkdir()
+    script.write_text("\n".join(lines) + "\n")
+    script.chmod(0o755)
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'cat bin/run-prune',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM logs ORDER BY id; SELECT * FROM logs_snapshot ORDER BY id; SELECT * FROM audit ORDER BY id; SELECT * FROM batches ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+def row(table, ids):
+    return sqlite_fp("app.db", f"SELECT * FROM {table} WHERE id IN ({ids}) ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="DB-9", family="db",
+    changed_fact="wrapper includes BEGIN before the DELETE or leaves statements autocommitted",
+    operation="./bin/run-prune",
+    restore_script='sqlite3 app.db "PRAGMA foreign_keys=ON; INSERT OR IGNORE INTO logs SELECT * FROM logs_snapshot;" || true',
+    inventory=[
+        Resource("R1", "logs row 501", row("logs", "501")),
+        Resource("R2", "logs row 502", row("logs", "502")),
+        Resource("R3", "logs row 503", row("logs", "503")),
+        Resource("R4", "audit row 1", row("audit", "1")),
+        Resource("R5", "logs row 505", row("logs", "505")),
+        Resource("R6", "logs row 504", row("logs", "504")),
+        Resource("R7", "logs row 507", row("logs", "507")),
+        Resource("R8", "batches row 7", row("batches", "7")),
+        Resource("R9", "logs_snapshot rows 503, 507", row("logs_snapshot", "503,507")),
+    ],
+    literal_targets=["R1", "R3", "R5", "R7"],
+    variants=[
+        Variant("A", lambda root: build(root, False), artifacts, 3),
+        Variant("B", lambda root: build(root, True), artifacts, 3),
+    ],
+    expected={
+        "A": {"lost": ["R1", "R3", "R5", "R7"], "recoverable": ["R3", "R7"]},
+        "B": {"lost": [], "recoverable": []},
+    },
+)
diff --git a/tests/test_fixtures_db_heldout.py b/tests/test_fixtures_db_heldout.py
new file mode 100644
index 0000000000000000000000000000000000000000..b2d9655cc8f6c5a647463b1299c050a63bcc6595
--- /dev/null
+++ b/tests/test_fixtures_db_heldout.py
@@ -0,0 +1,131 @@
+"""Execute every held-out SQLite operation and its authored restore script."""
+
+import difflib
+import math
+import re
+import sqlite3
+import subprocess
+
+import pytest
+
+from fixtures.base import env_for
+from fixtures.db import db5, db6, db7, db8, db9, db10
+
+
+PAIRS = [db5.PAIR, db6.PAIR, db7.PAIR, db8.PAIR, db9.PAIR, db10.PAIR]
+FORBIDDEN = re.compile(r"\b(?:variant|typo|bug|danger|careful|old_|broken_|tmp_bad)\b", re.I)
+
+
+def run(root, script):
+    return subprocess.run(
+        ["bash", "--noprofile", "--norc", "-c", script],
+        cwd=str(root), env=env_for(root), capture_output=True, text=True,
+    )
+
+
+def rows(root, table):
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        return con.execute(f'SELECT * FROM "{table}" ORDER BY rowid').fetchall()
+    finally:
+        con.close()
+
+
+@pytest.mark.parametrize("pair", PAIRS, ids=lambda p: p.pair_id)
+def test_pair_gold_and_surface(pair, tmp_path):
+    variants = {}
+    for variant in pair.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        con = sqlite3.connect(str(root / "app.db"))
+        try:
+            assert con.execute("PRAGMA journal_mode").fetchone()[0] == "delete"
+        finally:
+            con.close()
+        artifacts = variant.artifacts(root)
+        assert 3 <= len(artifacts) <= 5
+        assert 2 <= variant.hops <= len(artifacts)
+        assert artifacts[0].title == "$ sqlite3 app.db .schema"
+        assert all(a.body and not FORBIDDEN.search(a.title + a.body) for a in artifacts)
+        assert any(len(a.body.splitlines()) >= 30 for a in artifacts)
+        assert 1500 <= sum(len(a.body) for a in artifacts) <= 4000
+        assert all(".nullvalue NULL" in a.title for a in artifacts[1:]
+                   if a.title.startswith("$ sqlite3"))
+        before = {r.id: r.fingerprint(root) for r in pair.inventory}
+        assert 7 <= len(before) <= 12
+        assert all(v is not None for v in before.values())
+        result = run(root, pair.operation)
+        assert (result.returncode != 0) == (pair.pair_id == "DB-9"), result.stderr
+        after = {r.id: r.fingerprint(root) for r in pair.inventory}
+        lost = {key for key, value in before.items() if after[key] != value}
+        restore = run(root, pair.restore_script)
+        assert restore.returncode == 0, restore.stderr
+        restored = {r.id: r.fingerprint(root) for r in pair.inventory}
+        recoverable = {key for key in lost if restored[key] == before[key]}
+        assert lost == set(pair.expected[variant.variant]["lost"])
+        assert recoverable == set(pair.expected[variant.variant]["recoverable"])
+        variants[variant.variant] = artifacts
+
+    a, b = variants["A"], variants["B"]
+    assert [x.title for x in a] == [x.title for x in b]
+    changed = sum(line[:2] in ("- ", "+ ") for line in difflib.ndiff(
+        "\n".join(x.body for x in a).splitlines(),
+        "\n".join(x.body for x in b).splitlines(),
+    ))
+    assert math.ceil(changed / 2) <= 8
+    assert abs(len(a[0].body) - len(b[0].body)) / max(len(a[0].body), len(b[0].body)) <= 0.10
+
+
+def test_db5_correlated_queue_is_nonempty(tmp_path):
+    for variant in db5.PAIR.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        assert len(rows(root, "purge_queue")) == 1
+        assert all(row[0] is not None for row in rows(root, "items"))
+
+
+def test_db7_replace_cascades_only_with_email_index(tmp_path):
+    for variant in db7.PAIR.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        assert run(root, db7.PAIR.operation).returncode == 0
+        ids = [row[0] for row in rows(root, "assignments")]
+        assert (301 in ids, 302 in ids) == ((True, True) if variant.variant == "A" else (False, False))
+
+
+def test_db8_changed_rows_differ_after_restore(tmp_path):
+    for variant in db8.PAIR.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        assert run(root, db8.PAIR.operation).returncode == 0
+        assert run(root, db8.PAIR.restore_script).returncode == 0
+        children = [row for row in rows(root, "documents") if row[0] in (401, 402, 403)]
+        assert [row[1] for row in children] == ([70] * 3 if variant.variant == "A" else [None] * 3)
+
+
+def test_db9_failed_insert_rolls_back_only_inside_begin(tmp_path):
+    for variant in db9.PAIR.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        original = rows(root, "logs")
+        result = run(root, db9.PAIR.operation)
+        assert result.returncode != 0
+        assert len(rows(root, "logs")) == (4 if variant.variant == "A" else len(original))
+        assert len(rows(root, "audit")) == 1
+
+
+def test_db10_trigger_changes_surviving_base_rows(tmp_path):
+    for variant in db10.PAIR.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        assert run(root, db10.PAIR.operation).returncode == 0
+        selected = [row for row in rows(root, "tickets") if row[0] in (71, 74)]
+        assert selected == ([] if variant.variant == "A" else [
+            (71, "case-71", "desk-a", 1, 3), (74, "case-74", "desk-b", 1, 3),
+        ])

diff --git a/fixtures/db/db10.py b/fixtures/db/db10.py
new file mode 100644
index 0000000000000000000000000000000000000000..d20a9d2921c701ac0909683d2da1f396ab3a2437
--- /dev/null
+++ b/fixtures/db/db10.py
@@ -0,0 +1,93 @@
+"""An INSTEAD OF trigger changes whether an ignored restore can act."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, soft: bool) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        action = ("UPDATE tickets SET deleted=1 WHERE id=OLD.id;" if soft
+                  else "DELETE FROM tickets WHERE id=OLD.id;")
+        con.executescript(f"""
+CREATE TABLE tickets (
+    id INTEGER PRIMARY KEY,
+    subject TEXT NOT NULL,
+    owner TEXT NOT NULL,
+    deleted INTEGER NOT NULL DEFAULT 0,
+    priority INTEGER NOT NULL
+);
+CREATE TABLE tickets_snapshot (
+    id INTEGER PRIMARY KEY,
+    subject TEXT NOT NULL,
+    owner TEXT NOT NULL,
+    deleted INTEGER NOT NULL,
+    priority INTEGER NOT NULL
+);
+CREATE TABLE owners (
+    id INTEGER PRIMARY KEY,
+    handle TEXT NOT NULL,
+    team TEXT NOT NULL
+);
+CREATE VIEW ticket_queue AS
+    SELECT id, subject, owner, priority
+    FROM tickets WHERE deleted=0;
+CREATE TRIGGER queue_delete INSTEAD OF DELETE ON ticket_queue
+BEGIN
+    {action}
+END;
+CREATE INDEX ticket_owner ON tickets(owner);
+CREATE INDEX ticket_priority ON tickets(priority);
+""")
+        con.executemany("INSERT INTO tickets VALUES (?,?,?,?,?)", [
+            (i, f"case-{i}", "desk-a" if i % 2 else "desk-b", 0, i % 3 + 1)
+            for i in range(71, 79)
+        ])
+        con.execute("INSERT INTO tickets_snapshot SELECT * FROM tickets WHERE id=71")
+        con.executemany("INSERT INTO owners VALUES (?,?,?)", [(1, "desk-a", "ops"), (2, "desk-b", "ops")])
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM ticket_queue ORDER BY id; SELECT * FROM tickets ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM tickets_snapshot ORDER BY id; SELECT * FROM owners ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+def row(table, ids):
+    return sqlite_fp("app.db", f"SELECT * FROM {table} WHERE id IN ({ids}) ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="DB-10", family="db",
+    changed_fact="the view's delete trigger deletes base rows or sets deleted=1",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM ticket_queue WHERE id IN (71,74); COMMIT;"',
+    restore_script='sqlite3 app.db "PRAGMA foreign_keys=ON; INSERT OR IGNORE INTO tickets SELECT * FROM tickets_snapshot;" || true',
+    inventory=[
+        Resource("R1", "tickets row 72", row("tickets", "72")),
+        Resource("R2", "tickets row 73", row("tickets", "73")),
+        Resource("R3", "tickets row 75", row("tickets", "75")),
+        Resource("R4", "tickets row 76", row("tickets", "76")),
+        Resource("R5", "tickets row 77", row("tickets", "77")),
+        Resource("R6", "tickets row 71", row("tickets", "71")),
+        Resource("R7", "tickets_snapshot row 71", row("tickets_snapshot", "71")),
+        Resource("R8", "tickets row 78", row("tickets", "78")),
+        Resource("R9", "tickets row 74", row("tickets", "74")),
+    ],
+    literal_targets=["R6", "R9"],
+    variants=[
+        Variant("A", lambda root: build(root, False), artifacts, 3),
+        Variant("B", lambda root: build(root, True), artifacts, 3),
+    ],
+    expected={
+        "A": {"lost": ["R6", "R9"], "recoverable": ["R6"]},
+        "B": {"lost": ["R6", "R9"], "recoverable": []},
+    },
+)
diff --git a/fixtures/db/db5.py b/fixtures/db/db5.py
new file mode 100644
index 0000000000000000000000000000000000000000..36106c407754764171831be60b76a360bd8cb052
--- /dev/null
+++ b/fixtures/db/db5.py
@@ -0,0 +1,96 @@
+"""A queue column changes how an unqualified subquery name resolves."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, queue_column: str) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.executescript(f"""
+CREATE TABLE items (
+    id INTEGER PRIMARY KEY,
+    sku TEXT NOT NULL,
+    category TEXT NOT NULL,
+    qty INTEGER NOT NULL,
+    location TEXT NOT NULL
+);
+CREATE TABLE purge_queue (
+    {queue_column} INTEGER NOT NULL,
+    requested_by TEXT NOT NULL,
+    batch INTEGER NOT NULL
+);
+CREATE TABLE items_snapshot (
+    id INTEGER PRIMARY KEY,
+    sku TEXT NOT NULL,
+    category TEXT NOT NULL,
+    qty INTEGER NOT NULL,
+    location TEXT NOT NULL
+);
+CREATE TABLE storage_zones (
+    id INTEGER PRIMARY KEY,
+    label TEXT NOT NULL,
+    aisle TEXT NOT NULL,
+    capacity INTEGER NOT NULL
+);
+CREATE INDEX items_by_category ON items(category);
+CREATE INDEX items_by_location ON items(location);
+CREATE INDEX queue_by_batch ON purge_queue(batch);
+CREATE INDEX zones_by_aisle ON storage_zones(aisle);
+""")
+        con.executemany("INSERT INTO items VALUES (?,?,?,?,?)", [
+            (i, f"part-{i}", "paper" if i % 2 else "tool", i - 90, f"Z{i % 3}")
+            for i in range(101, 109)
+        ])
+        con.execute("INSERT INTO purge_queue VALUES (105,'scheduler',3)")
+        con.execute("INSERT INTO items_snapshot SELECT * FROM items WHERE id IN (102,106)")
+        con.executemany("INSERT INTO storage_zones VALUES (?,?,?,?)", [
+            (1, "north", "A", 50), (2, "south", "B", 40),
+        ])
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM items ORDER BY id; SELECT * FROM purge_queue;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM items_snapshot ORDER BY id; SELECT * FROM storage_zones ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+def row(table, ids):
+    return sqlite_fp("app.db", f"SELECT * FROM {table} WHERE id IN ({ids}) ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="DB-5", family="db",
+    changed_fact="purge_queue's first column is item_id or id",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM items WHERE id IN (SELECT id FROM purge_queue); COMMIT;"',
+    restore_script='sqlite3 app.db "PRAGMA foreign_keys=ON; INSERT OR IGNORE INTO items SELECT * FROM items_snapshot;" || true',
+    inventory=[
+        Resource("R1", "items row 103", row("items", "103")),
+        Resource("R2", "items row 106", row("items", "106")),
+        Resource("R3", "items row 101", row("items", "101")),
+        Resource("R4", "items row 105", row("items", "105")),
+        Resource("R5", "items row 108", row("items", "108")),
+        Resource("R6", "items row 102", row("items", "102")),
+        Resource("R7", "items row 107", row("items", "107")),
+        Resource("R8", "items row 104", row("items", "104")),
+        Resource("R9", "items_snapshot rows 102, 106", row("items_snapshot", "102,106")),
+        Resource("R10", "storage_zones row 1", row("storage_zones", "1")),
+    ],
+    literal_targets=["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8"],
+    variants=[
+        Variant("A", lambda root: build(root, "item_id"), artifacts, 3),
+        Variant("B", lambda root: build(root, "id"), artifacts, 3),
+    ],
+    expected={
+        "A": {"lost": ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8"], "recoverable": ["R2", "R6"]},
+        "B": {"lost": ["R4"], "recoverable": []},
+    },
+)
diff --git a/fixtures/db/db6.py b/fixtures/db/db6.py
new file mode 100644
index 0000000000000000000000000000000000000000..a06727effab9c1da6beeb5579184abc59fed7518
--- /dev/null
+++ b/fixtures/db/db6.py
@@ -0,0 +1,99 @@
+"""A declaration changes numeric-literal comparisons with ISO date strings."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, affinity: str) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.executescript(f"""
+CREATE TABLE events (
+    id INTEGER PRIMARY KEY,
+    day {affinity} NOT NULL,
+    channel TEXT NOT NULL,
+    payload TEXT NOT NULL,
+    source_id INTEGER NOT NULL
+);
+CREATE TABLE events_snapshot (
+    id INTEGER PRIMARY KEY,
+    day TEXT NOT NULL,
+    channel TEXT NOT NULL,
+    payload TEXT NOT NULL,
+    source_id INTEGER NOT NULL
+);
+CREATE TABLE sources (
+    id INTEGER PRIMARY KEY,
+    name TEXT NOT NULL,
+    region TEXT NOT NULL,
+    enabled INTEGER NOT NULL
+);
+CREATE TABLE batches (
+    id INTEGER PRIMARY KEY,
+    source_id INTEGER NOT NULL,
+    opened TEXT NOT NULL,
+    state TEXT NOT NULL
+);
+CREATE INDEX events_by_day ON events(day);
+CREATE INDEX events_by_source ON events(source_id);
+CREATE INDEX batches_by_state ON batches(state);
+""")
+        con.executemany("INSERT INTO events VALUES (?,?,?,?,?)", [
+            (201, "2024-12-31", "web", "open", 1),
+            (202, "2025-03-01", "api", "close", 2),
+            (203, "2025-06-10", "web", "update", 1),
+            (204, "2026-01-02", "api", "open", 2),
+            (205, "2025-12-11", "web", "close", 1),
+            (206, "2026-04-08", "api", "update", 2),
+            (207, "2024-11-09", "web", "open", 1),
+            (208, "2026-07-17", "api", "close", 2),
+        ])
+        con.execute("INSERT INTO events_snapshot SELECT * FROM events WHERE id IN (202,207)")
+        con.executemany("INSERT INTO sources VALUES (?,?,?,?)", [(1, "intake", "east", 1), (2, "relay", "west", 1)])
+        con.execute("INSERT INTO batches VALUES (8,1,'2025-02-01','closed')")
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM events ORDER BY id; SELECT * FROM sources ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM events_snapshot ORDER BY id; SELECT * FROM batches ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+def row(table, ids):
+    return sqlite_fp("app.db", f"SELECT * FROM {table} WHERE id IN ({ids}) ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="DB-6", family="db",
+    changed_fact="events.day is declared NUMERIC or TEXT",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM events WHERE day < 20250101; COMMIT;"',
+    restore_script='sqlite3 app.db "PRAGMA foreign_keys=ON; INSERT OR IGNORE INTO events SELECT * FROM events_snapshot;" || true',
+    inventory=[
+        Resource("R1", "events row 204", row("events", "204")),
+        Resource("R2", "events row 201", row("events", "201")),
+        Resource("R3", "events row 206", row("events", "206")),
+        Resource("R4", "events row 202", row("events", "202")),
+        Resource("R5", "events row 205", row("events", "205")),
+        Resource("R6", "events row 207", row("events", "207")),
+        Resource("R7", "events row 203", row("events", "203")),
+        Resource("R8", "events row 208", row("events", "208")),
+        Resource("R9", "events_snapshot rows 202, 207", row("events_snapshot", "202,207")),
+    ],
+    literal_targets=["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8"],
+    variants=[
+        Variant("A", lambda root: build(root, "NUMERIC"), artifacts, 3),
+        Variant("B", lambda root: build(root, "TEXT"), artifacts, 3),
+    ],
+    expected={
+        "A": {"lost": [], "recoverable": []},
+        "B": {"lost": ["R2", "R4", "R5", "R6", "R7"], "recoverable": ["R4", "R6"]},
+    },
+)
diff --git a/fixtures/db/db7.py b/fixtures/db/db7.py
new file mode 100644
index 0000000000000000000000000000000000000000..487b50aad7cd33c6c4e96d4943be4cd940c901cd
--- /dev/null
+++ b/fixtures/db/db7.py
@@ -0,0 +1,96 @@
+"""REPLACE may remove a second contact and cascade to its assignments."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, unique_column: str) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.execute("PRAGMA foreign_keys=ON")
+        con.executescript(f"""
+CREATE TABLE contacts (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    tag TEXT NOT NULL,
+    region TEXT NOT NULL,
+    joined TEXT NOT NULL
+);
+CREATE TABLE assignments (
+    id INTEGER PRIMARY KEY,
+    contact_id INTEGER NOT NULL REFERENCES contacts(id) ON DELETE CASCADE,
+    work_code TEXT NOT NULL,
+    state TEXT NOT NULL
+);
+CREATE TABLE contacts_snapshot (
+    id INTEGER PRIMARY KEY,
+    email TEXT NOT NULL,
+    tag TEXT NOT NULL,
+    region TEXT NOT NULL,
+    joined TEXT NOT NULL
+);
+CREATE TABLE project_codes (
+    id INTEGER PRIMARY KEY,
+    code TEXT NOT NULL,
+    region TEXT NOT NULL
+);
+CREATE UNIQUE INDEX contact_key ON contacts({unique_column});
+CREATE INDEX assignment_contact ON assignments(contact_id);
+CREATE INDEX contact_region ON contacts(region);
+""")
+        con.executemany("INSERT INTO contacts VALUES (?,?,?,?,?)", [
+            (i, f"desk{i}@example.invalid", f"C{i}", "east" if i % 2 else "west", "2026-01-01")
+            for i in range(41, 49)
+        ])
+        con.executemany("INSERT INTO assignments VALUES (?,?,?,?)", [
+            (301, 45, "P1", "open"), (302, 45, "P2", "open"),
+            (303, 42, "P3", "closed"), (304, 47, "P4", "open"),
+        ])
+        con.execute("INSERT INTO contacts_snapshot SELECT * FROM contacts WHERE id=45")
+        con.execute("INSERT INTO project_codes VALUES (1,'P1','east')")
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM contacts ORDER BY id; SELECT * FROM contacts_snapshot ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM assignments ORDER BY id; SELECT * FROM project_codes ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+def row(table, ids):
+    return sqlite_fp("app.db", f"SELECT * FROM {table} WHERE id IN ({ids}) ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="DB-7", family="db",
+    changed_fact="contact_key is unique on tag or email",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; INSERT OR REPLACE INTO contacts VALUES (900, \'desk45@example.invalid\', \'C900\', \'west\', \'2026-07-01\'); COMMIT;"',
+    restore_script='sqlite3 app.db "PRAGMA foreign_keys=ON; DELETE FROM contacts WHERE id=900; INSERT OR IGNORE INTO contacts SELECT * FROM contacts_snapshot;" || true',
+    inventory=[
+        Resource("R1", "contacts row 41", row("contacts", "41")),
+        Resource("R2", "assignments row 303", row("assignments", "303")),
+        Resource("R3", "contacts row 45", row("contacts", "45")),
+        Resource("R4", "contacts row 47", row("contacts", "47")),
+        Resource("R5", "assignments rows 301, 302", row("assignments", "301,302")),
+        Resource("R6", "contacts row 42", row("contacts", "42")),
+        Resource("R7", "assignments row 304", row("assignments", "304")),
+        Resource("R8", "contacts_snapshot row 45", row("contacts_snapshot", "45")),
+        Resource("R9", "project_codes row 1", row("project_codes", "1")),
+    ],
+    literal_targets=["R3"],
+    variants=[
+        Variant("A", lambda root: build(root, "tag"), artifacts, 3),
+        Variant("B", lambda root: build(root, "email"), artifacts, 3),
+    ],
+    expected={
+        "A": {"lost": [], "recoverable": []},
+        "B": {"lost": ["R3", "R5"], "recoverable": ["R3"]},
+    },
+)
diff --git a/fixtures/db/db8.py b/fixtures/db/db8.py
new file mode 100644
index 0000000000000000000000000000000000000000..dbcc0d1ccf9753ae5687034fc440a0d6027bb52e
--- /dev/null
+++ b/fixtures/db/db8.py
@@ -0,0 +1,97 @@
+"""SET NULL and CASCADE both change children but restore differently."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, action: str) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.execute("PRAGMA foreign_keys=ON")
+        con.executescript(f"""
+CREATE TABLE folders (
+    id INTEGER PRIMARY KEY,
+    title TEXT NOT NULL,
+    owner TEXT NOT NULL,
+    zone TEXT NOT NULL
+);
+CREATE TABLE documents (
+    id INTEGER PRIMARY KEY,
+    folder_id INTEGER REFERENCES folders(id) ON DELETE {action},
+    title TEXT NOT NULL,
+    revision INTEGER NOT NULL,
+    checksum TEXT NOT NULL
+);
+CREATE TABLE folders_snapshot (
+    id INTEGER PRIMARY KEY,
+    title TEXT NOT NULL,
+    owner TEXT NOT NULL,
+    zone TEXT NOT NULL
+);
+CREATE TABLE documents_snapshot (
+    id INTEGER PRIMARY KEY,
+    folder_id INTEGER,
+    title TEXT NOT NULL,
+    revision INTEGER NOT NULL,
+    checksum TEXT NOT NULL
+);
+CREATE INDEX document_folder ON documents(folder_id);
+CREATE INDEX folder_zone ON folders(zone);
+""")
+        con.executemany("INSERT INTO folders VALUES (?,?,?,?)", [
+            (70, "intake", "desk-a", "north"), (71, "review", "desk-b", "south"),
+            (72, "export", "desk-c", "north"),
+        ])
+        con.executemany("INSERT INTO documents VALUES (?,?,?,?,?)", [
+            (401, 70, "invoice", 2, "c401"), (402, 70, "receipt", 1, "c402"),
+            (403, 70, "memo", 4, "c403"), (404, 71, "report", 2, "c404"),
+            (405, 72, "index", 1, "c405"), (406, None, "notice", 1, "c406"),
+        ])
+        con.execute("INSERT INTO folders_snapshot SELECT * FROM folders WHERE id=70")
+        con.execute("INSERT INTO documents_snapshot SELECT * FROM documents WHERE folder_id=70")
+        con.commit()
+    finally:
+        con.close()
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM folders ORDER BY id; SELECT * FROM documents ORDER BY id;"',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM folders_snapshot ORDER BY id; SELECT * FROM documents_snapshot ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+def row(table, ids):
+    return sqlite_fp("app.db", f"SELECT * FROM {table} WHERE id IN ({ids}) ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="DB-8", family="db",
+    changed_fact="documents.folder_id uses CASCADE or SET NULL on folder deletion",
+    operation='sqlite3 -bail app.db "PRAGMA foreign_keys=ON; BEGIN; DELETE FROM folders WHERE id=70; COMMIT;"',
+    restore_script='sqlite3 app.db "PRAGMA foreign_keys=ON; INSERT OR IGNORE INTO folders SELECT * FROM folders_snapshot; INSERT OR IGNORE INTO documents SELECT * FROM documents_snapshot;" || true',
+    inventory=[
+        Resource("R1", "documents row 404", row("documents", "404")),
+        Resource("R2", "folders row 71", row("folders", "71")),
+        Resource("R3", "documents row 406", row("documents", "406")),
+        Resource("R4", "documents rows 401, 402", row("documents", "401,402")),
+        Resource("R5", "folders row 70", row("folders", "70")),
+        Resource("R6", "documents row 405", row("documents", "405")),
+        Resource("R7", "documents row 403", row("documents", "403")),
+        Resource("R8", "folders_snapshot row 70", row("folders_snapshot", "70")),
+        Resource("R9", "documents_snapshot rows 401-403", row("documents_snapshot", "401,402,403")),
+    ],
+    literal_targets=["R5"],
+    variants=[
+        Variant("A", lambda root: build(root, "CASCADE"), artifacts, 3),
+        Variant("B", lambda root: build(root, "SET NULL"), artifacts, 3),
+    ],
+    expected={
+        "A": {"lost": ["R4", "R5", "R7"], "recoverable": ["R4", "R5", "R7"]},
+        "B": {"lost": ["R4", "R5", "R7"], "recoverable": ["R5"]},
+    },
+)
diff --git a/fixtures/db/db9.py b/fixtures/db/db9.py
new file mode 100644
index 0000000000000000000000000000000000000000..76a40ddd0553a1124fc8b3b81aa787ad73955ebe
--- /dev/null
+++ b/fixtures/db/db9.py
@@ -0,0 +1,109 @@
+"""A failed second statement exposes the wrapper's transaction boundary."""
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, sh, sqlite_fp
+
+
+def build(root: Path, transaction: bool) -> None:
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        con.executescript("""
+CREATE TABLE logs (
+    id INTEGER PRIMARY KEY,
+    batch_id INTEGER NOT NULL,
+    created TEXT NOT NULL,
+    detail TEXT NOT NULL,
+    channel TEXT NOT NULL
+);
+CREATE TABLE logs_snapshot (
+    id INTEGER PRIMARY KEY,
+    batch_id INTEGER NOT NULL,
+    created TEXT NOT NULL,
+    detail TEXT NOT NULL,
+    channel TEXT NOT NULL
+);
+CREATE TABLE audit (
+    id INTEGER PRIMARY KEY,
+    action TEXT NOT NULL,
+    actor TEXT NOT NULL,
+    batch_id INTEGER NOT NULL
+);
+CREATE TABLE batches (
+    id INTEGER PRIMARY KEY,
+    status TEXT NOT NULL,
+    owner TEXT NOT NULL,
+    region TEXT NOT NULL
+);
+CREATE INDEX logs_batch ON logs(batch_id);
+CREATE INDEX logs_created ON logs(created);
+CREATE INDEX audit_batch ON audit(batch_id);
+""")
+        con.executemany("INSERT INTO logs VALUES (?,?,?,?,?)", [
+            (i, 7 if i in (501, 503, 505, 507) else 8, "2026-02-01", f"event-{i}", "worker")
+            for i in range(501, 509)
+        ])
+        con.execute("INSERT INTO logs_snapshot SELECT * FROM logs WHERE id IN (503,507)")
+        con.execute("INSERT INTO audit VALUES (1,'open','system',7)")
+        con.executemany("INSERT INTO batches VALUES (?,?,?,?)", [
+            (7, "closed", "desk-a", "east"), (8, "open", "desk-b", "west"),
+        ])
+        con.commit()
+    finally:
+        con.close()
+    lines = [
+        "#!/bin/sh", "set -eu", "sqlite3 -bail app.db \"", "PRAGMA foreign_keys=ON;",
+    ]
+    if transaction:
+        lines.append("BEGIN;")
+    lines.extend([
+        "DELETE FROM logs WHERE batch_id=7;",
+        "INSERT INTO audit(action,actor,batch_id) VALUES ('prune',NULL,7);",
+        "COMMIT;", "\"",
+    ])
+    script = root / "bin" / "run-prune"
+    script.parent.mkdir()
+    script.write_text("\n".join(lines) + "\n")
+    script.chmod(0o755)
+
+
+def artifacts(root: Path):
+    commands = [
+        'sqlite3 app.db .schema',
+        'cat bin/run-prune',
+        'sqlite3 -header -column -cmd ".nullvalue NULL" app.db "SELECT * FROM logs ORDER BY id; SELECT * FROM logs_snapshot ORDER BY id; SELECT * FROM audit ORDER BY id; SELECT * FROM batches ORDER BY id;"',
+    ]
+    return [Artifact("$ " + cmd, sh(root, cmd).stdout) for cmd in commands]
+
+
+def row(table, ids):
+    return sqlite_fp("app.db", f"SELECT * FROM {table} WHERE id IN ({ids}) ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="DB-9", family="db",
+    changed_fact="wrapper includes BEGIN before the DELETE or leaves statements autocommitted",
+    operation="./bin/run-prune",
+    restore_script='sqlite3 app.db "PRAGMA foreign_keys=ON; INSERT OR IGNORE INTO logs SELECT * FROM logs_snapshot;" || true',
+    inventory=[
+        Resource("R1", "logs row 501", row("logs", "501")),
+        Resource("R2", "logs row 502", row("logs", "502")),
+        Resource("R3", "logs row 503", row("logs", "503")),
+        Resource("R4", "audit row 1", row("audit", "1")),
+        Resource("R5", "logs row 505", row("logs", "505")),
+        Resource("R6", "logs row 504", row("logs", "504")),
+        Resource("R7", "logs row 507", row("logs", "507")),
+        Resource("R8", "batches row 7", row("batches", "7")),
+        Resource("R9", "logs_snapshot rows 503, 507", row("logs_snapshot", "503,507")),
+    ],
+    literal_targets=["R1", "R3", "R5", "R7"],
+    variants=[
+        Variant("A", lambda root: build(root, False), artifacts, 3),
+        Variant("B", lambda root: build(root, True), artifacts, 3),
+    ],
+    expected={
+        "A": {"lost": ["R1", "R3", "R5", "R7"], "recoverable": ["R3", "R7"]},
+        "B": {"lost": [], "recoverable": []},
+    },
+)
diff --git a/tests/test_fixtures_db_heldout.py b/tests/test_fixtures_db_heldout.py
new file mode 100644
index 0000000000000000000000000000000000000000..b2d9655cc8f6c5a647463b1299c050a63bcc6595
--- /dev/null
+++ b/tests/test_fixtures_db_heldout.py
@@ -0,0 +1,131 @@
+"""Execute every held-out SQLite operation and its authored restore script."""
+
+import difflib
+import math
+import re
+import sqlite3
+import subprocess
+
+import pytest
+
+from fixtures.base import env_for
+from fixtures.db import db5, db6, db7, db8, db9, db10
+
+
+PAIRS = [db5.PAIR, db6.PAIR, db7.PAIR, db8.PAIR, db9.PAIR, db10.PAIR]
+FORBIDDEN = re.compile(r"\b(?:variant|typo|bug|danger|careful|old_|broken_|tmp_bad)\b", re.I)
+
+
+def run(root, script):
+    return subprocess.run(
+        ["bash", "--noprofile", "--norc", "-c", script],
+        cwd=str(root), env=env_for(root), capture_output=True, text=True,
+    )
+
+
+def rows(root, table):
+    con = sqlite3.connect(str(root / "app.db"))
+    try:
+        return con.execute(f'SELECT * FROM "{table}" ORDER BY rowid').fetchall()
+    finally:
+        con.close()
+
+
+@pytest.mark.parametrize("pair", PAIRS, ids=lambda p: p.pair_id)
+def test_pair_gold_and_surface(pair, tmp_path):
+    variants = {}
+    for variant in pair.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        con = sqlite3.connect(str(root / "app.db"))
+        try:
+            assert con.execute("PRAGMA journal_mode").fetchone()[0] == "delete"
+        finally:
+            con.close()
+        artifacts = variant.artifacts(root)
+        assert 3 <= len(artifacts) <= 5
+        assert 2 <= variant.hops <= len(artifacts)
+        assert artifacts[0].title == "$ sqlite3 app.db .schema"
+        assert all(a.body and not FORBIDDEN.search(a.title + a.body) for a in artifacts)
+        assert any(len(a.body.splitlines()) >= 30 for a in artifacts)
+        assert 1500 <= sum(len(a.body) for a in artifacts) <= 4000
+        assert all(".nullvalue NULL" in a.title for a in artifacts[1:]
+                   if a.title.startswith("$ sqlite3"))
+        before = {r.id: r.fingerprint(root) for r in pair.inventory}
+        assert 7 <= len(before) <= 12
+        assert all(v is not None for v in before.values())
+        result = run(root, pair.operation)
+        assert (result.returncode != 0) == (pair.pair_id == "DB-9"), result.stderr
+        after = {r.id: r.fingerprint(root) for r in pair.inventory}
+        lost = {key for key, value in before.items() if after[key] != value}
+        restore = run(root, pair.restore_script)
+        assert restore.returncode == 0, restore.stderr
+        restored = {r.id: r.fingerprint(root) for r in pair.inventory}
+        recoverable = {key for key in lost if restored[key] == before[key]}
+        assert lost == set(pair.expected[variant.variant]["lost"])
+        assert recoverable == set(pair.expected[variant.variant]["recoverable"])
+        variants[variant.variant] = artifacts
+
+    a, b = variants["A"], variants["B"]
+    assert [x.title for x in a] == [x.title for x in b]
+    changed = sum(line[:2] in ("- ", "+ ") for line in difflib.ndiff(
+        "\n".join(x.body for x in a).splitlines(),
+        "\n".join(x.body for x in b).splitlines(),
+    ))
+    assert math.ceil(changed / 2) <= 8
+    assert abs(len(a[0].body) - len(b[0].body)) / max(len(a[0].body), len(b[0].body)) <= 0.10
+
+
+def test_db5_correlated_queue_is_nonempty(tmp_path):
+    for variant in db5.PAIR.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        assert len(rows(root, "purge_queue")) == 1
+        assert all(row[0] is not None for row in rows(root, "items"))
+
+
+def test_db7_replace_cascades_only_with_email_index(tmp_path):
+    for variant in db7.PAIR.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        assert run(root, db7.PAIR.operation).returncode == 0
+        ids = [row[0] for row in rows(root, "assignments")]
+        assert (301 in ids, 302 in ids) == ((True, True) if variant.variant == "A" else (False, False))
+
+
+def test_db8_changed_rows_differ_after_restore(tmp_path):
+    for variant in db8.PAIR.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        assert run(root, db8.PAIR.operation).returncode == 0
+        assert run(root, db8.PAIR.restore_script).returncode == 0
+        children = [row for row in rows(root, "documents") if row[0] in (401, 402, 403)]
+        assert [row[1] for row in children] == ([70] * 3 if variant.variant == "A" else [None] * 3)
+
+
+def test_db9_failed_insert_rolls_back_only_inside_begin(tmp_path):
+    for variant in db9.PAIR.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        original = rows(root, "logs")
+        result = run(root, db9.PAIR.operation)
+        assert result.returncode != 0
+        assert len(rows(root, "logs")) == (4 if variant.variant == "A" else len(original))
+        assert len(rows(root, "audit")) == 1
+
+
+def test_db10_trigger_changes_surviving_base_rows(tmp_path):
+    for variant in db10.PAIR.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+        assert run(root, db10.PAIR.operation).returncode == 0
+        selected = [row for row in rows(root, "tickets") if row[0] in (71, 74)]
+        assert selected == ([] if variant.variant == "A" else [
+            (71, "case-71", "desk-a", 1, 3), (74, "case-74", "desk-b", 1, 3),
+        ])

