+    r"\b(?:typo|bug|danger|careful)\b|old_|broken_|tmp_bad|\bvariant\s+[AB]\b",
+    re.I,
+)
+
+
+def _run(root, script):
+    return subprocess.run(
+        ["bash", "--noprofile", "--norc", "-c", script],
+        cwd=root,
