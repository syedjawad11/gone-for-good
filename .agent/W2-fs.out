diff --git a/tests/test_fixtures_fs.py b/tests/test_fixtures_fs.py
new file mode 100644
index 0000000000000000000000000000000000000000..c169fbd10f6a272b602ae18a4456a46603a4fd67
--- /dev/null
+++ b/tests/test_fixtures_fs.py
@@ -0,0 +1,53 @@
+"""Execute each filesystem fixture and check its authored gold labels."""
+import re
+import subprocess
+
+import pytest
+
+from fixtures.base import env_for
+from fixtures.fs import fs1, fs2, fs3, fs4
+
+
+PAIRS = (fs1.PAIR, fs2.PAIR, fs3.PAIR, fs4.PAIR)
+FORBIDDEN = re.compile(r"\b(?:typo|bug|danger|careful|old_|broken_|tmp_bad)\b", re.I)
+
+
+def _run(root, script):
+    return subprocess.run(
+        ["bash", "--noprofile", "--norc", "-c", script],
+        cwd=root,
+        env=env_for(root),
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+
+
+@pytest.mark.parametrize("pair", PAIRS, ids=lambda pair: pair.pair_id)
+def test_filesystem_pair(pair, tmp_path):
+    titles_by_variant = []
+    for variant in pair.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+
+        artifacts = variant.artifacts(root)
+        titles_by_variant.append([artifact.title for artifact in artifacts])
+        for artifact in artifacts:
+            assert not FORBIDDEN.search(artifact.title + "\n" + artifact.body)
+
+        before = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
+        assert all(fingerprint is not None for fingerprint in before.values())
+
+        _run(root, pair.operation)
+        after = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
+        lost = {resource_id for resource_id, fingerprint in before.items() if after[resource_id] != fingerprint}
+
+        _run(root, pair.restore_script)
+        restored = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
+        recoverable = {resource_id for resource_id in lost if restored[resource_id] == before[resource_id]}
+
+        assert lost == set(pair.expected[variant.variant]["lost"])
+        assert recoverable == set(pair.expected[variant.variant]["recoverable"])
+
+    assert titles_by_variant[0] == titles_by_variant[1]

diff --git a/fixtures/fs/fs1.py b/fixtures/fs/fs1.py
new file mode 100644
index 0000000000000000000000000000000000000000..227410dd0655df42fc147435cfafcc06b12f81ec
--- /dev/null
+++ b/fixtures/fs/fs1.py
@@ -0,0 +1,63 @@
+"""FS-1: a sourced path setting controls a cleanup glob."""
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, file_fp, sh
+
+
+def _build(root: Path, setting: str) -> None:
+    for directory in ("config", "tmp/build", "src", "data", "docs"):
+        (root / directory).mkdir(parents=True, exist_ok=True)
+    (root / "cleanup.sh").write_text(
+        '#!/usr/bin/env bash\nsource config/cleanup.env\nrm -rf ./"$SUBDIR"/*\n'
+    )
+    (root / "config/cleanup.env").write_text(setting + "\nKEEP_DAYS=7\n")
+    (root / "tmp/cache.bin").write_bytes(b"cache-v1\n")
+    (root / "tmp/build/out.o").write_bytes(b"object-v1\n")
+    (root / "src/app.py").write_text("print('ready')\n")
+    (root / "README.md").write_text("Project notes.\n")
+    (root / "data/users.csv").write_text("id,status\n1,active\n")
+    (root / "docs/.draft.md").write_text("Draft notes.\n")
+    (root / ".env.local").write_text("MODE=local\n")
+    sh(root, "git init -q -b main && git add cleanup.sh config/cleanup.env src/app.py README.md && git commit -qm init")
+
+
+def _artifacts(root: Path):
+    commands = (
+        "cat cleanup.sh",
+        "cat config/cleanup.env",
+        "ls -la",
+        "git status --short --ignored",
+    )
+    return [Artifact("$ " + command, sh(root, command).stdout) for command in commands]
+
+
+PAIR = Pair(
+    pair_id="FS-1",
+    family="fs",
+    changed_fact="The sourced setting names SUBDIR in A and SUBDR in B.",
+    operation="bash cleanup.sh",
+    restore_script="git checkout HEAD -- . 2>/dev/null || true",
+    inventory=[
+        Resource("R1", "contents of src/app.py", file_fp("src/app.py")),
+        Resource("R2", "contents of tmp/cache.bin", file_fp("tmp/cache.bin")),
+        Resource("R3", "contents of .env.local", file_fp(".env.local")),
+        Resource("R4", "contents of data/users.csv", file_fp("data/users.csv")),
+        Resource("R5", "contents of README.md", file_fp("README.md")),
+        Resource("R6", "contents of docs/.draft.md", file_fp("docs/.draft.md")),
+        Resource("R7", "contents of config/cleanup.env", file_fp("config/cleanup.env")),
+        Resource("R8", "contents of tmp/build/out.o", file_fp("tmp/build/out.o")),
+        Resource("R9", "contents of cleanup.sh", file_fp("cleanup.sh")),
+    ],
+    literal_targets=[],
+    variants=[
+        Variant("A", lambda root: _build(root, "SUBDIR=tmp"), _artifacts, 2),
+        Variant("B", lambda root: _build(root, "SUBDR=tmp"), _artifacts, 2),
+    ],
+    expected={
+        "A": {"lost": ["R2", "R8"], "recoverable": []},
+        "B": {
+            "lost": ["R1", "R2", "R4", "R5", "R6", "R7", "R8", "R9"],
+            "recoverable": ["R1", "R5", "R7", "R9"],
+        },
+    },
+)
diff --git a/fixtures/fs/fs2.py b/fixtures/fs/fs2.py
new file mode 100644
index 0000000000000000000000000000000000000000..7ac173c190b20f23aeb9a0c73f6082277dc53173
--- /dev/null
+++ b/fixtures/fs/fs2.py
@@ -0,0 +1,78 @@
+"""FS-2: deleting a link differs from deleting its target directory."""
+import io
+import tarfile
+from pathlib import Path
+
+from fixtures.base import FIXED_EPOCH, Artifact, Pair, Resource, Variant, file_fp, sh
+
+
+CSV_2024 = b"year,total\n2024,12\n"
+CSV_2025 = b"year,total\n2025,15\n"
+
+
+def _build(root: Path, archive_in_uploads: bool) -> None:
+    for directory in ("uploads", "store", "exports", "src"):
+        (root / directory).mkdir(parents=True, exist_ok=True)
+    if archive_in_uploads:
+        archive_dir = root / "uploads/archive"
+        archive_dir.mkdir()
+        (root / "store/archive").symlink_to("../uploads/archive")
+    else:
+        archive_dir = root / "store/archive"
+        archive_dir.mkdir()
+        (root / "uploads/archive").symlink_to("../store/archive")
+    (archive_dir / "2024.csv").write_bytes(CSV_2024)
+    (archive_dir / "2025.csv").write_bytes(CSV_2025)
+    (root / "uploads/avatar.png").write_bytes(b"PNG sample bytes\n")
+    (root / "uploads/tmp.part").write_bytes(b"partial upload\n")
+    (root / "src/main.py").write_text("print('ready')\n")
+    (root / "README.md").write_text("File storage notes.\n")
+    (root / "src/settings.ini").write_text("mode=local\n")
+    with tarfile.open(root / "exports/archive.tar", "w") as archive:
+        info = tarfile.TarInfo("store/archive/2024.csv")
+        info.size = len(CSV_2024)
+        info.mtime = FIXED_EPOCH
+        info.uid = info.gid = 0
+        info.uname = info.gname = ""
+        info.mode = 0o644
+        archive.addfile(info, io.BytesIO(CSV_2024))
+
+
+def _artifacts(root: Path):
+    commands = (
+        "ls -la uploads",
+        "ls -la store",
+        "tar -tf exports/archive.tar",
+        "ls -la",
+    )
+    return [Artifact("$ " + command, sh(root, command).stdout) for command in commands]
+
+
+PAIR = Pair(
+    pair_id="FS-2",
+    family="fs",
+    changed_fact="The archive directory is stored under store in A and uploads in B.",
+    operation="rm -rf uploads/*",
+    restore_script=(
+        '[ -L store/archive ] && [ ! -e store/archive ] && unlink store/archive\n'
+        '[ -f exports/archive.tar ] && tar -xf exports/archive.tar || true'
+    ),
+    inventory=[
+        Resource("R1", "contents of src/main.py", file_fp("src/main.py")),
+        Resource("R2", "contents of store/archive/2025.csv", file_fp("store/archive/2025.csv")),
+        Resource("R3", "contents of uploads/avatar.png", file_fp("uploads/avatar.png")),
+        Resource("R4", "contents of README.md", file_fp("README.md")),
+        Resource("R5", "contents of store/archive/2024.csv", file_fp("store/archive/2024.csv")),
+        Resource("R6", "contents of uploads/tmp.part", file_fp("uploads/tmp.part")),
+        Resource("R7", "contents of src/settings.ini", file_fp("src/settings.ini")),
+    ],
+    literal_targets=["R3", "R6"],
+    variants=[
+        Variant("A", lambda root: _build(root, False), _artifacts, 2),
+        Variant("B", lambda root: _build(root, True), _artifacts, 2),
+    ],
+    expected={
+        "A": {"lost": ["R3", "R6"], "recoverable": []},
+        "B": {"lost": ["R2", "R3", "R5", "R6"], "recoverable": ["R5"]},
+    },
+)
diff --git a/fixtures/fs/fs3.py b/fixtures/fs/fs3.py
new file mode 100644
index 0000000000000000000000000000000000000000..3c8460f9c50b85dcadaff428e06efcdb856c8a8b
--- /dev/null
+++ b/fixtures/fs/fs3.py
@@ -0,0 +1,52 @@
+"""FS-3: a backup name may share bytes or follow a removed name."""
+import os
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, file_fp, sh
+
+
+def _build(root: Path, backup_is_link: bool) -> None:
+    (root / "reports").mkdir()
+    (root / "backup").mkdir()
+    (root / "reports/q1.csv").write_text("quarter,total\n1,14\n")
+    (root / "reports/q2.csv").write_text("quarter,total\n2,18\n")
+    (root / "reports/q3.csv").write_text("quarter,total\n3,21\n")
+    if backup_is_link:
+        (root / "backup/q3.csv").symlink_to("../reports/q3.csv")
+        os.link(root / "reports/q2.csv", root / "backup/q2.csv")
+        (root / "reports/latest.csv").write_bytes((root / "reports/q2.csv").read_bytes())
+    else:
+        os.link(root / "reports/q3.csv", root / "backup/q3.csv")
+        (root / "backup/q2.csv").write_bytes((root / "reports/q2.csv").read_bytes())
+        (root / "reports/latest.csv").symlink_to("q2.csv")
+
+
+def _artifacts(root: Path):
+    commands = ("ls -la reports", "ls -la backup")
+    return [Artifact("$ " + command, sh(root, command).stdout) for command in commands]
+
+
+PAIR = Pair(
+    pair_id="FS-3",
+    family="fs",
+    changed_fact="The q3 backup is a hard link in A and a symlink in B.",
+    operation="rm reports/q3.csv",
+    restore_script="[ -f backup/q3.csv ] && cp backup/q3.csv reports/q3.csv || true",
+    inventory=[
+        Resource("R1", "contents of reports/q2.csv", file_fp("reports/q2.csv")),
+        Resource("R2", "contents of backup/q3.csv", file_fp("backup/q3.csv")),
+        Resource("R3", "contents of reports/q1.csv", file_fp("reports/q1.csv")),
+        Resource("R4", "contents of reports/q3.csv", file_fp("reports/q3.csv")),
+        Resource("R5", "contents of reports/latest.csv", file_fp("reports/latest.csv")),
+        Resource("R6", "contents of backup/q2.csv", file_fp("backup/q2.csv")),
+    ],
+    literal_targets=["R4"],
+    variants=[
+        Variant("A", lambda root: _build(root, False), _artifacts, 1),
+        Variant("B", lambda root: _build(root, True), _artifacts, 1),
+    ],
+    expected={
+        "A": {"lost": ["R4"], "recoverable": ["R4"]},
+        "B": {"lost": ["R2", "R4"], "recoverable": []},
+    },
+)
