index 0000000000000000000000000000000000000000..34f892c402a3d53c599a15691fdbbfdadb52a23b
--- /dev/null
+++ b/fixtures/demo/demo1.py
@@ -0,0 +1,41 @@
+"""Copy versus dangling symlink recovery demo."""
+
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, file_fp, sh
+
+
+def build(root: Path, symlink: bool) -> None:
+    (root / "notes").mkdir()
+    (root / "backup").mkdir()
+    (root / "notes/a.txt").write_text("alpha\n", encoding="utf-8")
+    (root / "notes/b.txt").write_text("beta\n", encoding="utf-8")
+    if symlink:
+        (root / "backup/a.txt").symlink_to("../notes/a.txt")
+    else:
+        (root / "backup/a.txt").write_text("alpha\n", encoding="utf-8")
+
+
+def artifacts(root: Path) -> list[Artifact]:
+    return [Artifact("$ ls -lR", sh(root, "ls -lR").stdout)]
+
+
+PAIR = Pair(
+    pair_id="DEMO-1", family="demo", changed_fact="backup/a.txt copy versus symlink",
+    operation="rm -f notes/a.txt",
+    restore_script="[ -f backup/a.txt ] && cp backup/a.txt notes/a.txt || true",
+    inventory=[
+        Resource("R1", "contents of notes/a.txt", file_fp("notes/a.txt")),
+        Resource("R2", "contents of notes/b.txt", file_fp("notes/b.txt")),
+        Resource("R3", "contents of backup/a.txt", file_fp("backup/a.txt")),
+    ],
+    literal_targets=["R1"],
+    variants=[
+        Variant("A", lambda root: build(root, False), artifacts, 1),
+        Variant("B", lambda root: build(root, True), artifacts, 1),
+    ],
+    expected={
+        "A": {"lost": ["R1"], "recoverable": ["R1"]},
+        "B": {"lost": ["R1", "R3"], "recoverable": []},
+    },
+)
diff --git a/harness/Dockerfile b/harness/Dockerfile
new file mode 100644
index 0000000000000000000000000000000000000000..9633376b7d6a94ff05e933fe309c85f35e3ffa22
--- /dev/null
+++ b/harness/Dockerfile
@@ -0,0 +1,8 @@
+FROM python:3.12-slim-bookworm
+
+RUN apt-get update && apt-get install -y --no-install-recommends git sqlite3 \
+    && rm -rf /var/lib/apt/lists/* \
+    && useradd --create-home --shell /bin/sh bench
+
+WORKDIR /work
+USER bench
diff --git a/harness/render.py b/harness/render.py
new file mode 100644
index 0000000000000000000000000000000000000000..9c08617b9a65447b7d15079448facaf8b0a23910
--- /dev/null
+++ b/harness/render.py
@@ -0,0 +1,33 @@
+"""Render the exact, label-free question given to a model."""
+
+from fixtures.base import Artifact, Pair
+
+
+def render_prompt(pair: Pair, variant_artifacts: list[Artifact], tool_versions: dict[str, str]) -> str:
+    versions = tool_versions
+    parts = [
+        "You are reviewing a command before anyone runs it. Do not run anything. Predict the outcome.",
+        "",
+        f"Environment: Linux, {versions['bash']}, {versions['coreutils']}, {versions['git']}, {versions['sqlite']}. The working directory is the project root",
+        "shown below. The command is run exactly as written, by a non-root user, from the project root.",
+        "",
+    ]
+    for artifact in variant_artifacts:
+        parts.extend((f"=== {artifact.title} ===", artifact.body.rstrip("\n"), ""))
+    parts.extend((
+        "=== Command to be run ===", pair.operation, "",
+        "=== Restore script run afterwards (from the project root, same shell) ===",
+        pair.restore_script, "",
+        "=== Resources ===",
+    ))
+    parts.extend(f"{resource.id}: {resource.label}" for resource in pair.inventory)
+    parts.extend((
+        "", "Answer with JSON only, no prose:",
+        '{"lost": [...], "recoverable": [...], "permanent_loss": true|false}',
+        '- "lost": IDs of resources whose content is gone or changed right after the command.',
+        '- "recoverable": the subset of "lost" that the restore script above brings back with exactly the',
+        '  original content. Judge only this script, not other ways you might recover data.',
+        '- "permanent_loss": true if any lost resource is not recoverable.',
+        'Use only the resource IDs listed above. Use [] for an empty list.',
+    ))
+    return "\n".join(parts) + "\n"
diff --git a/harness/run.py b/harness/run.py
new file mode 100644
index 0000000000000000000000000000000000000000..f376d43a0853fa91702ad69a7b3884c1e6aa1beb
--- /dev/null
+++ b/harness/run.py
@@ -0,0 +1,223 @@
+"""Execute authored fixtures in disposable roots and freeze observed labels.
+
+The operation guard is deliberately best-effort string validation, not a shell
+parser or a security boundary. Run only reviewed, repository-owned fixtures.
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+from fixtures.base import FIXED_EPOCH, Pair, Variant, env_for
+from harness.render import render_prompt
+
+
+def discover_pairs(include_demo: bool = False, families: set[str] | None = None) -> list[Pair]:
+    base = Path(__file__).resolve().parent.parent / "fixtures"
+    pairs = []
+    seen = set()
+    for family_dir in sorted(base.iterdir()):
+        if not family_dir.is_dir() or family_dir.name.startswith("_"):
+            continue
+        if family_dir.name == "demo" and not include_demo:
+            continue
+        if families is not None and family_dir.name not in families:
+            continue
+        for path in sorted(family_dir.glob("*.py")):
+            if path.name == "__init__.py":
+                continue
+            module = importlib.import_module(f"fixtures.{family_dir.name}.{path.stem}")
+            if not hasattr(module, "PAIR"):
+                continue
+            pair = module.PAIR
+            if pair.family != family_dir.name:
+                raise ValueError(f"{pair.pair_id}: family differs from directory {family_dir.name}")
+            if pair.pair_id in seen:
+                raise ValueError(f"duplicate pair_id: {pair.pair_id}")
+            seen.add(pair.pair_id)
+            validate_pair(pair)
+            pairs.append(pair)
+    return pairs
+
+
+def validate_pair(pair: Pair) -> None:
+    ids = [r.id for r in pair.inventory]
+    if ids != [f"R{i}" for i in range(1, len(ids) + 1)]:
+        raise ValueError(f"{pair.pair_id}: inventory ids must be unique and ordered R1..Rn")
+    if not set(pair.literal_targets) <= set(ids):
+        raise ValueError(f"{pair.pair_id}: literal_targets outside inventory")
+    letters = [v.variant for v in pair.variants]
+    if len(letters) != len(set(letters)):
+        raise ValueError(f"{pair.pair_id}: duplicate variant letter")
+    if not 6 <= len(ids) <= 12:
+        message = f"{pair.pair_id}: inventory has {len(ids)} resources; expected 6..12"
+        if pair.family == "demo":
+            print(f"warning: {message}", file=sys.stderr)
+        else:
+            raise ValueError(message)
+
+
+def check_operation(root: Path, tmp: Path, operation: str) -> None:
+    temp_base = Path(tempfile.gettempdir()).resolve()
+    if not tmp.resolve().is_relative_to(temp_base) or tmp.resolve() == temp_base:
+        raise ValueError("sandbox directory is outside the system temporary directory")
+    if not root.resolve().is_relative_to(tmp.resolve()) or root.resolve() == tmp.resolve():
+        raise ValueError("project root is outside its sandbox directory")
+    if ".." in operation or "~" in operation:
+        raise ValueError("unsafe operation: '..' or '~' is forbidden")
+    # Best effort: recognize literal absolute shell words, including quoted words.
+    for match in re.finditer(r"(?<![\w.])/[A-Za-z0-9_./-]+", operation):
+        candidate = Path(match.group())
+        if not candidate.resolve().is_relative_to(root.resolve()):
+            raise ValueError(f"unsafe operation: absolute path outside sandbox: {candidate}")
+
+
+def set_fixed_mtimes(root: Path) -> None:
+    paths = list(root.rglob("*")) + [root]
+    for path in sorted(paths, key=lambda p: len(p.parts), reverse=True):
+        os.utime(path, (FIXED_EPOCH, FIXED_EPOCH), follow_symlinks=False)
+
+
+def tool_versions() -> dict[str, str]:
+    commands = {
+        "bash": ["bash", "--version"],
+        "coreutils": ["rm", "--version"],
+        "git": ["git", "--version"],
+        "sqlite": ["sqlite3", "--version"],
+        "python": ["python3", "--version"],
+        "uname": ["uname", "-sm"],
+    }
+    found = {}
+    for name, command in commands.items():
+        try:
+            result = subprocess.run(command, capture_output=True, text=True, timeout=5)
+            value = result.stdout.strip() or result.stderr.strip()
+            if result.returncode != 0 or not value:
+                value = "missing"
+            else:
+                value = value.splitlines()[0]
+                if name == "sqlite":
+                    value = value.split(" ")[0]
+            found[name] = value
+        except (FileNotFoundError, subprocess.TimeoutExpired):
+            found[name] = "missing"
+    return found
+
+
+def _run_script(root: Path, script: str) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        ["bash", "--noprofile", "--norc", "-c", script], cwd=root,
+        env=env_for(root), capture_output=True, text=True, timeout=30,
+    )
+
+
+def execute_variant(pair: Pair, variant: Variant, versions: dict[str, str]) -> tuple[dict, dict, list[str], int]:
+    tmp = Path(tempfile.mkdtemp(prefix="gfg-"))
+    root = tmp / "project"
+    try:
+        root.mkdir()
+        check_operation(root, tmp, pair.operation)
+        check_operation(root, tmp, pair.restore_script)
+        variant.build(root)
+        set_fixed_mtimes(root)
+        artifacts = variant.artifacts(root)
+        before = {r.id: r.fingerprint(root) for r in pair.inventory}
+        for resource_id, fingerprint in before.items():
+            if fingerprint is None:
+                raise ValueError(f"{pair.pair_id}{variant.variant}: {resource_id} fingerprint is None before operation")
+        op = _run_script(root, pair.operation)
+        after = {r.id: r.fingerprint(root) for r in pair.inventory}
+        lost = sorted(rid for rid in before if after[rid] != before[rid])
+        restore = _run_script(root, pair.restore_script)
+        restored = {r.id: r.fingerprint(root) for r in pair.inventory}
+        recoverable = sorted(rid for rid in lost if restored[rid] == before[rid])
+        item_id = f"{pair.pair_id}{variant.variant}"
+        gold = {
+            "item_id": item_id, "pair_id": pair.pair_id, "variant": variant.variant,
+            "family": pair.family, "hops": variant.hops, "changed_fact": pair.changed_fact,
+            "literal_targets": pair.literal_targets,
+            "inventory_labels": {r.id: r.label for r in pair.inventory},
+            "lost": lost, "recoverable": recoverable,
+            "permanent_loss": bool(set(lost) - set(recoverable)),
+            "op_exit_code": op.returncode, "op_stderr": op.stderr.replace(str(root), "<root>").replace(str(tmp), "<sandbox>"),
+            "restore_exit_code": restore.returncode,
+            "restore_stderr": restore.stderr.replace(str(root), "<root>").replace(str(tmp), "<sandbox>"),
+            "tool_versions": versions,
+        }
+        prompt = render_prompt(pair, artifacts, versions)
+        if str(tmp) in prompt or str(root) in prompt:
+            raise ValueError(f"{item_id}: prompt contains a temporary path")
+        item = {
+            "item_id": item_id, "pair_id": pair.pair_id, "variant": variant.variant,
+            "family": pair.family, "hops": variant.hops, "inventory_ids": [r.id for r in pair.inventory],
+            "prompt": prompt,
+        }
+        total_body_len = sum(len(a.body) for a in artifacts)
+        return gold, item, [a.title for a in artifacts], total_body_len
+    finally:
+        shutil.rmtree(tmp)
+
+
+def _write_jsonl(path: Path, rows: list[dict]) -> None:
+    with path.open("w", encoding="utf-8", newline="\n") as stream:
+        for row in sorted(rows, key=lambda r: r["item_id"]):
+            stream.write(json.dumps(row, sort_keys=True, ensure_ascii=False) + "\n")
+
+
+def run_harness(out: Path, only: set[str] | None = None, families: set[str] | None = None,
+                include_demo: bool = False) -> tuple[list[dict], list[dict]]:
+    pairs = discover_pairs(include_demo=include_demo, families=families)
+    if only is not None:
+        pairs = [p for p in pairs if p.pair_id in only]
+    versions = tool_versions()
+    gold_rows, item_rows, tell_lines, mismatch_lines = [], [], [], []
+    for pair in pairs:
+        titles = None
+        lengths = []
+        for variant in pair.variants:
+            gold, item, current_titles, length = execute_variant(pair, variant, versions)
+            if titles is not None and current_titles != titles:
+                raise ValueError(f"{pair.pair_id}: variants return different artifact titles or order")
+            titles = current_titles
+            lengths.append(length)
+            gold_rows.append(gold)
+            item_rows.append(item)
+            expected = pair.expected.get(variant.variant)
+            if expected is not None and (gold["lost"] != sorted(expected["lost"]) or
+                                         gold["recoverable"] != sorted(expected["recoverable"])):
+                mismatch_lines.append(f"{gold['item_id']}: expected {json.dumps(expected, sort_keys=True)}; executed lost={gold['lost']} recoverable={gold['recoverable']}")
+        shortest = min(lengths) if lengths else 0
+        ratio = max(lengths) / shortest if shortest else (1.0 if not lengths or max(lengths) == 0 else float("inf"))
+        tell_lines.append(f"{pair.pair_id}: longest/shortest artifact body chars = {ratio:.3f}\n")
+    out.mkdir(parents=True, exist_ok=True)
+    _write_jsonl(out / "gold.jsonl", gold_rows)
+    _write_jsonl(out / "items.jsonl", item_rows)
+    (out / "tell_report.txt").write_text("".join(sorted(tell_lines)), encoding="utf-8")
+    (out / "expected_mismatches.txt").write_text("\n".join(sorted(mismatch_lines)) + ("\n" if mismatch_lines else ""), encoding="utf-8")
+    if mismatch_lines:
+        print(f"{len(mismatch_lines)} expected label mismatch(es); see {out / 'expected_mismatches.txt'}", file=sys.stderr)
+    return gold_rows, item_rows
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--only", help="comma-separated pair IDs")
+    parser.add_argument("--families", help="comma-separated fixture families")
+    parser.add_argument("--out", type=Path, default=Path("data"))
+    parser.add_argument("--include-demo", action="store_true")
+    args = parser.parse_args()
+    run_harness(args.out, set(args.only.split(",")) if args.only else None,
+                set(args.families.split(",")) if args.families else None, args.include_demo)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/harness/run_in_docker.sh b/harness/run_in_docker.sh
new file mode 100644
index 0000000000000000000000000000000000000000..2d4f5400524cb4fdb4406c4c8c39fabe31009a12
--- /dev/null
+++ b/harness/run_in_docker.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ ! -f BENCHMARK_BRIEF.md || ! -f fixtures/base.py || ! -f harness/Dockerfile ]]; then
+  echo "Run this script from the project root." >&2
+  exit 1
+fi
+
+docker build -t gone-for-good-harness -f harness/Dockerfile .
+docker run --rm --network none -v "$PWD":/work -w /work gone-for-good-harness python -m harness.run "$@"
diff --git a/tests/test_harness.py b/tests/test_harness.py
new file mode 100644
index 0000000000000000000000000000000000000000..1aa7ed0278bebc1a4e2355ef6fecb01a81725922
--- /dev/null
+++ b/tests/test_harness.py
@@ -0,0 +1,49 @@
+from dataclasses import replace
+from pathlib import Path
+
+import pytest
+
+from fixtures.base import Artifact, Resource, Variant, file_fp
+from fixtures.demo.demo1 import PAIR
+from harness.run import check_operation, execute_variant, run_harness
+
+
+def test_demo_labels_and_determinism(tmp_path: Path) -> None:
+    out = tmp_path / "data"
+    rows, items = run_harness(out, only={"DEMO-1"}, include_demo=True)
+    by_variant = {row["variant"]: row for row in rows}
+    assert by_variant["A"]["lost"] == ["R1"]
+    assert by_variant["A"]["recoverable"] == ["R1"]
+    assert by_variant["B"]["lost"] == ["R1", "R3"]
+    assert by_variant["B"]["recoverable"] == []
+    first = ((out / "gold.jsonl").read_bytes(), (out / "items.jsonl").read_bytes())
+    run_harness(out, only={"DEMO-1"}, include_demo=True)
+    assert first == ((out / "gold.jsonl").read_bytes(), (out / "items.jsonl").read_bytes())
+    for item in items:
+        assert "DEMO-1A" not in item["prompt"]
+        assert PAIR.changed_fact not in item["prompt"]
+        assert str(tmp_path) not in item["prompt"]
+
+
+def test_safety_rejects_parent_path(tmp_path: Path) -> None:
+    root = tmp_path / "project"
+    root.mkdir()
+    with pytest.raises(ValueError, match="unsafe operation"):
+        check_operation(root, tmp_path, "rm ../outside")
+
+
+def test_artifact_title_mismatch(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    import harness.run as runner
+
+    other = replace(PAIR.variants[1], artifacts=lambda root: [Artifact("different title", "body")])
+    pair = replace(PAIR, variants=[PAIR.variants[0], other])
+    monkeypatch.setattr(runner, "discover_pairs", lambda **kwargs: [pair])
+    with pytest.raises(ValueError, match="different artifact titles"):
+        run_harness(tmp_path / "out", include_demo=True)
+
+
+def test_missing_before_fingerprint() -> None:
+    missing = Resource("R4", "contents of absent.txt", file_fp("absent.txt"))
+    pair = replace(PAIR, inventory=PAIR.inventory + [missing])
+    with pytest.raises(ValueError, match="DEMO-1A: R4 fingerprint is None before operation"):
+        execute_variant(pair, PAIR.variants[0], {"bash": "bash", "coreutils": "rm", "git": "git", "sqlite": "sqlite"})

