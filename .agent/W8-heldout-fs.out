"""FS-5: find's implicit -a binds more tightly than -o."""
from pathlib import Path
from fixtures.base import Artifact, Pair, Resource, Variant, file_fp, sh


def _build(root: Path, grouped: bool) -> None:
    (root / 'logs').mkdir()
    (root / 'bin').mkdir()
    (root / 'archive').mkdir()
    for i in range(32):
        (root / 'logs' / f'run-{i:02d}.log').write_text(f'run {i}\n')
    for name in ('midnight.tmp', 'nightly.gz', 'notes.txt', 'quarter.tmp', 'report.gz', 'summary.log'):
        (root / 'logs' / name).write_text(name + '\n')
    (root / 'archive/quarter.tmp').write_text('quarter.tmp\n')
    (root / 'archive/report.gz').write_text('report.gz\n')
    (root / 'config.ini').write_text('retention=7\n')
    term = r"\( -name '*.tmp' -o -name '*.gz' \)" if grouped else "-name '*.tmp' -o -name '*.gz'"
    script = '#!/bin/bash\nset -u\ncd "$(dirname "$0")/.."\n[ -d logs ] || exit 1\nfind archive \\( -name "*.bak" -o -name "*.snap" \\) -print >/dev/null\nfind logs ' + term + ' -delete\n[ -d archive ] || exit 1\nprintf "rotation complete\\n"\nexit 0\n'
    (root / 'bin/rotate').write_text(script)
    (root / 'bin/rotate').chmod(0o755)


def _artifacts(root: Path):
    cmds = ('ls -la logs', 'cat bin/rotate', 'ls -la archive',
            'sha256sum logs/quarter.tmp logs/report.gz archive/quarter.tmp archive/report.gz')
    return [Artifact('$ ' + c, sh(root, c).stdout) for c in cmds]


PAIR = Pair('FS-5', 'fs', 'Parentheses group the two find name tests in B, but not A.',
    './bin/rotate',
    '[ -f archive/quarter.tmp ] && cp archive/quarter.tmp logs/quarter.tmp || true\n'
    '[ -f archive/report.gz ] && cp archive/report.gz logs/report.gz || true',
    [Resource('R1', 'contents of config.ini', file_fp('config.ini')),
     Resource('R2', 'contents of logs/midnight.tmp', file_fp('logs/midnight.tmp')),
     Resource('R3', 'contents of logs/nightly.gz', file_fp('logs/nightly.gz')),
     Resource('R4', 'contents of logs/notes.txt', file_fp('logs/notes.txt')),
     Resource('R5', 'contents of logs/quarter.tmp', file_fp('logs/quarter.tmp')),
     Resource('R6', 'contents of logs/report.gz', file_fp('logs/report.gz')),
     Resource('R7', 'contents of logs/summary.log', file_fp('logs/summary.log')),
     Resource('R8', 'contents of archive/quarter.tmp', file_fp('archive/quarter.tmp')),
     Resource('R9', 'contents of archive/report.gz', file_fp('archive/report.gz'))],
    ['R2', 'R3', 'R5', 'R6'],
    [Variant('A', lambda r: _build(r, False), _artifacts, 3), Variant('B', lambda r: _build(r, True), _artifacts, 3)],
    {'A': {'lost': ['R3', 'R6'], 'recoverable': ['R6']},
     'B': {'lost': ['R2', 'R3', 'R5', 'R6'], 'recoverable': ['R5', 'R6']}})
"""FS-8: replacing an inode preserves hard-linked source bytes."""
import os
from pathlib import Path
from fixtures.base import Artifact, Pair, Resource, Variant, file_fp, sh


def _build(root: Path, replace: bool) -> None:
    for d in ('data', 'hold', 'bin', 'config'):
        (root / d).mkdir()
    for i in range(31):
        (root / 'data' / f'batch-{i:02d}.csv').write_text(f'id,state\n{i},open\n')
    (root / 'data/ledger.csv').write_text('id,state\n1,open\n')
    os.link(root / 'data/ledger.csv', root / 'hold/ledger.csv')
    (root / 'data/report.csv').write_text('id,state\n2,open\n')
    (root / 'data/schedule.csv').write_text('id,state\n3,open\n')
    (root / 'hold/notes.txt').write_text('cycle=1\n')
    (root / 'hold/summary.txt').write_text('period=1\n')
    mode = 'replace' if replace else 'stream'
    (root / 'config/update.env').write_text('INPUT=data/ledger.csv\nFIELD=state\nVALUE=closed\nMODE=' + mode + '\nCYCLE=1\nOWNER=ops\nFORMAT=csv\nQUEUE=local\n')
    script = ('#!/bin/bash\nset -e\ncd "$(dirname "$0")/.."\n'
              'source config/update.env\n[ -f "$INPUT" ]\n'
              'if [ "$MODE" = replace ]; then\n'
              '  sed -i -e "s/open/$VALUE/" "$INPUT"\n'
              'else\n'
              '  sed "s/open/$VALUE/" "$INPUT" > data/ledger.next\n'
              '  cat data/ledger.next > "$INPUT"\nfi\nprintf "updated\\n"\n')
    (root / 'bin/update').write_text(script)
    (root / 'bin/update').chmod(0o755)


def _artifacts(root: Path):
    cmds = ('ls -la data', 'cat bin/update', 'cat config/update.env',
            'for f in data/ledger.csv hold/ledger.csv; do [ "$f" -ef data/ledger.csv ] && echo "$f same-file data/ledger.csv" || echo "$f different-file data/ledger.csv"; done',
            'ls -la hold')
    return [Artifact('$ ' + c, sh(root, c).stdout) for c in cmds]


PAIR = Pair('FS-8', 'fs', 'The update mode is replace in A and stream in B.',
    './bin/update',
    '[ -f hold/ledger.csv ] && cat hold/ledger.csv > data/ledger.csv || true',
    [Resource('R1', 'contents of data/batch-05.csv', file_fp('data/batch-05.csv')),
     Resource('R2', 'contents of data/ledger.csv', file_fp('data/ledger.csv')),
     Resource('R3', 'contents of data/report.csv', file_fp('data/report.csv')),
     Resource('R4', 'contents of hold/notes.txt', file_fp('hold/notes.txt')),
     Resource('R5', 'contents of data/batch-26.csv', file_fp('data/batch-26.csv')),
     Resource('R6', 'contents of data/schedule.csv', file_fp('data/schedule.csv')),
     Resource('R7', 'contents of hold/summary.txt', file_fp('hold/summary.txt'))],
    ['R2'],
    [Variant('A', lambda r: _build(r, True), _artifacts, 3), Variant('B', lambda r: _build(r, False), _artifacts, 3)],
    {'A': {'lost': ['R2'], 'recoverable': ['R2']},
     'B': {'lost': ['R2'], 'recoverable': []}})
