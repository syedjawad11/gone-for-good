import difflib, math, tempfile
from pathlib import Path
from fixtures.fs import fs5,fs6,fs7,fs8,fs9,fs10
for mod in (fs5,fs6,fs7,fs8,fs9,fs10):
 p=mod.PAIR
 with tempfile.TemporaryDirectory() as d:
  out=[]
  for v in p.variants:
   r=Path(d)/v.variant;r.mkdir();v.build(r)
   out.append('\\n'.join(a.body for a in v.artifacts(r)).splitlines())
  n=math.ceil(sum(x.startswith(('+ ','- ')) for x in difflib.ndiff(*out))/2)
  print(p.pair_id,'hops',p.variants[0].hops,'diff_lines',n,'A',p.expected['A'],'B',p.expected['B'])
