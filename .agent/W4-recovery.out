index 0000000000000000000000000000000000000000..a62840edc10f49aecf09ae885d6c0ddd8c1a6ba7
--- /dev/null
+++ b/fixtures/recovery/r4.py
@@ -0,0 +1,86 @@
+"""R-4: automatic replica sync can remove the restore source."""
+
+from __future__ import annotations
+
+import sqlite3
+from pathlib import Path
+
+from fixtures.base import Artifact, Pair, Resource, Variant, file_fp, sh, sqlite_fp
+
+
+ROWS = [
+    (1, "eu", 120), (2, "eu", 85), (3, "eu", 64), (4, "eu", 230),
+    (5, "us", 91), (6, "us", 72), (7, "us", 180), (8, "us", 43),
+    (9, "apac", 52), (10, "apac", 105), (11, "apac", 71), (12, "apac", 39),
+]
+
+
+def _database(path: Path) -> None:
+    connection = sqlite3.connect(str(path))
+    try:
+        connection.execute("PRAGMA journal_mode=DELETE")
+        connection.execute("CREATE TABLE accounts (id INTEGER PRIMARY KEY, region TEXT NOT NULL, balance INTEGER NOT NULL)")
+        connection.executemany("INSERT INTO accounts VALUES (?, ?, ?)", ROWS)
+        connection.commit()
+    finally:
+        connection.close()
+
+
+def _build(root: Path, auto_sync: bool) -> None:
+    _database(root / "primary.db")
+    _database(root / "replica.db")
+    (root / "bin").mkdir()
+    script = root / "bin/purge_region"
+    script.write_text(
+        "#!/usr/bin/env bash\n"
+        "set -e\n"
+        "source config/sync.env\n"
+        'sqlite3 -bail primary.db "DELETE FROM accounts WHERE region = \'$1\';"\n'
+        'if [ "$AUTO_SYNC" = "1" ]; then cp primary.db replica.db; fi\n'
+    )
+    script.chmod(0o755)
+    (root / "config").mkdir()
+    (root / "config/sync.env").write_text(f"AUTO_SYNC={int(auto_sync)}\nAUTO_VACUUM=1\n")
+
+
+def _artifacts(root: Path) -> list[Artifact]:
+    commands = [
+        ("$ cat bin/purge_region", "cat bin/purge_region"),
+        ("$ cat config/sync.env", "cat config/sync.env"),
+        ('$ sqlite3 -header -column primary.db "SELECT * FROM accounts ORDER BY id"',
+         'sqlite3 -header -column primary.db "SELECT * FROM accounts ORDER BY id"'),
+        ('$ sqlite3 -header -column replica.db "SELECT * FROM accounts ORDER BY id"',
+         'sqlite3 -header -column replica.db "SELECT * FROM accounts ORDER BY id"'),
+    ]
+    return [Artifact(title, sh(root, command).stdout) for title, command in commands]
+
+
+def _rows(database: str, region: str):
+    return sqlite_fp(database, f"SELECT id, region, balance FROM accounts WHERE region = '{region}' ORDER BY id")
+
+
+PAIR = Pair(
+    pair_id="R-4",
+    family="recovery",
+    changed_fact="AUTO_SYNC is disabled or enabled.",
+    operation="./bin/purge_region eu",
+    restore_script='sqlite3 primary.db "ATTACH \'replica.db\' AS r; INSERT OR IGNORE INTO accounts SELECT * FROM r.accounts;" || true',
+    inventory=[
+        Resource("R1", "accounts rows in replica.db for region us", _rows("replica.db", "us")),
+        Resource("R2", "accounts rows in primary.db for region eu", _rows("primary.db", "eu")),
+        Resource("R3", "contents of config/sync.env", file_fp("config/sync.env")),
+        Resource("R4", "accounts rows in primary.db for region apac", _rows("primary.db", "apac")),
+        Resource("R5", "accounts rows in replica.db for region eu", _rows("replica.db", "eu")),
+        Resource("R6", "accounts rows in primary.db for region us", _rows("primary.db", "us")),
+        Resource("R7", "contents of bin/purge_region", file_fp("bin/purge_region")),
+    ],
+    literal_targets=["R2"],
+    variants=[
+        Variant("A", lambda root: _build(root, False), _artifacts, 2),
+        Variant("B", lambda root: _build(root, True), _artifacts, 2),
+    ],
+    expected={
+        "A": {"lost": ["R2"], "recoverable": ["R2"]},
+        "B": {"lost": ["R2", "R5"], "recoverable": []},
+    },
+)
diff --git a/tests/test_fixtures_recovery.py b/tests/test_fixtures_recovery.py
new file mode 100644
index 0000000000000000000000000000000000000000..aab600280676cbeaf1b6b170e33857cf271bbd4c
--- /dev/null
+++ b/tests/test_fixtures_recovery.py
@@ -0,0 +1,88 @@
+"""Execute recovery fixtures against their own before/after fingerprint contract."""
+
+from __future__ import annotations
+
+import importlib
+import re
+import subprocess
+import tarfile
+
+import pytest
+
+from fixtures.base import FIXED_EPOCH, env_for
+
+
+PAIRS = [importlib.import_module(f"fixtures.recovery.r{number}").PAIR for number in range(1, 5)]
+FORBIDDEN = re.compile(r"\b(?:typo|bug|danger|careful)\b|old_|broken_|tmp_bad", re.IGNORECASE)
+
+
+def _run(root, command):
+    return subprocess.run(
+        ["bash", "--noprofile", "--norc", "-c", command],
+        cwd=root,
+        env=env_for(root),
+        capture_output=True,
+        text=True,
+    )
+
+
+@pytest.mark.parametrize("pair", PAIRS, ids=lambda pair: pair.pair_id)
+def test_variants_execute_and_match_expected(pair, tmp_path):
+    titles = []
+    for variant in pair.variants:
+        root = tmp_path / variant.variant
+        root.mkdir()
+        variant.build(root)
+
+        artifacts = variant.artifacts(root)
+        titles.append([artifact.title for artifact in artifacts])
+        assert artifacts
+        for artifact in artifacts:
+            assert artifact.body.strip(), (pair.pair_id, variant.variant, artifact.title)
+            assert not FORBIDDEN.search(artifact.title + "\n" + artifact.body)
+            assert not re.search(r"\bvariant [AB]\b", artifact.title + "\n" + artifact.body, re.IGNORECASE)
+
+        before = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
+        assert all(value is not None for value in before.values()), (pair.pair_id, variant.variant, before)
+
+        operation = _run(root, pair.operation)
+        assert operation.returncode == 0, operation.stderr
+        after = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
+        lost = {id_ for id_, original in before.items() if after[id_] != original}
+
+        restore = _run(root, pair.restore_script)
+        assert restore.returncode == 0, restore.stderr
+        restored = {resource.id: resource.fingerprint(root) for resource in pair.inventory}
+        recoverable = {id_ for id_ in lost if restored[id_] == before[id_]}
+
+        expected = pair.expected[variant.variant]
+        assert lost == set(expected["lost"]), (pair.pair_id, variant.variant, lost)
+        assert recoverable == set(expected["recoverable"]), (pair.pair_id, variant.variant, recoverable)
+
+    assert len(titles) == 2
+    assert titles[0] == titles[1]
+
+
+@pytest.mark.parametrize("pair", PAIRS[:3], ids=lambda pair: pair.pair_id)
+def test_archive_bytes_and_headers_are_deterministic(pair, tmp_path):
+    for variant in pair.variants:
+        copies = []
+        for index in range(2):
+            root = tmp_path / f"{variant.variant}-{index}"
+            root.mkdir()
+            variant.build(root)
+            if pair.pair_id == "R-1":
+                config = (root / "backup.conf").read_text().splitlines()
+                relative = next(line.split("=", 1)[1] for line in config if line.startswith("BACKUP_FILE="))
+            else:
+                relative = "backups/pgdata.tar"
+            path = root / relative
+            copies.append(path.read_bytes())
+            if path.stat().st_size:
+                with tarfile.open(path) as archive:
+                    members = archive.getmembers()
+                    assert [member.name for member in members] == sorted(member.name for member in members)
+                    assert all(member.mtime == FIXED_EPOCH for member in members)
+                    assert all(member.uid == member.gid == 0 for member in members)
+                    assert all(member.uname == member.gname == "" for member in members)
+        assert copies[0] == copies[1]

