        con.executescript(f"""
CREATE TABLE items (
    id INTEGER PRIMARY KEY,
    sku TEXT NOT NULL,
    category TEXT NOT NULL,
    qty INTEGER NOT NULL,
    location TEXT NOT NULL
);
